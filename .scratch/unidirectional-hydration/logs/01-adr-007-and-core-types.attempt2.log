eep-names --tsconfig=tsconfig.build.json --platform=node --outdir=./dist --sourcemap && esbuild src/build.ts src/esbuild.ts src/vite.ts --bundle --packages=external --format=cjs --keep-names --tsconfig=tsconfig.build.json --platform=node --outdir=./dist --out-extension:.js=.cjs --sourcemap\",\n    \"build:cli\": \"esbuild src/cli.ts --bundle --packages=external --format=cjs --keep-names --tsconfig=tsconfig.build.json --platform=node --outdir=./dist --out-extension:.js=.cjs --sourcemap --banner:js='#!/usr/bin/env node'\",\n    \"build-example\": \"npm run build-html && mkdir -p ./public && rm -rf ./public/* && NODE_ENV=development vite --mode staging --base=\\\"/microtags\\\" build\",\n    \"build-docs\": \"typedoc --tsconfig tsconfig.build.json --out api-docs ./src/index.ts\",\n    \"build\": \"mkdir -p ./dist && rm -rf ./dist/* && npm run build-cjs && npm run build-esm && npm run build-esm:min && npm run build:node && npm run build:cli\",\n    \"build-html\": \"npm run --silent ssr > example/index.html\",\n    \"size\": \"size-limit\",\n    \"inject-size\": \"esbuild ./scripts/inject-size.ts --bundle --platform=node --format=cjs | node\",\n    \"start\": \"npm run build-html && vite --open /example/\",\n    \"start:hydration\": \"npm run build:node && vite --config example-hydration/vite.config.ts --open /example-hydration/\",\n    \"ssr\": \"esbuild ./example/ssr.ts --bundle --platform=node --format=cjs | node \",\n    \"typecheck:hydration\": \"tsc -p example-hydration/server/tsconfig.json --listFiles false\",\n    \"ssr:hydration\": \"esbuild ./example-hydration/server/ssr.ts --bundle --platform=node --format=cjs --loader:.css=empty --define:import.meta.env='{\\\"DEV\\\":false,\\\"PROD\\\":true,\\\"SSR\\\":true,\\\"MODE\\\":\\\"production\\\"}' | node -\",\n    \"toc\": \"markdown-toc --maxdepth 5 -i README.md\",\n    \"toc:hydration\": \"markdown-toc --maxdepth 3 -i example-hydration/README.md\",\n    \"preversion\": \"npm run lint\",\n    \"version\": \"npm run toc && npm run toc:hydration && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && npm run inject-size && git add CHANGELOG.md README.md\",\n    \"postversion\": \"git push --follow-tags && npm publish\",\n    \"prepublishOnly\": \"npm run build\",\n    \"test:hydration\": \"npm run build:hydration && npx esbuild ./test/hydration.ts --bundle --format=esm --platform=node --packages=external | node --input-type=module && npx esbuild ./test/hydration-listen.ts --bundle --format=esm --platform=node --packages=external | node --input-type=module\",\n    \"test:hydration-dev\": \"npm run build:node && npx esbuild ./test/hydration-dev.ts --bundle --format=cjs --platform=node --packages=external | node\",\n    \"build:hydration\": \"npm run build:node && vite build --config example-hydration/vite.config.ts && vite build --ssr --config example-hydration/vite.config.ts\",\n    \"serve:hydration\": \"node example-hydration/build/server/listen.js\",\n    \"test:e2e\": \"playwright test\"\n  },\n  \"peerDependencies\": {\n    \"typescript\": \">=5.0.0\"\n  },\n  \"peerDependenciesMeta\": {\n    \"typescript\": {\n      \"optional\": true\n    }\n  },\n  \"dependencies\": {\n    \"@standard-schema/spec\": \"^1.1.0\",\n    \"alien-signals\": \"^3.2.1\",\n    \"htm\": \"^3.1.1\"\n  },\n  \"devDependencies\": {\n    \"@hono/node-server\": \"^2.1.1\",\n    \"@hono/vite-dev-server\": \"^0.26.1\",\n    \"@playwright/test\": \"^1.63.0\",\n    \"@size-limit/preset-small-lib\": \"^12.1.0\",\n    \"@stylistic/eslint-plugin\": \"^5.10.0\",\n    \"@substrate-system/debug\": \"^0.9.64\",\n    \"@substrate-system/dom\": \"^0.1.13\",\n    \"@substrate-system/tapout\": \"^0.0.38\",\n    \"@substrate-system/tapzero\": \"^0.10.16\",\n    \"@types/node\": \"^26.0.1\",\n    \"auto-changelog\": \"^2.4.0\",\n    \"browserslist\": \"^4.28.4\",\n    \"esbuild\": \"^0.28.0\",\n    \"eslint\": \"^10.6.0\",\n    \"hono\": \"^4.13.9\",\n    \"lightningcss\": \"^1.32.0\",\n    \"markdown-toc\": \"^1.2.0\",\n    \"nanotags\": \"^0.15.2\",\n    \"newneostandard\": \"^0.14.1\",\n    \"nightralph\": \"^0.0.50\",\n    \"size-limit\": \"^12.1.0\",\n    \"tap-spec\": \"^5.0.0\",\n    \"typedoc\": \"^0.28.1\",\n    \"typescript\": \"^6.0.3\",\n    \"vite\": \"^8.0.5\",\n    \"zod\": \"^4.4.3\"\nimport { define } from '../src/index.js'\nimport { refsDSL } from '../src/builders.js'\nimport type {\n    RefsMap,\n    SingleRefDef,\n    MultipleRefDef,\n    TypedEvent,\n} from '../src/types.js'\n\n/**\n * Compile-time assertions for the typed-refs feature. This file is never\n * executed or bundled into the runtime suite; it is type-checked by\n * `npm run typecheck` and exists purely to gate the ref type behaviour.\n */\n\n// Type-level equality helpers (the standard Equal / Expect pattern).\ntype Equal<X, Y> =\n    (<T>() => T extends X ? 1 : 2) extends\n    (<T>() => T extends Y ? 1 : 2) ? true : false\ntype Expect<T extends true> = T\n\n// RefsMap maps a single marker to its element type.\ntype _mapDisplay = Expect<Equal<\n    RefsMap<{ display:SingleRefDef<HTMLDivElement> }>['display'],\n    HTMLDivElement\n>>\n\n// An un-annotated single marker defaults to HTMLElement.\ntype _mapDefault = Expect<Equal<\n    RefsMap<{ host:SingleRefDef }>['host'],\n    HTMLElement\n>>\n\n// A multi marker maps to an array of its element type.\ntype _mapMulti = Expect<Equal<\n    RefsMap<{ items:MultipleRefDef<HTMLLIElement> }>['items'],\n    HTMLLIElement[]\n>>\n\n// An un-annotated multi marker defaults to HTMLElement[].\ntype _mapMultiDefault = Expect<Equal<\n    RefsMap<{ items:MultipleRefDef }>['items'],\n    HTMLElement[]\n>>\n\n// The DSL infers element types from its arguments.\nconst _oneBare = refsDSL.one()\nconst _oneTag = refsDSL.one('button')\nconst _oneGeneric = refsDSL.one<HTMLInputElement>()\nconst _allTag = refsDSL.all('li')\n\ntype _dslBare = Expect<Equal<typeof _oneBare, SingleRefDef<HTMLElement>>>\ntype _dslTag = Expect<Equal<\n    typeof _oneTag,\n    SingleRefDef<HTMLButtonElement>\n>>\ntype _dslGeneric = Expect<Equal<\n    typeof _oneGeneric,\n    SingleRefDef<HTMLInputElement>\n>>\n1:import { define } from '../src/index.js'\n2:import { refsDSL } from '../src/builders.js'\n8:} from '../src/types.js'\n16:// Type-level equality helpers (the standard Equal / Expect pattern).\n17:type Equal<X, Y> =\n20:type Expect<T extends true> = T\n23:type _mapDisplay = Expect<Equal<\n29:type _mapDefault = Expect<Equal<\n35:type _mapMulti = Expect<Equal<\n41:type _mapMultiDefault = Expect<Equal<\n52:type _dslBare = Expect<Equal<typeof _oneBare, SingleRefDef<HTMLElement>>>\n53:type _dslTag = Expect<Equal<\n57:type _dslGeneric = Expect<Equal<\n61:type _dslAll = Expect<Equal<typeof _allTag, MultipleRefDef<HTMLLIElement>>>\n64:type _dslAllBare = Expect<Equal<\n99:type _refDecLiteral = Expect<Equal<typeof _refsProbe.refs.dec, 'dec'>>\n100:type _refKeys = Expect<Equal<\n121:type _renderProps = Expect<Equal<\n128:type _refsEmpty = Expect<Equal<keyof typeof _noRefsProbe.refs, never>>\n131:type _evtDetail = Expect<Equal<\n135:type _evtDetailDefault = Expect<Equal<\n# ADR-006: Authored HTML scaffold served by Hono\n\n**Date:** 2026-09-25 (amended 2026-09-26)\n\n**Status:** Accepted\n\n## Context\n\nThe hydration example used to author its whole document inside a\ntemplate literal and generate an ignored `index.html`. None of the\nordinary HTML tooling applied, and the example did not show a server\nchoosing a route and returning a complete document, which is the\nsituation microtags is meant for.\n\nSee the [research report](../hono-vite-ssr-research.md) for source links,\nalternatives, and repository findings. The report records the original\nproposal (Hono JSX with two outlets); this ADR supersedes those details.\n\n## Decision\n\n`example-hydration/index.html` is the checked-in scaffold. It owns the\ndoctype, head, a static title, the nav, a `<main>` element, and the\nclient entry script. `<main>` holds exactly one `<!--microtags:main-->`\nmarker. The server replaces it once, through a callback so `$&` in\nrendered text stays literal. Zero or several markers is an error.\n\nA Hono app, mounted under `/example-hydration`, owns the routes: the\nindex (canonical with a trailing slash; the bare prefix redirects),\n`/list`, and `/notice`. Other paths go through Hono's not-found handler,\nwhich returns the scaffold with a not-found body and a 404 status.\n\nRoute bodies are composed with the `html` templater from\n`microtags/htm`, expanding components through their render links. Hono\nJSX is not used.\n\nThe example is split by where code runs: `client/` (browser only),\n`components/` (both sides), and `server/` (Node only). The app module\nhas no Node imports and takes an injectable scaffold loader. In\ndevelopment `@hono/vite-dev-server` runs the app inside Vite, with the\nscaffold passed through Vite's HTML transform. In production a Node\nlistener loads the built scaffold once, mounts the app, and then serves\nbuilt assets with static middleware, so the scaffold is never served\nunassembled.\n\nThe microtags Vite plugin skips modules whose environment consumer is\n`server`, so server builds keep render links.\n\n## Trade-offs\n\nAn HTML source keeps normal document editing and Vite asset handling,\nat the cost of a small outlet contract. A JSX layout would allow\nper-route titles and more outlets, but would make TSX the document\nsource and add a server-side JSX runtime. One outlet and a static title\nare enough for the example.\n\nHono adds a server runtime and development integration. It adds no\nbrowser runtime because it stays out of the client import graph.\n\n## Consequences\n\nSource HTML is distinct from the built template. Client and server are\nbuilt separately into `example-hydration/build/`. Tests cover\nserver/client stripping, complete responses through `app.request()`,\nand the browser against the production listener (Playwright).\n\nThis decision preserves ADR-004's browser-size priority and ADR-005's\ncomponent render methods. It supersedes neither.\n# ADR-004: Client bundle size outranks API ergonomics\n\n**Date:** 2026-07-25\n\n## Context\n\nThe reason microtags exists is to produce smaller client-side JavaScript\nthan the alternatives. This goal was stated explicitly on 2026-07-25 while\ndesigning server rendering, when an always-on client-side render fallback\nwas on the table. It is not derivable from the code: the README mentions\nsize but not that size is the tie-breaker for every design choice.\n\n## Decision\n\nWhen a design choice trades client bundle size against ergonomics or API\nelegance, size wins. Concretely:\n\n- The core entry (`microtags`) is budgeted by size-limit, currently at\n  3.5 kB minified and brotlied, and the measured number is shown in the\n  README.\n- Anything not needed by every component lives in a subpath export\n  (`microtags/render`, `microtags/context`, `microtags/util`, and the\n  planned `microtags/html`). The core entry re-exports nothing from them,\n  so consumers pay only for what they import.\n- Consumers may run with no bundler at all, resolving the package through\n  an import map. A build-time transform is therefore always an optional\n  optimisation and never required for correctness.\n\n## Consequences\n\nAny addition to the core entry is measured before it is accepted. The API\nis somewhat fragmented: a component author imports from `microtags`, from\none or more subpaths, and from alien-signals directly.\n\nThe always-on client render fallback was rejected on this basis, which\nled directly to the build-time stripping design in ADR-005.","is_error":false}]},"parent_tool_use_id":null,"session_id":"99908130-e653-4773-b7a4-9aed1299a569","uuid":"2b3dd0fc-0dd4-4b7a-9549-590bded3db74","timestamp":"2026-10-04T23:49:35.983Z","tool_use_result":{"stdout":"  },\n  \"files\": [\n    \"./dist/*\"\n  ],\n  \"scripts\": {\n    \"lint\": \"eslint \\\"./**/*.{ts,js}\\\"\",\n    \"typecheck\": \"