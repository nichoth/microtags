\n    const inner = _flatten(children)\n\n    if (_isMicrotag(type)) {\n        const declared = new Set(\n            type.props as readonly string[]\n        )\n        const compProps:Record<string, unknown> = {}\n        const attrs:Record<string, string> = {}\n\n        if (props) {\n            for (const [k, v] of Object.entries(props)) {\n                if (declared.has(k)) {\n                    compProps[k] = v instanceof _Escaped ? v._raw : v\n                } else {\n                    attrs[k] = String(v)\n                }\n            }\n        }\n\n        const result = type.render(\n            compProps as any,\n            {\n                children: inner,\n                attrs: Object.keys(attrs).length > 0 ?\n                    attrs :\n                    undefined,\n            }\n        )\n        return new Markup(String(result))\n    }\n\n    if (typeof type === 'string') {\n        let a = ''\n        if (props) {\n            for (const [k, v] of Object.entries(props)) {\n                if (v === true) {\n                    a += ` ${k}`\n                } else if (\n                    v !== false &&\n                    v != null\n                ) {\n                    a += ` ${k}=\"${_escHtml(String(v))}\"`\n                }\n            }\n        }\n\n        if (VOID.has(type)) {\n            return new Markup(`<${type}${a}>`)\n        }\n        return new Markup(\n            `<${type}${a}>${inner}</${type}>`\n        )\n    }\n\n    return new Markup(inner)\n}\n\nconst _htm = htm.bind(h)\n\nexport function html (\n    strings:TemplateStringsArray,\n    ...values:unknown[]\n):Markup {\n    const escaped = values.map(v => {\n        if (typeof v === 'string') {\n            return new _Escaped(v)\n        }\n        return v\n    })\n    const result = (_htm as (...a:unknown[]) => unknown)(\n        strings, ...escaped\n    )\n    if (result instanceof Markup) return result\n    if (Array.isArray(result)) return new Markup(_flatten(result))\n    return new Markup(String(result ?? ''))\n}\n     451 test/ssr.ts\n    1682 test/index.ts\n     147 test/hydration.ts\n    2280 total\n63:        .render(({ refs, children }) => {\n64:            return `<span data-ref=\"${refs.display}\">${children}</span>`\n103:test('render: fn receives props, refs, TAG, children, attrs', t => {\n114:                children: ctx.children,\n124:            children: '<em>child</em>',\n142:        captured.children, '<em>child</em>',\n143:        'children passed through'\n162:    const html = El.render({\n170:    const nMatch = html.match(/\\bn=\"([^\"]*)\"/)\n171:    const sMatch = html.match(/\\bs=\"([^\"]*)\"/)\n172:    const bMatch = html.match(/\\bb(?:=\"[^\"]*\"|\\s|>)/)\n173:    const jMatch = html.match(/\\bj=\"([^\"]*)\"/)\n219:    const html = El.render({\n229:        /\\bon(?:\\s|>)/.test(html),\n234:        !html.includes('off'),\n239:        !html.includes('missing'),\n244:        !html.includes('internal'),\n249:        !html.includes('count'),\n273:    const html = El.render({ val: 123 })\n275:        html.includes('val=\"123\"'),\n287:    const html = El.render({ label: special })\n290:    const attrMatch = html.match(/label=\"([^\"]*)\"/)\n321:    const html = El.render({ n: 5 })\n323:        html.includes('<b>hi</b>'),\n327:        html.includes('n=\"5\"'),\n332:// html templater SSR tests (no DOM)\n333:import { html, h, raw, Markup } from '../src/htm.js'\n335:test('html SSR: html, h, raw return markup with no DOM', t => {\n336:    const result = html`<div class=\"box\">hello</div>`\n337:    t.ok(result instanceof Markup, 'html returns markup')\n357:test('html SSR: element class renders in Node', t => {\n358:    const El = define('ssr-html-comp')\n363:    const result = String(html`<${El} n=${7} />`)\n365:        result.includes('ssr-html-comp'),\n370:test('html SSR: escaping works without DOM', t => {\n372:    const result = String(html`<div>${danger}</div>`)\n379:test('html SSR: nest