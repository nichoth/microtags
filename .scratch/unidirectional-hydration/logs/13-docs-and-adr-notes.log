 host's HTML attribute is no longer\nupdated, so neither tests nor docs may read the attribute as the\ncurrent value.\n\"\"\")\nopen(p,'w').write(s)\nEOF\ngrep -n 'ADR-007\\|ADR-008' docs/adr/INDEX.md"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1117,"cache_read_input_tokens":61442,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1117},"output_tokens":33,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d134e0b9-0655-44e9-9843-19fd47b4c489","uuid":"c0ff9722-393f-4dbd-b3e9-cf0f01889148","timestamp":"2026-10-05T00:09:28.664Z","request_id":"req_011Cfi7qESheoU9jyxrEVcLg","wire_tool_inputs":{"toolu_014jpE2UKPi7GXDDKkih94un":{"command":"cd /Users/nick/code/microtags.unidirectional-hydration-13-docs-and-adr-notes; python3 - <<'EOF'\nimport re\np='README.md'; s=open(p).read()\ns=s.replace(\"\"\"instances if finds. Exports `html`, `h`, and `raw`. Works in Node and the\nbrowser -- `html` always returns a string.\"\"\",\"\"\"instances if finds. Exports `html`, `h`, `raw`, and the `Markup` type.\n`html`, `h`, and `raw` return `Markup`, not a string. Convert it with\n`String(m)` where a string is required, for example `innerHTML`. In the\nbrowser the same import resolves to a build that also exports `mount`;\nsee [ADR-007](./docs/adr/INDEX.md).\"\"\")\nopen(p,'w').write(s)\n\np='AGENTS.md'; s=open(p).read()\ns=s.replace(\"\"\"`example-hydration/index.html` is the checked-in scaffold. `<main>`\nholds exactly one `<!--microtags:main-->` marker; `server/scaffold.ts`\n`assemble` throws on zero or several markers and replaces via a\ncallback so `$&` stays literal.\"\"\",\"\"\"`example-hydration/index.html` is the checked-in scaffold. `<div\nid=\"root\">` holds the `<!--microtags:main-->` page marker; the\n`<!--microtags: