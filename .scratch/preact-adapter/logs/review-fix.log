ts (\n    rec:RenderRecord,\n    props:Record<string, unknown>,\n    options?:{ children?:string; attrs?:Record<string, string> }\n):RenderParts {\n    const extra = options?.attrs ?? {}\n    const html = String(rec.f({\n        props,\n        refs: rec.r,\n        TAG: rec.t,\n        children: options?.children ?? '',\n        attrs: extra,\n    }))\n    const attrs:Record<string, string> = Object.create(null)\n    for (const k in rec.m) {\n        const s = k in props ? _serialize(rec.m[k], props[k]) : null\n        if (s !== null) attrs[k] = s\n    }\n    for (const [k, v] of Object.entries(extra)) {\n        if (_attrName.test(k)) attrs[k] ??= v\n    }\n    return { tag: rec.t, attrs, html }\n}\n\n/** Render a component's host tag around the output of its render link. */\nexport function renderHost (\n    rec:RenderRecord,\n    props:Record<string, unknown>,\n    options?:{ children?:string; attrs?:Record<string, string> }\n):string {\n    const { tag, attrs, html } = renderParts(rec, props, options)\n    let a = ''\n    for (const k in attrs) a += _attr(k, attrs[k])\n    return `<${tag}${a}>${html}</${tag}>`\n}\n\n/**\n * Store `renderHost` and `renderParts` where the `render` and\n * `renderParts` statics look them up.\n */\nexport function register ():void {\n    const g = globalThis as any\n    g[Symbol.for('microtags.render')] = renderHost\n    g[Symbol.for('microtags.renderParts')] = renderParts\n}\n\nregister()","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Bh4cLHF4GVMYxzJqhRJgqi","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y3pFohRPZiFsBNXzD3QJhn","type":"tool_result","content":"import { signal } from './reactivity.js'\nimport { runAll } from './util.js'\nimport { makeSetupContext } from './setup-context.js'\nimport {\n    resolveContextSignal,\n    onContextAvailable,\n} from './context.js'\nimport type {\n    PropsSignals,\n    Signal,\n    SetupContext,\n    Coercer,\n    ContextToken,\n    RefDef,\n} from './types.js'\n\n/**\n * Map of prop name to coercer function.\n * The factory accepts coercers exclusively; Standard Schema support is\n * layered on top in the withProps builder (US-005).\n */\nexport type FactoryProps = Record<string, Coercer<unknown>>\n\n/**\n * The class to extend for custom elements. In the browser this is the\n * real HTMLElement; in Node (e.g. reading `.TAG` for SSR) it falls back\n * to an empty stub so the class can be defined without a DOM. The stub\n * is never instantiated or registered outside the browser.\n */\nconst HTMLElementBase = typeof HTMLElement !== 'undefined' ?\n    HTMLElement :\n    (class {} as unknown as typeof HTMLElement)\n\n/** Configuration passed to factory(). */\nexport interface FactoryConfig<Props extends FactoryProps = FactoryProps> {\n    /** Coercer for each observed attribute / prop. */\n    props:Props\n    /** Attribute names to pass to observedAttributes. */\n    observedAttrNames:string[]\n    /** Ref definitions keyed by name. */\n    refs?:Record<string, RefDef>\n    /** Context tokens keyed by name. */\n    contexts?:Record<string, ContextToken<unknown>>\n    /** Setup callback receiving the component context. */\n    setup:(ctx:SetupContext<Props, any, any>) => void\n}\n\n/**\n * Collect resolved DOM refs from within a host element.\n * Throws if any single-ref element is missing.\n */\nfunction collectRefs (\n    host:HTMLElement,\n    defs:Record<string, RefDef>\n):Record<string, Element|Element[]> {\n    const result:Record<string, Element|Element[]> = {}\n    const missing:string[] = []\n    for (const [key, def] of Object.entries(defs)) {\n        const sel = def.selector ?? `[data-ref=\"${key}\"]`\n        if (def._microtag === 'ref:all') {\n            result[key] = Array.from(host.querySelectorAll(sel))\n        } else {\n            const el = host.querySelector(sel)\n            if (!el) {\n                missing.push(key)\n            } else {\n                result[key] = el\n            }\n        }\n    }\n    if (missing.length > 0) {\n        throw new Error(\n            `${host.tagName}: missing refs: ${missing.join(', ')}`\n        )\n    }\n    return result\n}\n\n/**\n * Create an HTMLElement subclass with the microtags lifecycle.\n * The returned class has no Shadow DOM, tracks its own prop signals,\n * and runs setup() on connect / cleanups a microtask after disconnect.\n */\nexport function factory<Props extends FactoryProps = FactoryProps> (\n    config:FactoryConfig<Props>\n):typeof HTMLElement {\n    const {\n        props: propDefs,\n        observedAttrNames,\n        setup,\n        refs: refDefs = {},\n        contexts: ctxDefs = {},\n    } = config\n\n    class MicrotagElement extends HTMLElementBase {\n        static get observedAttributes () { return observedAttrNames }\n\n        _props:Record<string, Signal<unknown>> = {}\n        // Per prop: the external signal assigned to the accessor, if any.\n        _bound:Record<string, Signal<Signal<unknown>|undefined>> = {}\n        _cleanups:(() => void)[] = []\n        // Connected and set up, not yet torn down.\n        _live = false\n\n        constructor () {\n            super()\n            for (const [name, coercer] of Object.entries(propDefs)) {\n                const own = signal(coercer(null))\n                const bound = signal<Signal<unknown>|undefined>(undefined)\n                this._bound[name] = bound\n                // Reads go through the bound signal when one is set,\n                // so setup's prop signal tracks it. A bound prop is\n                // owned by the parent, so writing it here throws.\n                this._props[name] = ((...args:unknown[]) => {\n                    const ext = bound()\n                    if (!args.length) return ext ? ext() : own()\n                    if (ext) {\n                        throw new Error(`${this.localName}: prop \"${name}\"` +\n                            ' is bound and read-only; emit an event instead')\n                    }\n                    own(args[0])\n                }) as Signal<unknown>\n                // Pick up a property set before the upgrade; it\n                // shadows the prototype accessor until removed.\n                if (Object.prototype.hasOwnProperty.call(this, name)) {\n                    const pre = (this as any)[name]\n                    delete (this as any)[name]\n                    ;(this as any)[name] = pre\n                }\n            }\n        }\n\n        connectedCallback () {\n            // Back before the queued teardown ran: this was a move.\n            if (this._live) return\n            this._live = true\n            // Start a fresh cleanup scope for each connection cycle.\n            this._cleanups = []\n\n            // Hydrate prop signals from attributes; preserve any\n            // programmatically-set value when the attribute is absent.\n            for (const [name, coercer] of Object.entries(propDefs)) {\n                const attrVal = this.getAttribute(name)\n                if (attrVal !== null && !this._bound[name]()) {\n                    (this._props[name] as Signal<unknown>)(coercer(attrVal))\n                }\n            }\n\n            const cleanups = this._cleanups\n            const props = this._props as PropsSignals<Props>\n\n            // Reactive Proxy: reading a key inside a ctx.effect creates\n            // a subscription to the provider's alien-signals signal.\n            const contexts = new Proxy({} as Record<string, unknown>, {\n                get: (_target, key) => {\n                    if (typeof key !== 'string') return undefined\n                    const token = ctxDefs[key]\n                    if (!token) return undefined\n                    const sig = resolveContextSignal(this, token)\n                    return sig ? sig() : undefined\n                },\n                has: (_target, key) => {\n                    if (typeof key !== 'string') return false\n                    return key in ctxDefs\n                },\n            })\n\n            let setupRan = false\n            // Tracks pending-context cancel functions so they are\n            // removed from the global registry when setup runs or\n            // when the element disconnects.\n            const cancelCallbacks:(() => void)[] = []\n\n            const tryRunSetup = ():void => {\n                if (setupRan) return\n                for (const token of Object.values(ctxDefs)) {\n                    if (!resolveContextSignal(this, token)) return\n                }\n                setupRan = true\n                for (const cancel of cancelCallbacks) cancel()\n                cancelCallbacks.length = 0\n\n                const refs = collectRefs(this, refDefs)\n                const ctx = makeSetupContext(\n                    this, props, refs, contexts, cleanups\n                )\n                setup(ctx)\n            }\n\n            // Deferred variant: skip if element was disconnected before\n            // the context became available.\n            const tryRunSetupIfConnected = ():void => {\n                if (!this.isConnected) return\n                tryRunSetup()\n            }\n\n            // Register pending listeners for any missing contexts.\n            for (const token of Object.values(ctxDefs)) {\n                if (!resolveContextSignal(this, token)) {\n                    const cancel = onContextAvailable(\n                        token.id, tryRunSetupIfConnected\n                    )\n                    cancelCallbacks.push(cancel)\n                    // Also cancel on disconnect so we don't leak.\n                    cleanups.push(cancel)\n                }\n            }\n\n            tryRunSetup()\n        }\n\n        attributeChangedCallback (\n            name:string,\n            _old:string|null,\n            next:string|null\n        ) {\n            const coercer = propDefs[name]\n            if (\n                coercer !== undefined &&\n                this._props[name] !== undefined &&\n# ADR-010: Preact owns the host, the element owns its children\n\n**Date:** 2026-11-08\n\n**Status:** Accepted\n\n**Related:** [ADR-004][adr-004] (client size), [ADR-005][adr-005] and\n[ADR-009][adr-009] (render links and render support)\n\n## Context\n\n`../components` (`@substrate-system/components`) is moving its\ncomponents onto microtags, and they have to work inside Preact apps.\nThat covers a client-only Preact render and a Preact `hydrate` of a\nserver-rendered page. A microtags element placed in a Preact tree\nfails in both server cases.\n\nOn the server, Preact's `renderToString` emits an empty host, such as\n`<number-input min=\"1\"></number-input>`. Preact only knows the host\ntag. It does not know that the component has markup of its own, so\nthe page arrives without the component's input or buttons.\n\nIn the browser, Preact 10's `hydrate` collects every existing child of\nan element it hydrates and removes each child it has no vnode for. The\ncomponent's own markup has no vnode, so even if the server sent it,\n`hydrate` deletes it. The only exception is an element whose vnode has\n`dangerouslySetInnerHTML`. Preact leaves that element's children alone.\n\nThe terms below have their `CONTEXT.md` meanings. **Hydration** is the\nintent: attaching behaviour to markup that already exists in the\ndocument. **Adopt** is the mechanism: walking markup against existing\nDOM and binding to it without creating nodes. A microtags element\nhydrates itself when its class is registered. The adapter's job is to\nkeep Preact from undoing that hydration. It does not adopt anything\nitself.\n\n## Decision\n\nAdd a `microtags/preact` entry that exports `toPreact(El, options?)`.\nIt returns a Preact component that renders the element's host tag.\nOwnership is split at the host:\n\n- Preact owns the host tag and its attributes.\n- The element owns the host's children.\n\n**On the server**, the adapter builds the host vnode from the\ncomponent's render parts (the `renderParts` static, ADR-009's render\nsupport behind a new registry key). The attributes come from the\nparts' `attrs`, and the parts' `html` goes in through\n`dangerouslySetInnerHTML`. `renderToString` then produces the same\nmarkup as the component's own `render` static. A class whose render\nlink was stripped has no `renderParts`, so the adapter throws an error\nthat names the tag.\n\n**In the browser**, the adapter gives the host one shared, fixed\n`dangerouslySetInnerHTML` whose `__html` is the empty string. It also\npasses the declared props as vnode props, which Preact assigns as\nproperties because the host defines an accessor for each one. Mapped\nevents are passed as `on<event-name>` props. The mechanism depends on\ntwo branches of Preact's element diff:\n\n1. While hydrating, Preact neither writes `innerHTML` nor removes the\n   element's existing children. The server markup stays and the\n   element adopts it.\n2. Outside hydration, Preact writes `innerHTML` only when the new\n   `__html` differs from the old one. The value never changes, so it\n   is written at most once, on the first non-hydrating render. On a\n   client-only mount that write empties the host once, and the element\n   renders itself when it connects. Later renders never touch the\n   children.\n\nBoth branches were verified in Preact 10.29.7. The `preact` dev\ndependency is pinned, so a Preact change arrives as a deliberate bump,\nand the browser tests (hydrate keeps inner nodes, re-render keeps\nthem, typed input survives) check it.\n\nThe browser build is selected by a `browser` export condition, as\n`microtags/htm` already is, and never imports render support.\n\n## Rejected alternatives\n\n- **A bare host tag.** No adapter, just `<number-input>` in JSX. The\n  server output is an empty host, and `hydrate` deletes whatever\n  server children the host had. This is the problem itself.\n- **A global `options.vnode` hook.** One hook that recognises every\n  microtags tag and injects its inner HTML. It is implicit: a page\n  changes behaviour depending on whether some module installed the\n  hook. It is global, so it affects every Preact tree in the page,\n  and it runs on every vnode, not only microtags hosts.\n- **A per-call `__html` that changes with props.** Render the inner\n  HTML from the current props on every render. When a prop changes,\n  the new `__html` differs from the old, so Preact writes `innerHTML`\n  over live DOM. That replaces the element's nodes and destroys their\n  state: bindings, focus, and values the visitor typed.\n\n## Trade-offs\n\n- The approach depends on two internal branches of Preact's diff, not\n  a documented contract. The pin and the browser tests turn a silent\n  break into a failing bump.\n- **Props before definition.** If the element is not yet defined when\n  Preact first assigns a prop, the property does not exist on the\n  element, so Preact sets an attribute instead. The adapter does not\n  work around this. A component's declared props already read their\n  attribute at connect time, so the value still arrives. This ADR\n  records it as a known edge.\n\n## Consequences\n\n- No Preact children. The adapter does not accept them: passing them is\n  a type error, and the adapter throws in development. Slotting vnodes\n  into element-owned markup is out of scope.\n- The browser build of `microtags/preact` carries no render code. It\n  does not import render support, so with every render link stripped\n  a client bundle stays as small as ADR-004 requires.\n- `preact` is an optional peer dependency, like `typescript`. Core and\n  every entry other than `microtags/preact` never import it.\n- Render support gains a second registered function, the parts\n  function, under `Symbol.for('microtags.renderParts')`. ADR-009's\n  render record contract is unchanged, so any copy of core keeps\n  working with any copy of render support.\n\nNo ADR is superseded.\n\n[adr-004]: ./ADR-004-client-bundle-size-outranks-ergonomics.md\n[adr-005]: ./ADR-005-single-file-components-with-build-time-render-stripping.md\n[adr-009]: ./ADR-009-server-render-support-through-render-link.md\n\n```ts\n// server\nimport { h } from 'preact'\nimport { renderToString } from 'preact-render-to-string'\n\nconst body = renderToString(h(App, null))\n```\n\n```ts\n// browser\nimport { h, hydrate } from 'preact'\n\nhydrate(h(App, null), document.getElementById('root')!)\n```\n\nIn `App`, use the component like any other:\n\n```ts\nh(PreactNumberInput, {\n    min: 1,\n    class: 'qty',\n    onChange: (ev:CustomEvent) => setQty(ev.detail),\n})\n```\n\nIn the browser, the host gets a fixed, empty `dangerouslySetInnerHTML`.\nWhile hydrating, Preact leaves that element's children alone, so the\nelement adopts the server markup. Because the value never changes,\nlater renders never write `innerHTML` either.\n\n**Client-only render.** With no server markup, call Preact's `render`.\nThe first render empties the host once, and the element renders itself\nwhen it connects, so the browser bundle needs the variant of the\ncomponent that keeps its render link.\n\n```ts\nimport { h, render } from 'preact'\n\nrender(h(PreactNumberInput, { min: 1 }), document.body)\n```\n\n**Two builds.** The import resolves by export condition, the same way\nas [`microtags/htm`](#microtagshtm). The `browser` condition selects a\nbuild that contains no render code. The default build, for Node and\nSSR, imports [`microtags/render-support`](#microtagsrender-support).\n\n**Peer dependency.** `preact` is an optional peer dependency. Install\nit yourself. Only `microtags/preact` imports it.\n\n**No children.** The adapter does not accept Preact children. Passing\nthem is a type error, and the adapter throws.\n\n**Props before definition.** If the element is not defined yet when\nPreact first sets a prop, the element has no property by that name, so\nPreact sets an attribute instead. The component reads its declared\nprops from attributes when it connects, so a value that survives\nconversion to an attribute string still arrives. The adapter does not work around this.\n\n**Other host renderers.** The adapter is built on the\n[`renderParts`](#builderrenderfn-options) static, which returns the\nhost tag, its serialized attributes and its inner HTML separately. An\nadapter for another framework can build on the same parts.\n\n---\n\n### `microtags/build`\n\nNode-only. Strips [`.render()`](#builderrenderfn-options) calls from\ndefine chains so the client bundle contains only hydration code.\nRequires `typescript` as a peer dependency.\n\n```ts\nimport { transform } from 'microtags/build'\n\nconst result = transform(source, {\n    keep: ['my-notice'],   // keep these tags' render in the bundle\n    cascade: true,         // dead-import removal, default false\n    filename: 'app.ts',    // shown in warnings\n})","is_error":false}]},"parent_tool_use_id":null,"session_id":"4c0eb7c9-4c49-4c5f-bbb4-d093463c7645","uuid":"5d0d948e-2442-4ad6-ba28-2b47a6f17e6e","timestamp":"2026-11-09T06:25:51.842Z","tool_use_result":{"stdout":"import { signal } from './reactivity.js'\nimport { runAll } from './util.js'\nimport { makeSetupContext } from './setup-context.js'\nimport {\n    resolveContextSignal,\n    onContextAvailable,\n} from './context.js'\nimport type {\n    PropsSignals,\n    Signal,\n    SetupContext,\n    Coercer,\n    ContextToken,\n    RefDef,\n} from './types.js'\n\n/**\n * Map of prop name to coercer function.\n * The factory accepts coercers exclusively; Standard Schema support is\n * layered on top in the withProps builder (US-005).\n */\nexport type FactoryProps = Record<string, Coercer<unknown>>\n\n/**\n * The class to extend for custom elements. In the browser this is the\n * real HTMLElement; in Node (e.g. reading `.TAG` for SSR) it falls back\n * to an empty stub so the class can be defined without a DOM. The stub\n * is never instantiated or registered outside the browser.\n */\nconst HTMLElementBase = typeof HTMLElement !== 'undefined' ?\n    HTMLElement :\n    (class {} as unknown as typeof HTMLElement)\n\n/** Configuration passed to factory(). */\nexport interface FactoryConfig<Props extends FactoryProps = FactoryProps> {\n    /** Coercer for each observed attribute / prop. */\n    props:Props\n    /** Attribute names to pass to observedAttributes. */\n    observedAttrNames:string[]\n    /** Ref definitions keyed by name. */\n    refs?:Record<string, RefDef>\n    /** Context tokens keyed by name. */\n    contexts?:Record<string, ContextToken<unknown>>\n    /** Setup callback receiving the component context. */\n    setup:(ctx:SetupContext<Props, any, any>) => void\n}\n\n/**\n * Collect resolved DOM refs from within a host element.\n * Throws if any single-ref element is missing.\n */\nfunction collectRefs (\n    host:HTMLElement,\n    defs:Record<string, RefDef>\n):Record<string, Element|Element[]> {\n    const result:Record<string, Element|Element[]> = {}\n    const missing:string[] = []\n    for (const [key, def] of Object.entries(defs)) {\n        const sel = def.selector ?? `[data-ref=\"${key}\"]`\n        if (def._microtag === 'ref:all') {\n            result[key] = Array.from(host.querySelectorAll(sel))\n        } else {\n            const el = host.querySelector(sel)\n            if (!el) {\n                missing.push(key)\n            } else {\n                result[key] = el\n            }\n        }\n    }\n    if (missing.length > 0) {\n        throw new Error(\n            `${host.tagName}: missing refs: ${missing.join(', ')}`\n        )\n    }\n    return result\n}\n\n/**\n * Create an HTMLElement subclass with the microtags lifecycle.\n * The returned class has no Shadow DOM, tracks its own prop signals,\n * and runs setup() on connect / cleanups a microtask after disconnect.\n */\nexport function factory<Props extends FactoryProps = FactoryProps> (\n    config:FactoryConfig<Props>\n):typeof HTMLElement {\n    const {\n        props: propDefs,\n        observedAttrNames,\n        setup,\n        refs: refDefs = {},\n        contexts: ctxDefs = {},\n    } = config\n\n    class MicrotagElement extends HTMLElementBase {\n        static get observedAttributes () { return observedAttrNames }\n\n        _props:Record<string, Signal<unknown>> = {}\n        // Per prop: the external signal assigned to the accessor, if any.\n        _bound:Record<string, Signal<Signal<unknown>|undefined>> = {}\n        _cleanups:(() => void)[] = []\n        // Connected and set up, not yet torn down.\n        _live = false\n\n        constructor () {\n            super()\n            for (const [name, coercer] of Object.entries(propDefs)) {\n                const own = signal(coercer(null))\n                const bound = signal<Signal<unknown>|undefined>(undefined)\n                this._bound[name] = bound\n                // Reads go through the bound signal when one is set,\n                // so setup's prop signal tracks it. A bound prop is\n                // owned by the parent, so writing it here throws.\n                this._props[name] = ((...args:unknown[]) => {\n                    const ext = bound()\n                    if (!args.length) return ext ? ext() : own()\n                    if (ext) {\n                        throw new Error(`${this.localName}: prop \"${name}\"` +\n                            ' is bound and read-only; emit an event instead')\n                    }\n                    own(args[0])\n                }) as Signal<unknown>\n                // Pick up a property set before the upgrade; it\n                // shadows the prototype accessor until removed.\n                if (Object.prototype.hasOwnProperty.call(this, name)) {\n                    const pre = (this as any)[name]\n                    delete (this as any)[name]\n                    ;(this as any)[name] = pre\n                }\n            }\n        }\n\n        connectedCallback () {\n            // Back before the queued teardown ran: this was a move.\n            if (this._live) return\n            this._live = true\n            // Start a fresh cleanup scope for each connection cycle.\n            this._cleanups = []\n\n            // Hydrate prop signals from attributes; preserve any\n            // programmatically-set value when the attribute is absent.\n            for (const [name, coercer] of Object.entries(propDefs)) {\n                const attrVal = this.getAttribute(name)\n                if (attrVal !== null && !this._bound[name]()) {\n                    (this._props[name] as Signal<unknown>)(coercer(attrVal))\n                }\n            }\n\n            const cleanups = this._cleanups\n            const props = this._props as PropsSignals<Props>\n\n            // Reactive Proxy: reading a key inside a ctx.effect creates\n            // a subscription to the provider's alien-signals signal.\n            const contexts = new Proxy({} as Record<string, unknown>, {\n                get: (_target, key) => {\n                    if (typeof key !== 'string') return undefined\n                    const token = ctxDefs[key]\n                    if (!token) return undefined\n                    const sig = resolveContextSignal(this, token)\n                    return sig ? sig() : undefined\n                },\n                has: (_target, key) => {\n                    if (typeof key !== 'string') return false\n                    return key in ctxDefs\n                },\n            })\n\n            let setupRan = false\n            // Tracks pending-context cancel functions so they are\n            // removed from the global registry when setup runs or\n            // when the element disconnects.\n            const cancelCallbacks:(() => void)[] = []\n\n            const tryRunSetup = ():void => {\n                if (setupRan) return\n                for (const token of Object.values(ctxDefs)) {\n                    if (!resolveContextSignal(this, token)) return\n                }\n                setupRan = true\n                for (const cancel of cancelCallbacks) cancel()\n                cancelCallbacks.length = 0\n\n                const refs = collectRefs(this, refDefs)\n                const ctx = makeSetupContext(\n                    this, props, refs, contexts, cleanups\n                )\n                setup(ctx)\n            }\n\n            // Deferred variant: skip if element was disconnected before\n            // the context became available.\n            const tryRunSetupIfConnected = ():void => {\n                if (!this.isConnected) return\n                tryRunSetup()\n            }\n\n            // Register pending listeners for any missing contexts.\n            for (const token of Object.values(ctxDefs)) {\n                if (!resolveContextSignal(this, token)) {\n                    const cancel = onContextAvailable(\n                        token.id, tryRunSetupIfConnected\n                    )\n                    cancelCallbacks.push(cancel)\n                    // Also cancel on disconnect so we don't leak.\n                    cleanups.push(cancel)\n                }\n            }\n\n            tryRunSetup()\n        }\n\n        attributeChangedCallback (\n            name:string,\n            _old:string|null,\n            next:string|null\n        ) {\n            const coercer = propDefs[name]\n            if (\n                coercer !== undefined &&\n                this._props[name] !== undefined &&\n# ADR-010: Preact owns the host, the element owns its children\n\n**Date:** 2026-11-08\n\n**Status:** Accepted\n\n**Related:** [ADR-004][adr-004] (client size), [ADR-005][adr-005] and\n[ADR-009][adr-009] (render links and render support)\n\n## Context\n\n`../components` (`@substrate-system/components`) is moving its\ncomponents onto microtags, and they have to work inside Preact apps.\nThat covers a client-only Preact render and a Preact `hydrate` of a\nserver-rendered page. A microtags element placed in a Preact tree\nfails in both server cases.\n\nOn the server, Preact's `renderToString` emits an empty host, such as\n`<number-input min=\"1\"></number-input>`. Preact only knows the host\ntag. It does not know that the component has markup of its own, so\nthe page arrives without the component's input or buttons.\n\nIn the browser, Preact 10's `hydrate` collects every existing child of\nan element it hydrates and removes each child it has no vnode for. The\ncomponent's own markup has no vnode, so even if the server sent it,\n`hydrate` deletes it. The only exception is an element whose vnode has\n`dangerouslySetInnerHTML`. Preact leaves that element's children alone.\n\nThe terms below have their `CONTEXT.md` meanings. **Hydration** is the\nintent: attaching behaviour to markup that already exists in the\ndocument. **Adopt** is the mechanism: walking markup against existing\nDOM and binding to it without creating nodes. A microtags element\nhydrates itself when its class is registered. The adapter's job is to\nkeep Preact from undoing that hydration. It does not adopt anything\nitself.\n\n## Decision\n\nAdd a `microtags/preact` entry that exports `toPreact(El, options?)`.\nIt returns a Preact component that renders the element's host tag.\nOwnership is split at the host:\n\n- Preact owns the host tag and its attributes.\n- The element owns the host's children.\n\n**On the server**, the adapter builds the host vnode from the\ncomponent's render parts (the `renderParts` static, ADR-009's render\nsupport behind a new registry key). The attributes come from the\nparts' `attrs`, and the parts' `html` goes in through\n`dangerouslySetInnerHTML`. `renderToString` then produces the same\nmarkup as the component's own `render` static. A class whose render\nlink was stripped has no `renderParts`, so the adapter throws an error\nthat names the tag.\n\n**In the browser**, the adapter gives the host one shared, fixed\n`dangerouslySetInnerHTML` whose `__html` is the empty string. It also\npasses the declared props as vnode props, which Preact assigns as\nproperties because the host defines an accessor for each one. Mapped\nevents are passed as `on<event-name>` props. The mechanism depends on\ntwo branches of Preact's element diff:\n\n1. While hydrating, Preact neither writes `innerHTML` nor removes the\n   element's existing children. The server markup stays and the\n   element adopts it.\n2. Outside hydration, Preact writes `innerHTML` only when the new\n   `__html` differs from the old one. The value never changes, so it\n   is written at most once, on the first non-hydrating render. On a\n   client-only mount that write empties the host once, and the element\n   renders itself when it connects. Later renders never touch the\n   children.\n\nBoth branches were verified in Preact 10.29.7. The `preact` dev\ndependency is pinned, so a Preact change arrives as a deliberate bump,\nand the browser tests (hydrate keeps inner nodes, re-render keeps\nthem, typed input survives) check it.\n\nThe browser build is selected by a `browser` export condition, as\n`microtags/htm` already is, and never imports render support.\n\n## Rejected alternatives\n\n- **A bare host tag.** No adapter, just `<number-input>` in JSX. The\n  server output is an empty host, and `hydrate` deletes whatever\n  server children the host had. This is the problem itself.\n- **A global `options.vnode` hook.** One hook that recognises every\n  microtags tag and injects its inner HTML. It is implicit: a page\n  changes behaviour depending on whether some module installed the\n  hook. It is global, so it affects every Preact tree in the page,\n  and it runs on every vnode, not only microtags hosts.\n- **A per-call `__html` that changes with props.** Render the inner\n  HTML from the current props on every render. When a prop changes,\n  the new `__html` differs from the old, so Preact writes `innerHTML`\n  over live DOM. That replaces the element's nodes and destroys their\n  state: bindings, focus, and values the visitor typed.\n\n## Trade-offs\n\n- The approach depends on two internal branches of Preact's diff, not\n  a documented contract. The pin and the browser tests turn a silent\n  break into a failing bump.\n- **Props before definition.** If the element is not yet defined when\n  Preact first assigns a prop, the property does not exist on the\n  element, so Preact sets an attribute instead. The adapter does not\n  work around this. A component's declared props already read their\n  attribute at connect time, so the value still arrives. This ADR\n  records it as a known edge.\n\n## Consequences\n\n- No Preact children. The adapter does not accept them: passing them is\n  a type error, and the adapter throws in development. Slotting vnodes\n  into element-owned markup is out of scope.\n- The browser build of `microtags/preact` carries no render code. It\n  does not import render support, so with every render link stripped\n  a client bundle stays as small as ADR-004 requires.\n- `preact` is an optional peer dependency, like `typescript`. Core and\n  every entry other than `microtags/preact` never import it.\n- Render support gains a second registered function, the parts\n  function, under `Symbol.for('microtags.renderParts')`. ADR-009's\n  render record contract is unchanged, so any copy of core keeps\n  working with any copy of render support.\n\nNo ADR is superseded.\n\n[adr-004]: ./ADR-004-client-bundle-size-outranks-ergonomics.md\n[adr-005]: ./ADR-005-single-file-components-with-build-time-render-stripping.md\n[adr-009]: ./ADR-009-server-render-support-through-render-link.md\n\n```ts\n// server\nimport { h } from 'preact'\nimport { renderToString } from 'preact-render-to-string'\n\nconst body = renderToString(h(App, null))\n```\n\n```ts\n// browser\nimport { h, hydrate } from 'preact'\n\nhydrate(h(App, null), document.getElementById('root')!)\n```\n\nIn `App`, use the component like any other:\n\n```ts\nh(PreactNumberInput, {\n    min: 1,\n    class: 'qty',\n    onChange: (ev:CustomEvent) => setQty(ev.detail),\n})\n```\n\nIn the browser, the host gets a fixed, empty `dangerouslySetInnerHTML`.\nWhile hydrating, Preact leaves that element's children alone, so the\nelement adopts the server markup. Because the value never changes,\nlater renders never write `innerHTML` either.\n\n**Client-only render.** With no server markup, call Preact's `render`.\nThe first render empties the host once, and the element renders itself\nwhen it connects, so the browser bundle needs the variant of the\ncomponent that keeps its render link.\n\n```ts\nimport { h, render } from 'preact'\n\nrender(h(PreactNumberInput, { min: 1 }), document.body)\n```\n\n**Two builds.** The import resolves by export condition, the same way\nas [`microtags/htm`](#microtagshtm). The `browser` condition selects a\nbuild that contains no render code. The default build, for Node and\nSSR, imports [`microtags/render-support`](#microtagsrender-support).\n\n**Peer dependency.** `preact` is an optional peer dependency. Install\nit yourself. Only `microtags/preact` imports it.\n\n**No children.** The adapter does not accept Preact children. Passing\nthem is a type error, and the adapter throws.\n\n**Props before definition.** If the element is not defined yet when\nPreact first sets a prop, the element has no property by that name, so\nPreact sets an attribute instead. The component reads its declared\nprops from attributes when it connects, so a value that survives\nconversion to an attribute string still arrives. The adapter does not work around this.\n\n**Other host renderers.** The adapter is built on the\n[`renderParts`](#builderrenderfn-options) static, which returns the\nhost tag, its serialized attributes and its inner HTML separately. An\nadapter for another framework can build on the same parts.\n\n---\n\n### `microtags/build`\n\nNode-only. Strips [`.render()`](#builderrenderfn-options) calls from\ndefine chains so the client bundle contains only hydration code.\nRequires `typescript` as a peer dependency.\n\n```ts\nimport { transform } from 'microtags/build'\n\nconst result = transform(source, {\n    keep: ['my-notice'],   // keep these tags' render in the bundle\n    cascade: true,         // dead-import removal, default false\n    filename: 'app.ts',    // shown in warnings\n})","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Y3pFohRPZiFsBNXzD3QJhn","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
