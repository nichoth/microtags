{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013ABxLvvCsAJ9rFz6m52CEa","type":"tool_result","content":"import { test } from '@substrate-system/tapzero'\nimport { h } from 'preact'\nimport { renderToString } from 'preact-render-to-string'\nimport { define } from '../src/index.js'\nimport { html } from '../src/htm.js'\nimport { toPreact } from '../src/preact.js'\n\n// These tests run under Node with no DOM (see `npm run test:preact-ssr`).\n// They render the `microtags/preact` adapter with Preact's own\n// `renderToString` and compare it with the component's `render` static.\n// Preact orders and quotes attributes its own way, so the host start\n// tags are compared parsed, and the inner HTML as a string.\n\ninterface Host {\n    tag:string\n    attrs:Record<string, string>\n    inner:string\n}\n\nconst _named:Record<string, string> = {\n    amp: '&', quot: '\"', apos: \"'\", lt: '<', gt: '>',\n}\n\nfunction decode (s:string):string {\n    return s.replace(/&(#x[\\da-f]+|#\\d+|[a-z]+);/gi, (m, e:string) => {\n        if (e[0] !== '#') return _named[e.toLowerCase()] ?? m\n        return String.fromCodePoint(e[1] === 'x' || e[1] === 'X' ?\n            parseInt(e.slice(2), 16) :\n            parseInt(e.slice(1), 10))\n    })\n}\n\n/**\n * Parse one host element: its tag name, its attributes as a decoded\n * name -> value map (a bare attribute is the empty string), and the\n * raw HTML between the start tag and the matching end tag.\n */\nfunction parseHost (s:string):Host {\n    const start = /^<([a-z][-\\w]*)/i.exec(s)\n    if (!start) throw new Error('not an element: ' + s)\n    const tag = start[1].toLowerCase()\n    const attrs:Record<string, string> = {}\n    const re = new RegExp(\n        '\\\\s+([^\\\\s\"\\'>/=]+)' +\n        '(?:\\\\s*=\\\\s*(?:\"([^\"]*)\"|\\'([^\\']*)\\'|([^\\\\s\"\\'=<>`]+)))?',\n        'y'\n    )\n    let i = start[0].length\n    for (;;) {\n        re.lastIndex = i\n        const m = re.exec(s)\n        if (!m) break\n        attrs[m[1].toLowerCase()] = decode(m[2] ?? m[3] ?? m[4] ?? '')\n        i = re.lastIndex\n    }\n    const close = /^\\s*>/.exec(s.slice(i))\n    if (!close) throw new Error('unterminated start tag: ' + s)\n    i += close[0].length\n    const end = `</${tag}>`\n    if (!s.endsWith(end)) throw new Error('no end tag: ' + s)\n    return { tag, attrs, inner: s.slice(i, s.length - end.length) }\n}\n\nconst El = define('preact-ssr-el')\n    .withProps(p => ({\n        n: p.number(),\n        s: p.string(),\n        on: p.boolean(),\n        off: p.boolean(),\n        j: p.json<{ a:string }>(),\n        internal: p.prop(7),\n    }))\n    .render(({ props }) => {\n        return html`<b>${props.n}</b><i>${props.s}</i>` +\n            `<u>${props.internal}</u>`\n    })\n    .setup(() => {})\n\nconst props = {\n    n: 3,\n    s: 'a\"b<c & d',\n    on: true,\n    off: false,\n    j: { a: '<&>\"\\'' },\n    internal: 9,\n}\n\ntest('toPreact: renderToString matches the render static', t => {\n    const C = toPreact(El)\n    const got = parseHost(renderToString(h(C, props)))\n    const want = parseHost(El.render(props))\n    t.equal(got.tag, want.tag, 'same tag')\n    t.deepEqual(got.attrs, want.attrs, 'same attribute map')\n    t.equal(got.inner, want.inner, 'same inner HTML')\n    t.ok(got.inner.includes('<u>9</u>'), 'the prop-only prop is rendered')\n})\n\ntest('toPreact: a true boolean is bare, false and null are absent', t => {\n    const C = toPreact(El)\n    const out = renderToString(h(C, {\n        n: 1,\n        on: true,\n        off: false,\n        s: null as unknown as string,\n    }))\n    const { attrs } = parseHost(out)\n    t.ok(/<preact-ssr-el[^>]*\\son[\\s>]/.test(out) && !/\\son=/.test(out),\n        'the true boolean is a bare attribute')\n    t.ok(!('off' in attrs), 'the false boolean is absent')\n    t.ok(!('s' in attrs), 'the null prop is absent')\n})\n\ntest('toPreact: passthrough attrs reach the host, callbacks do not', t => {\n    const C = toPreact(El, { events: { onChange: 'preact-ssr-el:change' } })\n    const { attrs } = parseHost(renderToString(h(C, {\n        n: 2,\n        class: 'big',\n        id: 'one',\n        'aria-label': 'A \"label\"',\n        'data-x': 5,\n        onChange: () => {},\n    })))\n    t.equal(attrs.class, 'big', 'class passes through')\n    t.equal(attrs.id, 'one', 'id passes through')\n    t.equal(attrs['aria-label'], 'A \"label\"', 'aria-* passes through')\n    t.equal(attrs['data-x'], '5', 'data-* passes through')\n    t.ok(!Object.keys(attrs).some(k => /change/i.test(k)),\n        'the mapped callback prop is not in the output')\n})\n\nfunction thrown (fn:() => unknown):string {\n    try {\n        fn()\n    } catch (err) {\n        return String((err as Error).message)\n    }\n    return ''\n}\n\ntest('toPreact: a class with no render link throws naming the tag', t => {\n    const Plain = define('preact-ssr-plain')\n        .withProps(p => ({ n: p.number() }))\n        .setup(() => {})\n    const C = toPreact(Plain)\n    const msg = thrown(() => renderToString(h(C, { n: 1 })))\n    t.ok(msg.includes('preact-ssr-plain'), 'the error names the tag')\n    t.ok(/render link/.test(msg), 'the error is about the render link')\n})\n\ntest('toPreact: children throw naming the tag', t => {\n    const C = toPreact(El)\n    const msg = thrown(() => renderToString(\n        h(C as any, { n: 1 }, h('span', null, 'kid'))\n    ))\n    t.ok(msg.includes('preact-ssr-el'), 'the error names the tag')\n})\n// Reads the built `dist/` (run `npm run build` first) and proves the\n// adapter split holds: the browser adapter carries no render support\n// and no `preact-render-to-string`, and no entry but the adapter\n// imports `preact`. Markers are fixed strings, never regexes. Each one\n// is first proven present in its control file, so a marker that\n// bundling renamed or dropped fails as stale instead of passing.\nimport { test } from '@substrate-system/tapzero'\nimport * as fs from 'fs'\nimport * as path from 'path'\n\nconst DIST = path.resolve('dist')\n\n// `build-esm` uses `--splitting`, so an entry's code may live in shared\n// chunks. Follow relative import specifiers transitively.\nconst REL_IMPORT = /(?:from|import)\\s*[\"'](\\.\\.?\\/[^\"']+)[\"']/g\n\nfunction withChunks (entry:string):string[] {\n    const seen = new Set<string>()\n    const queue = [path.join(DIST, entry)]\n    while (queue.length) {\n        const file = queue.pop()!\n        if (seen.has(file)) continue\n        seen.add(file)\n        const text = fs.readFileSync(file, 'utf8')\n        for (const m of text.matchAll(REL_IMPORT)) {\n            queue.push(path.resolve(path.dirname(file), m[1]))\n        }\n    }\n    return [...seen]\n}\n\nconst rel = (f:string) => path.relative(process.cwd(), f)\n\ninterface Marker {\n    name:string;\n    marker:string;\n    // files whose union must contain the marker\n    control:string[];\n    // files that must each lack it\n    checked:string[];\n}\n\nconst BROWSER_ADAPTER = [\n    ...withChunks('preact.browser.js'),\n    ...withChunks('preact.browser.min.js'),\n]\n\nconst NON_ADAPTER_ENTRIES = [\n    'index.js',\n    'index.min.js',\n    'render.js',\n    'context.js',\n    'util.js',\n    'htm.js',\n    'htm.browser.js',\n    'render-support.js',\n    'build.js',\n    'esbuild.js',\n    'vite.js',\n]\n\nconst MARKERS:Marker[] = [\n    {\n        // an entry of the attribute escaper's table; core holds the\n        // `microtags.render*` symbol keys too, so those are not markers\n        name: 'render support escaper',\n        marker: '&#39;',\n        control: withChunks('render-support.js'),\n        checked: BROWSER_ADAPTER,\n    },\n    {\n        // the default adapter build does not import it (the caller\n        // renders), so the package's own manifest is the control that\n        // proves the specifier's spelling\n        name: 'preact-render-to-string specifier',\n        marker: '\"preact-render-to-string\"',\n        control: [\n            path.resolve('node_modules/preact-render-to-string/package.json')\n        ],\n        checked: BROWSER_ADAPTER,\n    },\n    {\n        name: 'bare preact import',\n        marker: '\"preact\"',\n        control: withChunks('preact.js'),\n        checked: [...new Set(NON_ADAPTER_ENTRIES.flatMap(withChunks))],\n    },\n]\n\ntest('the bundle scan follows chunks', t => {\n    const files = withChunks('preact.browser.js')\n    t.ok(files.length > 1, 'the browser adapter imports at least one chunk')\n})\n\nfor (const { name, marker, control, checked } of MARKERS) {\n    test(`${name} stays out of the files that must lack it`, t => {\n        const where = control.find(f => {\n            return fs.readFileSync(f, 'utf8').includes(marker)\n        })\n        t.ok(where, where ?\n            `${name} is in ${rel(where)}` :\n            `${name} marker is stale: not found in ` +\n                control.map(rel).join(', '))\n        if (!where) return\n        for (const file of checked) {\n            const text = fs.readFileSync(file, 'utf8')\n            t.ok(!text.includes(marker), `${rel(file)} lacks the ${name}`)\n        }\n    })\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"5315d5cc-ff1b-47b5-b928-3130c18aca4f","uuid":"e5c48514-4f5c-4803-acae-fb804dedde11","timestamp":"2026-11-09T06:24:46.272Z","tool_use_result":{"stdout":"import { test } from '@substrate-system/tapzero'\nimport { h } from 'preact'\nimport { renderToString } from 'preact-render-to-string'\nimport { define } from '../src/index.js'\nimport { html } from '../src/htm.js'\nimport { toPreact } from '../src/preact.js'\n\n// These tests run under Node with no DOM (see `npm run test:preact-ssr`).\n// They render the `microtags/preact` adapter with Preact's own\n// `renderToString` and compare it with the component's `render` static.\n// Preact orders and quotes attributes its own way, so the host start\n// tags are compared parsed, and the inner HTML as a string.\n\ninterface Host {\n    tag:string\n    attrs:Record<string, string>\n    inner:string\n}\n\nconst _named:Record<string, string> = {\n    amp: '&', quot: '\"', apos: \"'\", lt: '<', gt: '>',\n}\n\nfunction decode (s:string):string {\n    return s.replace(/&(#x[\\da-f]+|#\\d+|[a-z]+);/gi, (m, e:string) => {\n        if (e[0] !== '#') return _named[e.toLowerCase()] ?? m\n        return String.fromCodePoint(e[1] === 'x' || e[1] === 'X' ?\n            parseInt(e.slice(2), 16) :\n            parseInt(e.slice(1), 10))\n    })\n}\n\n/**\n * Parse one host element: its tag name, its attributes as a decoded\n * name -> value map (a bare attribute is the empty string), and the\n * raw HTML between the start tag and the matching end tag.\n */\nfunction parseHost (s:string):Host {\n    const start = /^<([a-z][-\\w]*)/i.exec(s)\n    if (!start) throw new Error('not an element: ' + s)\n    const tag = start[1].toLowerCase()\n    const attrs:Record<string, string> = {}\n    const re = new RegExp(\n        '\\\\s+([^\\\\s\"\\'>/=]+)' +\n        '(?:\\\\s*=\\\\s*(?:\"([^\"]*)\"|\\'([^\\']*)\\'|([^\\\\s\"\\'=<>`]+)))?',\n        'y'\n    )\n    let i = start[0].length\n    for (;;) {\n        re.lastIndex = i\n        const m = re.exec(s)\n        if (!m) break\n        attrs[m[1].toLowerCase()] = decode(m[2] ?? m[3] ?? m[4] ?? '')\n        i = re.lastIndex\n    }\n    const close = /^\\s*>/.exec(s.slice(i))\n    if (!close) throw new Error('unterminated start tag: ' + s)\n    i += close[0].length\n    const end = `</${tag}>`\n    if (!s.endsWith(end)) throw new Error('no end tag: ' + s)\n    return { tag, attrs, inner: s.slice(i, s.length - end.length) }\n}\n\nconst El = define('preact-ssr-el')\n    .withProps(p => ({\n        n: p.number(),\n        s: p.string(),\n        on: p.boolean(),\n        off: p.boolean(),\n        j: p.json<{ a:string }>(),\n        internal: p.prop(7),\n    }))\n    .render(({ props }) => {\n        return html`<b>${props.n}</b><i>${props.s}</i>`