kips extra attributes with invalid names', t => {\n    const El = define('ssr-bad-attr-name')\n        .withProps(p => ({ n: p.number() }))\n        .render(() => '')\n        .setup(() => {})\n\n    const out = El.render({ n: 1 }, {\n        attrs: {\n            'data-ok': 'yes',\n            'x\" onload=\"alert(1)': 'bad',\n            'a b': 'bad',\n            '1st': 'bad',\n            '': 'bad',\n            'x:y.z_w': 'ok',\n        },\n    })\n\n    t.deepEqual(\n        hostAttrNames(out),\n        ['n', 'data-ok', 'x:y.z_w'],\n        'only valid extra attribute names reach the host tag'\n    )\n    t.ok(!out.includes('onload'), 'hostile key does not break out')\n})\n\ntest('render: declared props serialize unchanged, names unvalidated', t => {\n    // `$odd` is outside the attribute grammar, but declared prop names\n    // come from the builder chain, not data, so they are not checked.\n    const El = define('ssr-declared-names')\n        .withProps(p => ({\n            n: p.number(),\n            on: p.boolean(),\n            s: p.string(),\n            j: p.json<{ a:string }>(),\n            $odd: p.string(),\n        }))\n        .render(() => '')\n        .setup(() => {})\n\n    const out = El.render(\n        { n: 3, on: true, s: 'a\"b', j: { a: '<' }, $odd: 'v' },\n        { attrs: { 'data-x': '1' } }\n    )\n\n    t.equal(\n        out,\n        '<ssr-declared-names n=\"3\" on s=\"a&quot;b\"' +\n            ' j=\"{&quot;a&quot;:&quot;&lt;&quot;}\" $odd=\"v\"' +\n            ' data-x=\"1\"></ssr-declared-names>',\n        'declared props serialize exactly as before'\n    )\n})\n\n// html templater SSR tests (no DOM)\nimport { html, h, raw, Markup } from '../src/htm.js'\nimport { parityCases, stripMarkers } from './parity.js'\n\ntest('html SSR: html, h, raw return markup with no DOM', t => {\n    const result = html`<div class=\"box\">hello</div>`\n    t.ok(result instanceof Markup, 'html returns markup')\n    t.equal(\n        String(result), '<div class=\"box\">hello</div>',\n        'markup stringifies to the same HTML as before'\n    )\n412:import { parityCases, stripMarkers } from './parity.js'\n706:            stripMarkers(String(c.input(html))),\nmechanism, not the intent)\n\n### Rendering markup\n\n**Render function**:\nThe author-supplied function given to the `render` link. It returns the\nhost's inner HTML as a string or markup; the library wraps it in the host tag.\n_Avoid_: template, view\n\n**Render context**:\nThe object handed to the render function: plain prop values, the ref name\nmap, the tag name, and caller-supplied children and attrs. Distinct from\nthe setup context and from provided context.\n_Avoid_: bare \"context\", props (it is more than props)\n\n**Host tag**:\nThe opening and closing markup of the host, with its serialized\nattributes, emitted around the render function's output.\n_Avoid_: wrapper, outer HTML\n\n**Markup**:\nThe opaque value `html`, `h`, and `raw` return (`Markup`). On the server\n`String(m)` yields the HTML; in the browser it also describes the nodes\nmount creates or adopts.\n_Avoid_: template (that is the HTML element), HTML string\n\n**Reactive region**:\nA signal or function in a child-position hole. The server evaluates it\nonce and wraps its output in `<!--[-->` and `<!--]-->` comment markers;\nthe browser re-evaluates it and morphs the nodes between the markers,\nmatching children by `key`, else by position and tag name. Children\npassed to a component are not a region: they open with their own\n`<!--[c-->` marker (closed by `<!--]-->`), so the browser can tell them\nfrom regions in the component's own render.\n_Avoid_: block, slot, island","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WjCo4r4LDzPsAeBjZq2Rqz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
