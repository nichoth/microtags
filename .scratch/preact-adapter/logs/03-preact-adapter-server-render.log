d ./test/ssr.ts --bundle --format=cjs --platform=node --loader:.css=empty --alias:microtags=./src --define:import.meta.env='{\\\"DEV\\\":false,\\\"PROD\\\":true,\\\"SSR\\\":true,\\\"MODE\\\":\\\"production\\\"}' | node -\",\n    \"test:build\": \"npx esbuild ./test/build.ts --bundle --format=cjs --platform=node | node\",\n    \"test:plugins\": \"npx esbuild ./test/plugins.ts --bundle --format=cjs --platform=node --packages=external | node\",\n    \"test:cli\": \"npx esbuild ./test/cli.ts --bundle --format=cjs --platform=node | node\",\n    \"test:importmap\": \"esbuild ./test/importmap/run.ts --bundle --platform=node --format=cjs --packages=external | node\",\n    \"build-cjs\": \"esbuild src/index.ts src/render.ts src/context.ts src/util.ts src/htm.ts src/htm.browser.ts src/render-support.ts --bundle --packages=external --format=cjs --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --out-extension:.js=.cjs --sourcemap\",\n    \"build-esm\": \"esbuild src/index.ts src/render.ts src/context.ts src/util.ts src/htm.ts src/htm.browser.ts src/render-support.ts --bundle --packages=external --splitting --format=esm --metafile=dist/meta.json --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --sourcemap && tsc --emitDeclarationOnly --project tsconfig.build.json --outDir dist\",\n    \"build-esm:min\": \"esbuild src/index.ts src/render.ts src/context.ts src/util.ts src/htm.ts src/htm.browser.ts src/render-support.ts --format=esm --keep-names --bundle --tsconfig=tsconfig.build.json --minify --out-extension:.js=.min.js --outdir=./dist --sourcemap\",\n    \"build:node\": \"esbuild src/build.ts src/esbuild.ts src/vite.ts --bundle --packages=external --format=esm --keep-names --tsconfig=tsconfig.build.json --platform=node --outdir=./dist --sourcemap && esbuild src/build.ts src/esbuild.ts src/vite.ts --bundle --packages=external --format=cjs --keep-names --tsconfig=tsconfig.build.json --platform=node --outdir=./dist --out-extension:.js=.cjs --sourcemap\",\n    \