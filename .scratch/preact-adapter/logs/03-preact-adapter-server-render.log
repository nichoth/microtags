{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgrrYsDKKqBPvVFXvieTn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XurKUpwRfGBqE8qycJg3a2","name":"Write","input":{"file_path":"/Users/nick/code/microtags.preact-adapter-03-preact-adapter-server-render/test/preact-ssr.ts","content":"import { test } from '@substrate-system/tapzero'\nimport { h } from 'preact'\nimport { renderToString } from 'preact-render-to-string'\nimport { define } from '../src/index.js'\nimport { html } from '../src/htm.js'\nimport { toPreact } from '../src/preact.js'\n\n// These tests run under Node with no DOM (see `npm run test:preact-ssr`).\n// They render the `microtags/preact` adapter with Preact's own\n// `renderToString` and compare it with the component's `render` static.\n// Preact orders and quotes attributes its own way, so the host start\n// tags are compared parsed, and the inner HTML as a string.\n\ninterface Host {\n    tag:string\n    attrs:Record<string, string>\n    inner:string\n}\n\nconst _named:Record<string, string> = {\n    amp: '&', quot: '\"', apos: \"'\", lt: '<', gt: '>',\n}\n\nfunction decode (s:string):string {\n    return s.replace(/&(#x[\\da-f]+|#\\d+|[a-z]+);/gi, (m, e:string) => {\n        if (e[0] !== '#') return _named[e.toLowerCase()] ?? m\n        return String.fromCodePoint(e[1] === 'x' || e[1] === 'X' ?\n            parseInt(e.slice(2), 16) :\n            parseInt(e.slice(1), 10))\n    })\n}\n\n/**\n * Parse one host element: its tag name, its attributes as a decoded\n * name -> value map (a bare attribute is the empty string), and the\n * raw HTML between the start tag and the matching end tag.\n */\nfunction parseHost (s:string):Host {\n    const start = /^<([a-z][-\\w]*)/i.exec(s)\n    if (!start) throw new Error('not an element: ' + s)\n    const tag = start[1].toLowerCase()\n    const attrs:Record<string, string> = {}\n    const re = new RegExp(\n        '\\\\s+([^\\\\s\"\\'>/=]+)' +\n        '(?:\\\\s*=\\\\s*(?:\"([^\"]*)\"|\\'([^\\']*)\\'|([^\\\\s\"\\'=<>`]+)))?',\n        'y'\n    )\n    let i = start[0].length\n    for (;;) {\n        re.lastIndex = i\n        const m = re.exec(s)\n        if (!m) break\n        attrs[m[1].toLowerCase()] = decode(m[2] ?? m[3] ?? m[4] ?? '')\n        i = re.lastIndex\n    }\n    const close = /^\\s*>/.exec(s.slice(i))\n    if (!close) throw new Error('unterminated start tag: ' + s)\n    i += close[0].length\n    const end = `</${tag}>`\n    if (!s.endsWith(end)) throw new Error('no end tag: ' + s)\n    return { tag, attrs, inner: s.slice(i, s.length - end.length) }\n}\n\nconst El = define('preact-ssr-el')\n    .withProps(p => ({\n        n: p.number(),\n        s: p.string(),\n        on: p.boolean(),\n        off: p.boolean(),\n        j: p.json<{ a:string }>(),\n        internal: p.prop(7),\n    }))\n    .render(({ props }) => {\n        return html`<b>${props.n}</b><i>${props.s}</i>` +\n            `<u>${props.internal}</u>`\n    })\n    .setup(() => {})\n\nconst props = {\n    n: 3,\n    s: 'a\"b<c & d',\n    on: true,\n    off: false,\n    j: { a: '<&>\"\\'' },\n    internal: 9,\n}\n\ntest('toPreact: renderToString matches the render static', t => {\n    const C = toPreact(El)\n    const got = parseHost(renderToString(h(C, props)))\n    const want = parseHost(El.render(props))\n    t.equal(got.tag, want.tag, 'same tag')\n    t.deepEqual(got.attrs, want.attrs, 'same attribute map')\n    t.equal(got.inner, want.inner, 'same inner HTML')\n    t.ok(got.inner.includes('<u>9</u>'), 'the prop-only prop is rendered')\n})\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6533,"cache_read_input_tokens":74726,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6533},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"106ce310-aed3-4fb7-a285-935ac4c8488d","uuid":"b8431bb9-2f99-4cbe-a3b5-c56559748122","timestamp":"2026-11-09T06:08:57.493Z","request_id":"req_011CgrrYrzuq4tQPNRYsjyzG","wire_tool_inputs":{"toolu_01XurKUpwRfGBqE8qycJg3a2":{"file_path":"/Users/nick/code/microtags.preact-adapter-03-preact-adapter-server-render/test/preact-ssr.ts","content":"import { test } from '@substrate-system/tapzero'\nimport { h } from 'preact'\nimport { renderToString } from 'preact-render-to-string'\nimport { define } from '../src/index.js'\nimport { html } from '../src/htm.js'\nimport { toPreact } from '../src/preact.js'\n\n// These tests run under Node with no DOM (see `npm run test:preact-ssr`).\n// They render the `microtags/preact` adapter with Preact's own\n// `renderToString` and compare it with the component's `render` static.\n// Preact orders and quotes attributes its own way, so the host start\n// tags are compared parsed, and the inner HTML as a string.\n\ninterface Host {\n    tag:string\n    attrs:Record<string, string>\n    inner:string\n}\n\nconst _named:Record<string, string> = {\n    amp: '&', quot: '\"', apos: \"'\", lt: '<', gt: '>',\n}\n\nfunction decode (s:string):string {\n    return s.replace(/&(#x[\\da-f]+|#\\d+|[a-z]+);/gi, (m, e:string) => {\n        if (e[0] !== '#') return _named[e.toLowerCase()] ?? m\n        return String.fromCodePoint(e[1] === 'x' || e[1] === 'X' ?\n            parseInt(e.slice(2), 16) :\n            parseInt(e.slice(1), 10))\n    })\n}\n\n/**\n * Parse one host element: its tag name, its attributes as a decoded\n * name -> value map (a bare attribute is the empty string), and the\n * raw HTML between the start tag and the matching end tag.\n */\nfunction parseHost (s:string):Host {\n    const start = /^<([a-z][-\\w]*)/i.exec(s)\n    if (!start) throw new Error('not an element: ' + s)\n    const tag = start[1].toLowerCase()\n    const attrs:Record<string, string> = {}\n    const re = new RegExp(\n        '\\\\s+([^\\\\s\"\\'>/=]+)' +\n        '(?:\\\\s*=\\\\s*(?:\"([^\"]*)\"|\\'([^\\']*)\\'|([^\\\\s\"\\'=<>`]+)))?',\n        'y'\n    )\n    let i = start[0].length\n    for (;;) {\n        re.lastIndex = i\n        const m = re.exec(s)\n        if (!m) break\n        attrs[m[1].toLowerCase()] = decode(m[2] ?? m[3] ?? m[4] ?? '')\n        i = re.lastIndex\n    }\n    const close = /^\\s*>/.exec(s.slice(i))\n    if (!close) throw new Error('unterminated start tag: ' + s)\n    i += close[0].length\n    const end = `</${tag}>`\n    if (!s.endsWith(end)) throw new Error('no end tag: ' + s)\n    return { tag, attrs, inner: s.slice(i, s.length - end.length) }\n}\n\nconst El = define('preact-ssr-el')\n    .withProps(p => ({\n        n: p.number(),\n        s: p.string(),\n        on: p.boolean(),\n        off: p.boolean(),\n        j: p.json<{ a:string }>(),\n        internal: p.prop(7),\n    }))\n    .render(({ props }) => {\n        return html`<b>${props.n}</b><i>${props.s}</i>` +\n            `<u>${props.internal}</u>`\n    })\n    .setup(() => {})\n\nconst props = {\n    n: 3,\n    s: 'a\"b<c & d',\n    on: true,\n    off: false,\n    j: { a: '<&>\"\\'' },\n    internal: 9,\n}\n\ntest('toPreact: renderToString matches the render static', t => {\n    const C = toPreact(El)\n    const got = parseHost(renderToString(h(C, props)))\n    const want = parseHost(El.render(props))\n    t.equal(got.tag, want.tag, 'same tag')\n    t.deepEqual(got.attrs, want.attrs, 'same attribute map')\n    t.equal(got.inner, want.inner, 'same inner HTML')\n    t.ok(got.inner.includes('<u>9</u>'), 'the prop-only prop is rendered')\n})\n"}}}
