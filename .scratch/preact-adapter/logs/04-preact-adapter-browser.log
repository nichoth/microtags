{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgrs3HPecGJULzwWS7jKv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015HFypFDcmSfDCYRD8SWcfL","name":"Write","input":{"file_path":"/Users/nick/code/microtags.preact-adapter-04-preact-adapter-browser/src/preact.browser.ts","content":"// `microtags/preact`, browser build. Renders the host tag only: the\n// declared props go to the host's prop accessors, mapped events become\n// `on<event-name>` listeners, and a fixed empty `dangerouslySetInnerHTML`\n// keeps Preact out of the host's children. Never imports render\n// support. See ADR-010.\nimport { h, type VNode } from 'preact'\nimport {\n    splitProps,\n    type EventMap,\n    type PreactComponent,\n    type PreactElementClass,\n    type ToPreactOptions,\n} from './preact-shared.js'\n\nexport type {\n    DeclaredProps,\n    EventMap,\n    PassthroughProps,\n    PreactComponent,\n    PreactElementClass,\n    PreactProps,\n    ToPreactOptions,\n} from './preact-shared.js'\n\n// One shared value: Preact writes `innerHTML` only when `__html`\n// changes, and never while hydrating.\nconst EMPTY = { __html: '' }\n\n/**\n * Wrap a microtags element class as a Preact component. Preact owns the\n * host and its attributes; the element owns the host's children.\n */\nexport function toPreact<\n    C extends PreactElementClass,\n    E extends EventMap = Record<never, never>,\n> (El:C, options?:ToPreactOptions<E>):PreactComponent<C, E> {\n    const events:EventMap = options?.events ?? {}\n    return (props:Record<string, unknown>):VNode<any> => {\n        const { own, on, rest } = splitProps(El, events, props)\n        const vprops:Record<string, unknown> = { ...rest, ...own }\n        for (const k in on) vprops['on' + k] = on[k]\n        vprops.dangerouslySetInnerHTML = EMPTY\n        return h(El.TAG, vprops)\n    }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":nul