-010.\nimport { h, type VNode } from 'preact'\nimport './render-support.js'\nimport {\n    splitProps,\n    type EventMap,\n    type PreactComponent,\n    type PreactElementClass,\n    type ToPreactOptions,\n} from './preact-shared.js'\n\nexport type {\n    DeclaredProps,\n    EventMap,\n    PassthroughProps,\n    PreactComponent,\n    PreactElementClass,\n    PreactProps,\n    ToPreactOptions,\n} from './preact-shared.js'\n\n/**\n * Wrap a microtags element class as a Preact component. Preact owns the\n * host and its attributes; the element owns the host's children.\n */\nexport function toPreact<\n    C extends PreactElementClass,\n    E extends EventMap = Record<never, never>,\n> (El:C, options?:ToPreactOptions<E>):PreactComponent<C, E> {\n    const events:EventMap = options?.events ?? {}\n    return (props:Record<string, unknown>):VNode<any> => {\n        const { own, rest } = splitProps(El, events, props)\n        if (!El.renderParts) {\n            throw new Error(\n                `microtags/preact: <${El.TAG}> has no render link. On ` +\n                'the server, import the variant of this component that ' +\n                'keeps its render link.'\n            )\n        }\n        const extra:Record<string, string> = {}\n        for (const k in rest) {\n            if (rest[k] != null) extra[k] = String(rest[k])\n        }\n        const { tag, attrs, html } = El.renderParts(own, { attrs: extra })\n        const vprops:Record<string, unknown> = {}\n        for (const k in attrs) vprops[k] = attrs[k] === '' ? true : attrs[k]\n        vprops.dangerouslySetInnerHTML = { __html: html }\n        return h(tag, vprops)\n    }\n}\n// Types and prop mapping shared by both builds of `microtags/preact`\n// (the default server build and the browser build). Never imports\n// render support. See ADR-010.\nimport type { FunctionComponent } from 'preact'\nimport type { RenderParts } from './builders.js'\n\n/**\n * The part of a microtags element class the adapter reads. Any class\n * from `setup` fits; `renderParts` is absent at runtime when the class\n * has no render link.\n */\nexport interface PreactElementClass<P = any> {\n    readonly TAG:string\n    readonly props:readonly string[]\n    readonly renderParts?:(\n        props:P,\n        options?:{ children?:string; attrs?:Record<string, string> }\n    ) => RenderParts\n}\n\n/** Map from callback prop name to DOM event name. */\nexport type EventMap = Record<string, string>\n\nexport interface ToPreactOptions<E extends EventMap = EventMap> {\n    /** e.g. `{ onChange: 'number-input:change' }` */\n    events?:E\n}\n\ntype AttrValue = string | number | boolean | null | undefined\n\n/** Host attributes passed through to the host tag. */\nexport interface PassthroughProps {\n    class?:string\n    id?:string\n    [aria:`aria-${string}`]:AttrValue\n    [data:`data-${string}`]:AttrValue\n}\n\n/** The declared props of an element class, all optional. */\nexport type DeclaredProps<C> =\n    C extends { renderParts?:(props:infer P, ...a:any[]) => any } ?\n        Partial<P> :\n        never\n\n/**\n * Props of the Preact component `toPreact` returns: the declared\n * props, one callback per mapped event, passthrough host attributes,\n * and no children.\n */\nexport type PreactProps<C, E extends EventMap = Record<never, never>> =\n    DeclaredProps<C> &\n    { [K in keyof E]?:(ev:CustomEvent) => void } &\n    PassthroughProps &\n    { children?:never }\n\nexport type PreactComponent<C, E extends EventMap> =\n    FunctionComponent<PreactProps<C, E>>\n\n/** Props split by where they go on the host. */\nexport interface SplitProps {\n    /** declared props, by name */\n    own:Record<string, unknown>\n    /** handlers, by DOM event name */\n    on:Record<string, unknown>\n    /** passthrough host attributes */\n    rest:Record<string, unknown>\n}\n\n/**\n * Split adapter props into declared props, event handlers (keyed by DOM\n * event name) and passthrough attributes. Throws, naming the tag, when\n * children are passed.\n */\nexport function splitProps (\n    El:PreactElementClass,\n    events:EventMap,\n    props:Record<string, unknown>\n):SplitProps {\n    if (props.children !== undefined) {\n        throw new Error(`microtags/preact: <${El.TAG}> takes no children`)\n    }\n    const own:Record<string, unknown> = {}\n    const on:Record<string, unknown> = {}\n    const rest:Record<string, unknown> = {}\n    for (const k in props) {\n        if (k === 'children') continue\n        if (El.props.includes(k)) own[k] = props[k]\n        else if (Object.hasOwn(events, k)) on[events[k]] = props[k]\n        else rest[k] = props[k]\n    }\n    return { own, on, rest }\n}\n{\n  \"name\": \"microtags\",\n  \"version\": \"0.0.14\",\n  \"description\": \"Web component helper\",\n  \"type\": \"module\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\",\n      \"require\": \"./dist/index.cjs\"\n    },\n    \"./min\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.min.js\"\n    },\n    \"./render\": {\n      \"types\": \"./dist/render.d.ts\",\n      \"import\": \"./dist/render.js\",\n      \"require\": \"./dist/render.cjs\"\n    },\n    \"./render-support\": {\n      \"types\": \"./dist/render-support.d.ts\",\n      \"import\": \"./dist/render-support.js\",\n      \"require\": \"./dist/render-support.cjs\"\n    },\n    \"./context\": {\n      \"types\": \"./dist/context.d.ts\",\n      \"import\": \"./dist/context.js\",\n      \"require\": \"./dist/context.cjs\"\n    },\n    \"./util\": {\n      \"types\": \"./dist/util.d.ts\",\n      \"import\": \"./dist/util.js\",\n      \"require\": \"./dist/util.cjs\"\n    },\n    \"./build\": {\n      \"types\": \"./dist/build.d.ts\",\n      \"import\": \"./dist/build.js\",\n      \"require\": \"./dist/build.cjs\"\n    },\n    \"./esbuild\": {\n      \"types\": \"./dist/esbuild.d.ts\",\n      \"import\": \"./dist/esbuild.js\",\