rkdown-toc --maxdepth 5 -i README.md\",\n108:    \"toc:hydration\": \"markdown-toc --maxdepth 3 -i example-hydration/README.md\",\n109-    \"preversion\": \"npm run lint\",\n110:    \"version\": \"npm run toc && npm run toc:hydration && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && npm run inject-size && git add CHANGELOG.md README.md\",\n111-    \"postversion\": \"git push --follow-tags && npm publish\",\n112-    \"prepublishOnly\": \"npm run build\",\n113-    \"test:hydration\": \"npm run build:hydration && npx esbuild ./test/hydration.ts --bundle --format=esm --platform=node --packages=external --loader:.css=empty | node --input-type=module && npx esbuild ./test/hydration-listen.ts --bundle --format=esm --platform=node --packages=external | node --input-type=module\",","is_error":false}]},"parent_tool_use_id":null,"session_id":"fd578c50-847c-417e-9dc9-883d9c7ecbfc","uuid":"19029d5d-dab1-4286-8797-f727c373bab4","timestamp":"2026-11-09T06:22:03.672Z","tool_use_result":{"stdout":"/**\n * Inject bundle sizes (as measured by size-limit) into README.md.\n * Measures whatever is in dist, so build before running.\n */\nimport { execSync } from 'node:child_process'\nimport { readFileSync, writeFileSync } from 'node:fs'\n\nconst MARKERS:[string, string, string][] = [\n    ['microtags', '<!-- size -->', '<!-- /size -->'],\n    ['microtags/htm', '<!-- size:htm -->', '<!-- /size:htm -->'],\n]\n\nconst json = execSync('size-limit --json', { encoding: 'utf8' })\nconst results:Array<{ name:string; size:number }> = JSON.parse(json)\n\nlet readme = readFileSync('README.md', 'utf8')\n\nfor (const [name, start, end] of MARKERS) {\n    const entry = results.find(r => r.name === name)\n    if (!entry) {\n        throw new Error(\n            `size-limit returned no result for \"${name}\"`\n        )\n    }\n\n    const pattern = new RegExp(\n        `${escapeRe(start)}[\\\\s\\\\S]*?${escapeRe(end)}`\n    )\n\n    if (!pattern.test(readme)) {\n        throw new Error(\n            'README.md is missing the '\n            + `\"${start} ... ${end}\" markers`\n        )\n    }\n\n    const value = `${(entry.size / 1000).toFixed(2)} KB`\n    readme = readme.replace(\n        pattern,\n        `${start}${value}${end}`\n    )\n    process.stdout.write(\n        `Injected ${name} size ${value} into README.md\\n`\n    )\n}\n\nwriteFileSync('README.md', readme)\n\nfunction escapeRe (s:string):string {\n    return s.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')\n}\n// .size-limit.js\nexport default [\n    {\n        name: 'microtags',\n        path: 'dist/index.min.js',\n        // measured 3.96 kB with server render support moved out of\n        // core (ADR-009) and the typed bind helper; 3.99 kB with the\n        // renderParts static, rounded up to the next 0.05 kB\n        limit: '4 kB',\n    },\n    {\n        name: 'microtags/htm',\n        path: 'dist/htm.min.js',\n        limit: '5 kB',\n    },\n    {\n        name: 'microtags/htm (browser)',\n        path: 'dist/htm.browser.min.js',\n        // measured 4.77 kB after the guarded moveBefore, the duplicate\n        // key check, raw() span adoption, the Markup brand symbol and\n        // the void-element children check; 4.82 kB after the\n        // attribute name guard; 4.94 kB with form controls bound as\n        // DOM properties; 4.99 kB with the adoption mismatch\n        // lookahead; 5.25 kB carrying the server render support\n        // module (ADR-009); 5.29 kB with adopted controls compared\n        // against the server value; 5.31 kB with the lookahead held\n        // inside its range; 5.39 kB with render support building the\n        // host tag from render parts, rounded up to the next 0.05 kB\n        limit: '5.4 kB',\n    },\n    {\n        name: 'microtags/preact (browser)',\n        path: 'dist/preact.browser.min.js',\n        // measures the adapter alone (preact is a peer); measured\n        // 443 B, rounded up to the next 0.05 kB\n        ignore: ['preact'],\n        limit: '450 B',\n    },\n]\n1:# microtags\n22:| `microtags/htm` | <!-- size:htm -->1.23 KB<!-- /size:htm --> |\n28:- [Install](#install)\n31:- [Get Started](#get-started)\n35:- [Full Example](#full-example)\n36:- [Validation](#validation)\n40:- [Serverside Example](#serverside-example)\n43:- [Hydration](#hydration)\n44:- [API](#api)\n59:- [Missing refs](#missing-refs)\n61:- [Typed Events](#typed-events)\n62:- [Templates](#templates)\n63:- [Subpath Exports](#subpath-exports)\n82:- [Differences from `nanotags`](#differences-from-nanotags)\n95:## Install\n101:### Import map\n124:### Pre-bundled\n139:## Get Started\n141:### 1. Call `.define`\n151:### 2. Call the `.with*` Methods\n170:### 3. Call `.setup`\n209:## Full Example\n279:## Validation\n292:### Prop validation\n328:#### `p.schema` vs Standard Schema\n367:### Client-side validation\n433:## Serverside Example\n441:### `.TAG`\n492:### `.refs`\n513:## Hydration\n532:## API\n534:### `define`\n543:#### `ComponentBuilder`\n561:### `builder.withProps`\n599:#### `p.json`\n632:#### `p.schema`\n641:### `builder.withRefs(fn)`\n693:### `builder.withContexts`\n708:#### `.withContexts` Example\n768:### `builder.render(fn, options?)`\n867:### `builder.setup(ctx)`\n897:#### `ctx`\n905:##### `ctx` Methods\n919:##### `ctx.bind`\n958:### `bindProp`\n989:## Missing refs\n1012:### Checking refs in tests\n1046:## Typed Events\n1073:## Templates\n1146:## Subpath Exports\n1148:### `microtags/context`\n1214:### `microtags/render`\n1237:#### `renderList`\n1258:##### `renderList` Example\n1286:#### `render`\n1302:##### `render` Example\n1334:### `microtags/util`\n1352:#### Coercion\n1374:#### `runAll`\n1384:#### `toAttributes`\n1407:### `microtags/htm`\n1453:#### What escaping does not cover\n1490:### `microtags/render-support`\n1510:### `microtags/build`\n1570:### `microtags/esbuild`\n1592:### `microtags/vite`\n1611:### `microbuild`\n1616:# stdin/stdout -- one file\n1619:# glob mode -- requires --outdir\n1633:### `client:true` vs `--keep`\n1653:## Differences from `nanotags`\n1655:### Reactivity primitive\n1669:### Effects + Subscriptions\n1696:### Refs: `r.all` instead of `r.many`\n1704:### Context API\n1716:### Props\n1725:### Not ported\n1734:### Additions / New Features\n3:  \"version\": \"0.0.14\",\n4-  \"description\": \"Web component helper\",\n5-  \"type\": \"module\",\n6-  \"exports\": {\n--\n79:  \"files\": [\n80-    \"./dist/*\"\n81-  ],\n82-  \"scripts\": {\n--\n101:    \"inject-size\": \"esbuild ./scripts/inject-size.ts --bundle --platform=node --format=cjs | node\",\n102-    \"start\": \"npm run build-html && vite --open /example/\",\n103-    \"start:hydration\": \"npm run build:node && vite --config example-hydration/vite.config.ts --open /example-hydration/\",\n104-    \"ssr\": \"esbuild ./example/ssr.ts --bundle --platform=node --format=cjs | node \",\n--\n107:    \"toc\": \"markdown-toc --maxdepth 5 -i README.md\",\n108:    \"toc:hydration\": \"markdown-toc --maxdepth 3 -i example-hydration/README.md\",\n109-    \"preversion\": \"npm run lint\",\n110:    \"version\": \"npm run toc && npm run toc:hydration && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && npm run inject-size && git add CHANGELOG.md README.md\",\n111-    \"postversion\": \"git push --follow-tags && npm publish\",\n112-    \"prepublishOnly\": \"npm run build\",\n113-    \"test:hydration\": \"npm run build:hydration && npx esbuild ./test/hydration.ts --bundle --format=esm --platform=node --packages=external --loader:.css=empty | node --input-type=module && npx esbuild ./test/hydration-listen.ts --bundle --format=esm --platform=node --packages=external | node --input-type=module\",","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01BJnTVfAguoDV7FVUfkqaXB","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
