   ) old.push(n)\n    const keyed = new Map<string, Node>()\n    const unkeyed:Node[] = []\n    for (const n of old) {\n        const k = _key(n)\n        if (k !== null) keyed.set(k, n)\n        else unkeyed.push(n)\n    }\n\n    let u = 0\n    const nodes:Node[] = []\n    const used = new Set<Node>()\n    for (const item of _items(value)) {\n        const k = _key(item)\n        const cand = k !== null ? keyed.get(k) : unkeyed[u]\n        const kept = cand && !used.has(cand) ?\n            _patch(cand, item, offs) :\n            null\n        if (k === null && kept) u++\n        if (kept) {\n            used.add(kept)\n            nodes.push(kept)\n        } else {\n            nodes.push(..._create(item, offs))\n        }\n    }\n\n    _dom(() => {\n        for (const n of old) {\n            if (!used.has(n)) (n as ChildNode).remove()\n        }\n        // place from the end, moving only nodes out of position\n        let ref:Node | null = end\n        for (let i = nodes.length - 1; i >= 0; i--) {\n            const n = nodes[i]\n            if (n.parentNode !== parent || n.nextSibling !== ref) {\n                const p = parent as Node & {\n                    moveBefore?:(n:Node, r:Node | null) => void\n                }\n                if (used.has(n) && p.moveBefore) p.moveBefore(n, ref)\n                else parent.insertBefore(n, ref)\n            }\n            ref = n\n        }\n    })\n}\n\n// The comment closing the region opened by `start`.\nfunction _close (start:Node):Node | null {\n    let depth = 0\n    for (let s = start.nextSibling; s; s = s.nextSibling) {\n        if (!(s instanceof Comment)) continue\n        if (s.data === '[') depth++\n        else if (s.data === ']' && depth-- === 0) return s\n    }\n    return null","numLines":160,"startLine":270,"totalLines":524}},"tool_result_meta":[{"id":"toolu_01DZMDr7su7H52khYeJ38g7L","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
