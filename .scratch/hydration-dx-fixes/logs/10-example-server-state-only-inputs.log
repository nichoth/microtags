{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cg3PKd6Kpodc6JEfkUFor","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JWZ7w2jkJV6kanGv5WJv8u","name":"Bash","input":{"command":"cat test/hydration.ts && cat test/hydration-dev.ts | head -80 && cat example-hydration/client/index.ts && grep -n \"hydration\" package.json"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3388,"cache_read_input_tokens":47639,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3388},"output_tokens":8,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7208cf7e-7e1e-427b-a63d-adbbbefaf5e7","uuid":"59cfd7e2-a930-42e3-a180-2715097b3884","timestamp":"2026-10-15T04:23:49.663Z","request_id":"req_011Cg3PKcoDEDNJJfbV3n7Ca","wire_tool_inputs":{"toolu_01JWZ7w2jkJV6kanGv5WJv8u":{"command":"cd /Users/nick/code/microtags.hydration-dx-fixes-10-example-server-state-only-inputs && cat test/hydration.ts && cat test/hydration-dev.ts | head -80 && cat example-hydration/client/index.ts && grep -n \"hydration\" package.json"}},"wire_ingest_context":{"toolu_01JWZ7w2jkJV6kanGv5WJv8u":{"cwd":"/Users/nick/code/microtags.hydration-dx-fixes-10-example-server-state-only-inputs"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RYzikFVDWcvgsAvw1LkJQA","type":"tool_result","content":"example-hydration/index.html\nexample-hydration/README.md\nexample-hydration/state.ts\nexample-hydration/vite.config.ts\n\nexample-hydration:\nclient/\ncomponents/\nindex.html\npages/\nREADME.md\nserver/\nstate.ts\nvite.config.ts\n\nexample-hydration/client:\nindex.css\nindex.ts\nutil.ts\n\nexample-hydration/components:\nbadge.css\nbadge.ts\ncounter.css\ncounter.ts\nnotice.ts\n\nexample-hydration/pages:\nindex.ts\nlayout.ts\nlist.ts\nnot-found.ts\nnotice.ts\nroutes.ts\n\nexample-hydration/server:\napp.ts\nlisten.ts\nscaffold.ts\nssr.ts\ntsconfig.json\nimport { Hono, type Context } from 'hono'\nimport type { Serialized } from 'microtags'\nimport {\n    assemble,\n    stateScript,\n    type ScaffoldLoader,\n} from './scaffold.js'\nimport { State, serialize, type AppState } from '../state.js'\nimport { Layout, PREFIX } from '../pages/layout.js'\nimport { pageFor, IndexPage } from '../pages/routes.js'\nimport type { IndexOptions } from '../pages/index.js'\n\nexport { PREFIX }\n\nexport interface AppOptions {\n    loadScaffold:ScaffoldLoader;\n    index?:IndexOptions;\n}\n\nexport function createApp (opts:AppOptions):Hono {\n    const app = new Hono()\n\n    async function page (state:AppState):Promise<string> {\n        const route = state.route()\n        const body = pageFor(route) === IndexPage ?\n            IndexPage(state, opts.index) :\n            pageFor(route)(state)\n        return assemble(\n            await opts.loadScaffold(),\n            String(Layout(state, body)),\n            stateScript(serialize(state))\n        )\n    }\n\n    const index = async (c:Context) => {\n        const state = stateFor(c, { count: countParam(c.req.query('count')) })\n        return c.html(await page(state))\n    }\n\n    app.get(PREFIX, c => c.redirect(`${PREFIX}/`))\n    app.get(`${PREFIX}/`, index)\n    // the HTML entry's own path must never return the raw scaffold\n    app.get(`${PREFIX}/index.html`, index)\n    app.get(`${PREFIX}/list`, async c => c.html(await page(stateFor(c))))\n    app.get(`${PREFIX}/notice`, async c => c.html(await page(stateFor(c))))\n\n    app.notFound(async c => c.html(await page(stateFor(c)), 404))\n\n    return app\n}\n\n/** State for a request: `route` is the path without the prefix. */\nfunction stateFor (\n    c:Context,\n    input:Partial<Serialized<AppState>> = {}\n):AppState {\n    const path = c.req.path\n    const route = path.startsWith(PREFIX) ?\n        path.slice(PREFIX.length) || '/' :\n        path\n    return State({ ...input, route })\n}\n\n/** A finite integer, or `undefined` so the default applies. */\nfunction countParam (raw:string|undefined):number|undefined {\n    if (raw === undefined || !/^-?\\d+$/.test(raw.trim())) return undefined\n    const n = Number(raw)\n    return Number.isSafeInteger(n) ? n : undefined\n}\nimport type { Serialized, Signal } from 'microtags'\nimport { signal } from 'alien-signals'\n\nexport interface AppState {\n    route:Signal<string>;\n    count:Signal<number>;\n    noticeOpen:Signal<boolean>;\n    labels:Signal<string[]>;\n}\n\nexport const DEFAULT_COUNT = 5\n\n/** Id of the JSON script that carries the state to the browser. */\nexport const STATE_ID = 'microtags-state'\n\n/**\n * Build the app state. Missing keys get defaults. Write to the signals\n * only through the static functions below.\n */\nexport function State (input:Partial<Serialized<AppState>> = {}):AppState {\n    return {\n        route: signal(input.route ?? '/'),\n        count: signal(input.count ?? DEFAULT_COUNT),\n        noticeOpen: signal(input.noticeOpen ?? false),\n        labels: signal(input.labels ?? ['alpha', 'beta', 'gamma']),\n    }\n}\n\nState.increase = function (state:AppState):void {\n    state.count(state.count() + 1)\n}\n\nState.decrease = function (state:AppState):void {\n    state.count(state.count() - 1)\n}\n\nState.openNotice = function (state:AppState):void {\n    state.noticeOpen(true)\n}\n\nState.dismissNotice = function (state:AppState):void {\n    state.noticeOpen(false)\n}\n\nState.addLabel = function (state:AppState, label:string):void {\n    state.labels([...state.labels(), label])\n}\n\nState.removeLabel = function (state:AppState, label:string):void {\n    state.labels(state.labels().filter(l => l !== label))\n}\n\n/** The plain JSON form of the state. */\nexport function serialize (state:AppState):Serialized<AppState> {\n    return {\n        route: state.route(),\n        count: state.count(),\n        noticeOpen: state.noticeOpen(),\n        labels: state.labels(),\n    }\n}\nimport { html, type Markup } from 'microtags/htm'\nimport { Counter } from '../components/counter.js'\nimport { Badge } from '../components/badge.js'\nimport { State, type AppState } from '../state.js'\n\nexport interface IndexOptions {\n    heading?:string;\n    label?:string;\n}\n\nexport function IndexPage (\n    state:AppState,\n    opts:IndexOptions = {}\n):Markup {\n    const heading = opts.heading ?? 'Counter with nested badge'\n    const label = opts.label ?? 'nested'\n\n    return html`\n        <h1>${heading}</h1>\n        <section class=\"counter-section\">\n            <${Counter}\n                count=${state.count}\n                onincrement=${() => State.increase(state)}\n                ondecrement=${() => State.decrease(state)}\n            >\n                <${Badge} label=${label} />\n            <//>\n        </section>`\n}\nimport type { Markup } from 'microtags/htm'\nimport type { AppState } from '../state.js'\nimport { IndexPage } from './index.js'\nimport { ListPage } from './list.js'\nimport { NoticePage } from './notice.js'\nimport { NotFoundPage } from './not-found.js'\n\nexport { IndexPage, ListPage, NoticePage, NotFoundPage }\n\nexport type Page = (state:AppState) => Markup\n\n/** Route (path without the prefix) to page. Shared by both sides. */\nexport const ROUTES:Record<string, Page> = {\n    '/': IndexPage,\n    '/index.html': IndexPage,\n    '/list': ListPage,\n    '/notice': NoticePage,\n}\n\n/** The page for a route, or the not-found page. */\nexport function pageFor (route:string):Page {\n    return Object.hasOwn(ROUTES, route) ? ROUTES[route] : NotFoundPage\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"7208cf7e-7e1e-427b-a63d-adbbbefaf5e7","uuid":"2955176c-5626-4e02-be2f-0751e20d71fd","timestamp":"2026-10-15T04:23:54.266Z","tool_use_result":{"stdout":"example-hydration/index.html\nexample-hydration/README.md\nexample-hydration/state.ts\nexample-hydration/vite.config.ts\n\nexample-hydration:\nclient/\ncomponents/\nindex.html\npages/\nREADME.md\nserver/\nstate.ts\nvite.config.ts\n\nexample-hydration/client:\nindex.css\nindex.ts\nutil.ts\n\nexample-hydration/components:\nbadge.css\nbadge.ts\ncounter.css\ncounter.ts\nnotice.ts\n\nexample-hydration/pages:\nindex.ts\nlayout.ts\nlist.ts\nnot-found.ts\nnotice.ts\nroutes.ts\n\nexample-hydration/server:\napp.ts\nlisten.ts\nscaffold.ts\nssr.ts\ntsconfig.json\nimport { Hono, type Context } from 'hono'\nimport type { Serialized } from 'microtags'\nimport {\n    assemble,\n    stateScript,\n    type ScaffoldLoader,\n} from './scaffold.js'\nimport { State, serialize, type AppState } from '../state.js'\nimport { Layout, PREFIX } from '../pages/layout.js'\nimport { pageFor, IndexPage } from '../pages/routes.js'\nimport type { IndexOptions } from '../pages/index.js'\n\nexport { PREFIX }\n\nexport interface AppOptions {\n    loadScaffold:ScaffoldLoader;\n    index?:IndexOptions;\n}\n\nexport function createApp (opts:AppOptions):Hono {\n    const app = new Hono()\n\n    async function page (state:AppState):Promise<string> {\n        const route = state.route()\n        const body = pageFor(route) === IndexPage ?\n            IndexPage(state, opts.index) :\n            pageFor(route)(state)\n        return assemble(\n            await opts.loadScaffold(),\n            String(Layout(state, body)),\n            stateScript(serialize(state))\n        )\n    }\n\n    const index = async (c:Context) => {\n        const state = stateFor(c, { count: countParam(c.req.query('count')) })\n        return c.html(await page(state))\n    }\n\n    app.get(PREFIX, c => c.redirect(`${PREFIX}/`))\n    app.get(`${PREFIX}/`, index)\n    // the HTML entry's own path must never return the raw scaffold\n    app.get(`${PREFIX}/index.html`, index)\n    app.get(`${PREFIX}/list`, async c => c.html(await page(stateFor(c))))\n    app.get(`${PREFIX}/notice`, async c => c.html(await page(stateFor(c))))\n\n    app.notFound(async c => c.html(await page(stateFor(c)), 404))\n\n    return app\n}\n\n/** State for a request: `route` is the path without the prefix. */\nfunction stateFor (\n    c:Context,\n    input:Partial<Serialized<AppState>> = {}\n):AppState {\n    const path = c.req.path\n    const route = path.startsWith(PREFIX) ?\n        path.slice(PREFIX.length) || '/' :\n        path\n    return State({ ...input, route })\n}\n\n/** A finite integer, or `undefined` so the default applies. */\nfunction countParam (raw:string|undefined):number|undefined {\n    if (raw === undefined || !/^-?\\d+$/.test(raw.trim())) return undefined\n    const n = Number(raw)\n    return Number.isSafeInteger(n) ? n : undefined\n}\nimport type { Serialized, Signal } from 'microtags'\nimport { signal } from 'alien-signals'\n\nexport interface AppState {\n    route:Signal<string>;\n    count:Signal<number>;\n    noticeOpen:Signal<boolean>;\n    labels:Signal<string[]>;\n}\n\nexport const DEFAULT_COUNT = 5\n\n/** Id of the JSON script that carries the state to the browser. */\nexport const STATE_ID = 'microtags-state'\n\n/**\n * Build the app state. Missing keys get defaults. Write to the signals\n * only through the static functions below.\n */\nexport function State (input:Partial<Serialized<AppState>> = {}):AppState {\n    return {\n        route: signal(input.route ?? '/'),\n        count: signal(input.count ?? DEFAULT_COUNT),\n        noticeOpen: signal(input.noticeOpen ?? false),\n        labels: signal(input.labels ?? ['alpha', 'beta', 'gamma']),\n    }\n}\n\nState.increase = function (state:AppState):void {\n    state.count(state.count() + 1)\n}\n\nState.decrease = function (state:AppState):void {\n    state.count(state.count() - 1)\n}\n\nState.openNotice = function (state:AppState):void {\n    state.noticeOpen(true)\n}\n\nState.dismissNotice = function (state:AppState):void {\n    state.noticeOpen(false)\n}\n\nState.addLabel = function (state:AppState, label:string):void {\n    state.labels([...state.labels(), label])\n}\n\nState.removeLabel = function (state:AppState, label:string):void {\n    state.labels(state.labels().filter(l => l !== label))\n}\n\n/** The plain JSON form of the state. */\nexport function serialize (state:AppState):Serialized<AppState> {\n    return {\n        route: state.route(),\n        count: state.count(),\n        noticeOpen: state.noticeOpen(),\n        labels: state.labels(),\n    }\n}\nimport { html, type Markup } from 'microtags/htm'\nimport { Counter } from '../components/counter.js'\nimport { Badge } from '../components/badge.js'\nimport { State, type AppState } from '../state.js'\n\nexport interface IndexOptions {\n    heading?:string;\n    label?:string;\n}\n\nexport function IndexPage (\n    state:AppState,\n    opts:IndexOptions = {}\n):Markup {\n    const heading = opts.heading ?? 'Counter with nested badge'\n    const label = opts.label ?? 'nested'\n\n    return html`\n        <h1>${heading}</h1>\n        <section class=\"counter-section\">\n            <${Counter}\n                count=${state.count}\n                onincrement=${() => State.increase(state)}\n                ondecrement=${() => State.decrease(state)}\n            >\n                <${Badge} label=${label} />\n            <//>\n        </section>`\n}\nimport type { Markup } from 'microtags/htm'\nimport type { AppState } from '../state.js'\nimport { IndexPage } from './index.js'\nimport { ListPage } from './list.js'\nimport { NoticePage } from './notice.js'\nimport { NotFoundPage } from './not-found.js'\n\nexport { IndexPage, ListPage, NoticePage, NotFoundPage }\n\nexport type Page = (state:AppState) => Markup\n\n/** Route (path without the prefix) to page. Shared by both sides. */\nexport const ROUTES:Record<string, Page> = {\n    '/': IndexPage,\n    '/index.html': IndexPage,\n    '/list': ListPage,\n    '/notice': NoticePage,\n}\n\n/** The page for a route, or the not-found page. */\nexport function pageFor (route:string):Page {\n    return Object.hasOwn(ROUTES, route) ? ROUTES[route] : NotFoundPage\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01RYzikFVDWcvgsAvw1LkJQA","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JWZ7w2jkJV6kanGv5WJv8u","type":"tool_result","content":"import { test } from '@substrate-system/tapzero'\nimport * as fs from 'fs'\nimport * as path from 'path'\nimport type {\n    createApp as CreateApp\n} from '../example-hydration/server/app.js'\nimport { pathToFileURL } from 'url'\nimport type { Serialized } from 'microtags'\nimport { assemble } from '../example-hydration/server/scaffold.js'\nimport {\n    State,\n    serialize,\n    type AppState,\n} from '../example-hydration/state.js'\nimport {\n    pageFor,\n    IndexPage,\n    NotFoundPage,\n} from '../example-hydration/pages/routes.js'\n\n// the built app, from `npm run build:hydration`; loaded at runtime so\n// the bundler leaves the build output alone\nconst builtApp = pathToFileURL(\n    path.resolve('example-hydration/build/server/app.js')\n).href\nconst createApp:typeof CreateApp = (await import(builtApp)).createApp\n\n// Node request tests for the hydration example's Hono app. They go\n// through `app.request()`, so no port is bound. See\n// `npm run test:hydration`, which builds first.\n\nconst scaffold = fs.readFileSync(\n    path.resolve('example-hydration/index.html'),\n    'utf8'\n)\nconst MARKER = '<!--microtags:main-->'\n\nfunction hostHasChildren (page:string, tag:string):boolean {\n    const re = new RegExp(`<${tag}\\\\b[^>]*>([\\\\s\\\\S]*?)</${tag}>`)\n    const inner = page.match(re)?.[1] ?? ''\n    return /<[a-z]/i.test(inner)\n}\n\ntest('GET /example-hydration/ returns a complete html page', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const res = await app.request('/example-hydration/')\n    const page = await res.text()\n\n    t.equal(res.status, 200, 'status is 200')\n    t.ok(\n        (res.headers.get('content-type') ?? '').startsWith('text/html'),\n        'content type is text/html'\n    )\n    t.ok(!page.includes(MARKER), 'the outlet marker is replaced')\n    t.ok(hostHasChildren(page, 'hydra-counter'), 'counter host has children')\n    t.ok(hostHasChildren(page, 'hydra-badge'), 'badge host has children')\n    t.ok(/^<!DOCTYPE html>/i.test(page.trim()), 'scaffold owns the doctype')\n})\n\ntest('body text with special characters is escaped exactly once', async t => {\n    const nasty = '<b>\"Tom\" & \\'Jerry\\'</b> $& $1'\n    const app = createApp({\n        loadScaffold: () => scaffold,\n        index: { heading: nasty, label: nasty },\n    })\n    const page = await (await app.request('/example-hydration/')).text()\n    const escaped = '&lt;b&gt;&quot;Tom&quot; &amp; &#39;Jerry&#39;' +\n        '&lt;/b&gt; $&amp; $1'\n\n    t.ok(!page.includes(nasty), 'raw markup does not reach the page')\n    t.ok(page.includes(escaped), 'text is escaped and `$&` is literal')\n    t.ok(!page.includes('&amp;amp;'), 'nothing is escaped twice')\n    t.ok(!page.includes(MARKER), 'marker is not re-inserted by `$&`')\n})\n\ntest('a scaffold without exactly one marker fails assembly', async t => {\n    const none = scaffold.replace(MARKER, '')\n    const two = scaffold.replace(MARKER, MARKER + MARKER)\n\n    for (const [name, bad] of [['zero', none], ['two', two]]) {\n        const app = createApp({ loadScaffold: () => bad })\n        const res = await app.request('/example-hydration/')\n        const page = await res.text()\n        t.equal(res.status, 500, `${name} markers is a server error`)\n        t.ok(!page.includes('<main'), `${name} markers returns no page`)\n    }\n})\n\ntest('the scaffold hides the page until JS reveals it', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const page = await (await app.request('/example-hydration/')).text()\n    const htmlTag = page.match(/<html\\b[^>]*>/)?.[0] ?? ''\n    const head = page.match(/<head>([\\s\\S]*?)<\\/head>/)?.[1] ?? ''\n\n    t.ok(\n        /\\bclass=\"[^\"]*\\breduce-fouce\\b/.test(htmlTag),\n        'root html element starts with the reduce-fouce class'\n    )\n    t.ok(\n        /<noscript>[\\s\\S]*reduce-fouce[\\s\\S]*<\\/noscript>/.test(head),\n        'head has a noscript fallback that un-hides the page'\n    )\n})\n\nfunction isHtml (res:Response):boolean {\n    return (res.headers.get('content-type') ?? '').startsWith('text/html')\n}\n\ntest('GET /example-hydration/list renders several badges', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const res = await app.request('/example-hydration/list')\n    const page = await res.text()\n\n    t.equal(res.status, 200, 'status is 200')\n    t.ok(isHtml(res), 'content type is text/html')\n    t.ok(!page.includes(MARKER), 'the outlet marker is replaced')\n    const badges = page.match(/<hydra-badge\\b[^>]*>[\\s\\S]*?<\\/hydra-badge>/g)\n    t.ok((badges ?? []).length > 1, 'several badge hosts')\n    t.ok(\n        (badges ?? []).every(b => hostHasChildren(b, 'hydra-badge')),\n        'every badge host has children'\n    )\n})\n\ntest('list response has one keyed item per label in state', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const res = await app.request('/example-hydration/list')\n    const page = await res.text()\n    const json = page.match(\n        /<script[^>]*id=\"microtags-state\"[^>]*>([\\s\\S]*?)<\\/script>/\n    )?.[1]\n    const labels:string[] = JSON.parse(json ?? '{}').labels\n    t.ok(labels.length > 1, 'state has several labels')\n    const keys = [...page.matchAll(/<li\\b[^>]*\\bkey=\"([^\"]*)\"/g)]\n        .map(m => m[1])\n    t.deepEqual(keys, labels, 'one keyed item per label, in order')\n})\n\ntest('GET /example-hydration/notice has the button, no notice', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const res = await app.request('/example-hydration/notice')\n    const page = await res.text()\n\n    t.equal(res.status, 200, 'status is 200')\n    t.ok(isHtml(res), 'content type is text/html')\n    t.ok(!page.includes(MARKER), 'the outlet marker is replaced')\n    t.ok(/<button\\b[^>]*\\bid=\"show-notice\"/.test(page), 'has the button')\n    t.ok(!/<hydra-notice\\b/.test(page), 'no notice host while closed')\n    const json = page.match(\n        /<script\\b[^>]*id=\"microtags-state\"[^>]*>([\\s\\S]*?)<\\/script>/\n    )?.[1] ?? '{}'\n    t.equal(JSON.parse(json).noticeOpen, false, 'state says it is closed')\n})\n\ntest('an unknown path returns the scaffold with a 404', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const res = await app.request('/example-hydration/nope')\n    const page = await res.text()\n\n    t.equal(res.status, 404, 'status is 404')\n    t.ok(isHtml(res), 'content type is text/html')\n    t.ok(/<nav\\b/.test(page), 'nav is present')\n    t.ok(/<main\\b/.test(page), 'main is present')\n    t.ok(!page.includes(MARKER), 'the outlet marker is replaced')\n})\n\ntest('the bare prefix redirects to the canonical index', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const res = await app.request('/example-hydration')\n\n    t.ok(res.status >= 300 && res.status < 400, 'status is a redirect')\n    t.equal(\n        new URL(res.headers.get('location') ?? '', 'http://x').pathname,\n        '/example-hydration/',\n        'location is the index'\n    )\n})\n\nconst STATE_MARKER = '<!--microtags:state-->'\nconst STATE_RE =\n    /<script\\b[^>]*\\bid=\"microtags-state\"[^>]*>([\\s\\S]*?)<\\/script>/g\n\nfunction stateScripts (page:string):string[] {\n    return [...page.matchAll(STATE_RE)].map(m => m[1])\n}\n\nfunction payload (page:string):Serialized<AppState> {\n    return JSON.parse(stateScripts(page)[0])\n}\n\ntest('every route carries one state script before the module', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const routes = ['/', '/index.html', '/list', '/notice', '/nope']\n    for (const route of routes) {\n        const page = await (\n            await app.request('/example-hydration' + route)\n        ).text()\n        const scripts = stateScripts(page)\n        t.equal(scripts.length, 1, `${route} has one state script`)\n        t.ok(!page.includes(STATE_MARKER), `${route} state marker replaced`)\n        const stateAt = page.search(STATE_RE)\n        const moduleAt = page.search(/<script\\b[^>]*\\btype=\"module\"/)\n        t.ok(stateAt > -1 && stateAt < moduleAt,\n            `${route} state comes before the module script`)\n        const parsed = JSON.parse(scripts[0])\n        t.deepEqual(serialize(State(parsed)), parsed,\n            `${route} payload round-trips through State`)\n    }\n})\n\ntest('route in the payload is the path without the prefix', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const cases:[string, string][] = [\n        ['/', '/'],\n        ['/list', '/list'],\n        ['/notice', '/notice'],\n        ['/nope/deeper', '/nope/deeper'],\n    ]\n    for (const [path, route] of cases) {\n        const page = await (\n            await app.request('/example-hydration' + path)\n        ).text()\n        t.equal(payload(page).route, route, `${path} route is ${route}`)\n    }\n})\n\ntest('a valid count query parameter is reflected in state', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const page = await (\n        await app.request('/example-hydration/?count=12')\n    ).text()\n    t.equal(payload(page).count, 12, 'count is 12')\n})\n\ntest('an invalid count falls back to the default', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    for (const bad of ['1.5', 'Infinity', 'NaN', 'abc', '', '1e400']) {\n        const page = await (\n            await app.request('/example-hydration/?count=' +\n                encodeURIComponent(bad))\n        ).text()\n        t.equal(payload(page).count, 5, `count=${bad} falls back to 5`)\n    }\n})\n\ntest('a script closing tag in the path cannot escape the payload', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const evil = '/</script><script>alert(1)</script>'\n    const page = await (\n        await app.request('/example-hydration' + evil)\n    ).text()\n    const scripts = stateScripts(page)\n    t.equal(scripts.length, 1, 'one state script')\n    t.equal(JSON.parse(scripts[0]).route, evil,\n        'the payload parses and keeps the path')\n})\n\ntest('assemble requires exactly one of each marker', t => {\n    const cases:[string, string][] = [\n        ['no page marker', scaffold.replace(MARKER, '')],\n        ['two page markers', scaffold.replace(MARKER, MARKER + MARKER)],\n        ['no state marker', scaffold.replace(STATE_MARKER, '')],\n        ['two state markers',\n            scaffold.replace(STATE_MARKER, STATE_MARKER + STATE_MARKER)],\n    ]\n    for (const [name, bad] of cases) {\n        t.throws(() => assemble(bad, '', ''), name + ' throws')\n    }\n    t.ok(assemble(scaffold, '', ''), 'a good scaffold assembles')\n})\n\ntest('State fills defaults for missing keys', t => {\n    const full = serialize(State())\n    t.deepEqual(\n        Object.keys(full).sort(),\n        ['count', 'labels', 'noticeOpen', 'route'],\n        'every key is present'\n    )\n    const partial = serialize(State({ count: 9 }))\n    t.equal(partial.count, 9, 'given key is kept')\n    t.deepEqual(\n        { ...partial, count: full.count },\n        full,\n        'missing keys get defaults'\n    )\n})\n\ntest('each static mutator changes only its own signal', t => {\n    type Case = [\n        keyof AppState,\n        (s:AppState) => void,\n        Partial<Serialized<AppState>>?\n    ]\n    const cases:Case[] = [\n        ['count', s => State.increase(s)],\n        ['count', s => State.decrease(s)],\n        ['noticeOpen', s => State.openNotice(s), { noticeOpen: false }],\n        ['noticeOpen', s => State.dismissNotice(s), { noticeOpen: true }],\n        ['labels', s => State.addLabel(s, 'delta')],\n        ['labels', s => State.removeLabel(s, 'alpha')],\n    ]\n    for (const [key, mutate, input] of cases) {\n        const s = State(input)\n        const before = serialize(s)\n        mutate(s)\n        const after = serialize(s)\n        t.notDeepEqual(after[key], before[key], `${key} changed`)\n        t.deepEqual({ ...after, [key]: before[key] }, before,\n            `only ${key} changed`)\n    }\n})\n\nconst ROOT_RE = new RegExp('<div\\\\b[^>]*\\\\bid=\"root\"[^>]*>' +\n    '([\\\\s\\\\S]*?)</div>\\\\s*<section\\\\b[^>]*class=\"assertions\"')\n\ntest('the root element holds the navigation and the page', async t => {\n    t.ok(!/<nav\\b/.test(scaffold), 'the scaffold file has no nav')\n    const app = createApp({ loadScaffold: () => scaffold })\n    for (const route of ['/', '/list', '/notice', '/nope']) {\n        const page = await (\n            await app.request('/example-hydration' + route)\n        ).text()\n        const root = page.match(ROOT_RE)?.[1] ?? ''\n        t.ok(/<nav\\b/.test(root), `${route} root has the nav`)\n        t.ok(/<main\\b/.test(root), `${route} root has main`)\n        t.equal((page.match(/<nav\\b/g) ?? []).length, 1,\n            `${route} has one nav`)\n    }\n})\n\nfunction currentLinks (page:string):string[] {\n    return [...page.matchAll(/<a\\b[^>]*>/g)]\n        .map(m => m[0])\n        .filter(a => /\\baria-current=/.test(a))\n        .map(a => a.match(/\\bhref=\"([^\"]*)\"/)?.[1] ?? '')\n}\n\ntest('the link for the current route carries aria-current', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const cases:[string, string][] = [\n        ['/', '/example-hydration/'],\n        ['/list', '/example-hydration/list'],\n        ['/notice', '/example-hydration/notice'],\n    ]\n    for (const [route, href] of cases) {\n        const page = await (\n            await app.request('/example-hydration' + route)\n        ).text()\n        t.deepEqual(currentLinks(page), [href], `${route} marks ${href}`)\n    }\n    const missing = await (\n        await app.request('/example-hydration/nope')\n    ).text()\n    t.deepEqual(currentLinks(missing), [], '404 marks no link')\n})\n\ntest('the route table falls back to the not-found page', async t => {\n    t.equal(pageFor('/nope'), NotFoundPage, 'unknown route is not found')\n    t.equal(pageFor('/'), IndexPage, 'index route is the index page')\n    t.notEqual(pageFor('/list'), NotFoundPage, 'list is a known route')\n})\n\ntest('the index page takes heading and label as arguments', async t => {\n    const nasty = '<i>&</i>'\n    const out = String(IndexPage(State(), { heading: nasty, label: nasty }))\n    t.ok(!out.includes(nasty), 'arguments are escaped')\n    t.ok(out.includes('&lt;i&gt;&amp;&lt;/i&gt;'), 'escaped once')\n})\n\ntest('the counter host on the index route has no start attribute', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const page = await (await app.request('/example-hydration/')).text()\n    const open = page.match(/<hydra-counter\\b[^>]*>/)?.[0] ?? ''\n    t.ok(open, 'the counter host is rendered')\n    t.ok(!/\\sstart=/.test(open), 'no start attribute on the host')\n    t.ok(/\\scount=/.test(open), 'the count prop is serialized')\n})\nimport { test } from '@substrate-system/tapzero'\nimport { createServer, type ViteDevServer } from 'vite'\nimport * as path from 'path'\n\n// Drives the hydration example's Vite dev server (Hono inside Vite)\n// over HTTP. See `npm run test:hydration-dev`.\n\nconst MARKER = '<!--microtags:main-->'\nlet server:ViteDevServer\nlet base:string\n\nfunction hostHasChildren (page:string, tag:string):boolean {\n    const re = new RegExp(`<${tag}\\\\b[^>]*>([\\\\s\\\\S]*?)</${tag}>`)\n    const inner = page.match(re)?.[1] ?? ''\n    return /<[a-z]/i.test(inner)\n}\n\nfunction count (haystack:string, needle:string):number {\n    return haystack.split(needle).length - 1\n}\n\ntest('start the dev server', async t => {\n    server = await createServer({\n        configFile: path.resolve('example-hydration/vite.config.ts'),\n        logLevel: 'silent',\n        server: { port: 0, open: false, host: '127.0.0.1' },\n    })\n    await server.listen()\n    base = server.resolvedUrls!.local[0].replace(/\\/$/, '')\n    t.ok(base, 'server is listening')\n})\n\ntest('dev index is the assembled page with one vite client', async t => {\n    const res = await fetch(base + '/example-hydration/')\n    const page = await res.text()\n\n    t.equal(res.status, 200, 'status is 200')\n    t.ok(\n        (res.headers.get('content-type') ?? '').startsWith('text/html'),\n        'content type is text/html'\n    )\n    t.ok(!page.includes(MARKER), 'marker is replaced')\n    t.equal(count(page, '/@vite/client'), 1, 'vite client inserted once')\n    t.ok(hostHasChildren(page, 'hydra-counter'),\n        'server-side counter render ran')\n    t.ok(hostHasChildren(page, 'hydra-badge'),\n        'server-side badge render ran')\n})\n\ntest('dev sub-routes are assembled with one vite client', async t => {\n    for (const route of ['list', 'notice']) {\n        const res = await fetch(base + '/example-hydration/' + route)\n        const page = await res.text()\n        t.equal(res.status, 200, `${route} status is 200`)\n        t.ok(!page.includes(MARKER), `${route} marker is replaced`)\n        t.equal(count(page, '/@vite/client'), 1,\n            `${route} vite client inserted once`)\n    }\n})\n\ntest('the raw scaffold is never served', async t => {\n    const res = await fetch(base + '/example-hydration/index.html')\n    const page = await res.text()\n    t.ok(!page.includes(MARKER), 'index.html does not return the marker')\n})\n\ntest('the browser module has the counter render stripped', async t => {\n    const res = await fetch(\n        base + '/example-hydration/components/counter.ts'\n    )\n    const code = await res.text()\n    t.equal(res.status, 200, 'module is served')\n    t.ok(!code.includes('.render('), 'render link is stripped')\n})\n\ntest('stop the dev server', async t => {\n    await server.close()\n    t.ok(true, 'closed')\n})\nimport { mount } from 'microtags/htm'\nimport { Counter } from '../components/counter.js'\nimport { Badge } from '../components/badge.js'\nimport { Notice } from '../components/notice.js'\nimport { Layout } from '../pages/layout.js'\nimport { pageFor } from '../pages/routes.js'\nimport { State, STATE_ID } from '../state.js'\nimport { reveal } from './util.js'\n\n// wait for components to be defined before showing them\nreveal([Counter.TAG, Badge.TAG, Notice.TAG], 2000)\n\nconst list = document.querySelector('#assertion-results')\n\nassert(\n    'Counter.render is removed from client bundle',\n    Counter.render === undefined,\n    list\n)\nassert(\n    'Notice.render is a function (kept)',\n    typeof Notice.render === 'function',\n    list\n)\nassert(\n    'Badge.render is a function (kept)',\n    typeof Badge.render === 'function',\n    list\n)\n\n// start from the state the server rendered; malformed JSON throws\nconst payload = document.getElementById(STATE_ID)?.textContent\nconst state = State(payload ? JSON.parse(payload) : {})\nconst root = document.getElementById('root')\nif (!root) throw new Error('no #root element')\nmount(root, Layout(state, pageFor(state.route())(state)))\n\nfunction assert (\n    name:string,\n    pass:boolean,\n    list:Element|null\n):void {\n    if (!list) throw new Error('not list')\n    const li = document.createElement('li')\n    li.textContent = `${pass ? 'PASS' : 'FAIL'}: ${name}`\n    li.style.color = pass ? 'green' : 'red'\n    list.appendChild(li)\n}\n89:    \"start:hydration\": \"npm run build:node && vite --config example-hydration/vite.config.ts --open /example-hydration/\",\n91:    \"typecheck:hydration\": \"tsc -p example-hydration/server/tsconfig.json --listFiles false\",\n92:    \"ssr:hydration\": \"esbuild ./example-hydration/server/ssr.ts --bundle --platform=node --format=cjs --loader:.css=empty --define:import.meta.env='{\\\"DEV\\\":false,\\\"PROD\\\":true,\\\"SSR\\\":true,\\\"MODE\\\":\\\"production\\\"}' | node -\",\n94:    \"toc:hydration\": \"markdown-toc --maxdepth 3 -i example-hydration/README.md\",\n96:    \"version\": \"npm run toc && npm run toc:hydration && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && npm run inject-size && git add CHANGELOG.md README.md\",\n99:    \"test:hydration\": \"npm run build:hydration && npx esbuild ./test/hydration.ts --bundle --format=esm --platform=node --packages=external --loader:.css=empty | node --input-type=module && npx esbuild ./test/hydration-listen.ts --bundle --format=esm --platform=node --packages=external | node --input-type=module\",\n100:    \"test:hydration-dev\": \"npm run build:node && npx esbuild ./test/hydration-dev.ts --bundle --format=cjs --platform=node --packages=external | node\",\n101:    \"build:hydration\": \"npm run build:node && vite build --config example-hydration/vite.config.ts && vite build --ssr --config example-hydration/vite.config.ts\",\n102:    \"serve:hydration\": \"node example-hydration/build/server/listen.js\",\n104:    \"gate\": \"rm -rf example-hydration/build && npm run lint && npm run build && npm run typecheck && npm run size && npm test && npm run test:ssr && npm run test:build && npm run test:plugins && npm run test:cli && npm run test:hydration && npm run test:hydration-dev\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"7208cf7e-7e1e-427b-a63d-adbbbefaf5e7","uuid":"4114872a-a9f5-4bdd-b7ad-c90e5840965d","timestamp":"2026-10-15T04:23:54.282Z","tool_use_result":{"stdout":"import { test } from '@substrate-system/tapzero'\nimport * as fs from 'fs'\nimport * as path from 'path'\nimport type {\n    createApp as CreateApp\n} from '../example-hydration/server/app.js'\nimport { pathToFileURL } from 'url'\nimport type { Serialized } from 'microtags'\nimport { assemble } from '../example-hydration/server/scaffold.js'\nimport {\n    State,\n    serialize,\n    type AppState,\n} from '../example-hydration/state.js'\nimport {\n    pageFor,\n    IndexPage,\n    NotFoundPage,\n} from '../example-hydration/pages/routes.js'\n\n// the built app, from `npm run build:hydration`; loaded at runtime so\n// the bundler leaves the build output alone\nconst builtApp = pathToFileURL(\n    path.resolve('example-hydration/build/server/app.js')\n).href\nconst createApp:typeof CreateApp = (await import(builtApp)).createApp\n\n// Node request tests for the hydration example's Hono app. They go\n// through `app.request()`, so no port is bound. See\n// `npm run test:hydration`, which builds first.\n\nconst scaffold = fs.readFileSync(\n    path.resolve('example-hydration/index.html'),\n    'utf8'\n)\nconst MARKER = '<!--microtags:main-->'\n\nfunction hostHasChildren (page:string, tag:string):boolean {\n    const re = new RegExp(`<${tag}\\\\b[^>]*>([\\\\s\\\\S]*?)</${tag}>`)\n    const inner = page.match(re)?.[1] ?? ''\n    return /<[a-z]/i.test(inner)\n}\n\ntest('GET /example-hydration/ returns a complete html page', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const res = await app.request('/example-hydration/')\n    const page = await res.text()\n\n    t.equal(res.status, 200, 'status is 200')\n    t.ok(\n        (res.headers.get('content-type') ?? '').startsWith('text/html'),\n        'content type is text/html'\n    )\n    t.ok(!page.includes(MARKER), 'the outlet marker is replaced')\n    t.ok(hostHasChildren(page, 'hydra-counter'), 'counter host has children')\n    t.ok(hostHasChildren(page, 'hydra-badge'), 'badge host has children')\n    t.ok(/^<!DOCTYPE html>/i.test(page.trim()), 'scaffold owns the doctype')\n})\n\ntest('body text with special characters is escaped exactly once', async t => {\n    const nasty = '<b>\"Tom\" & \\'Jerry\\'</b> $& $1'\n    const app = createApp({\n        loadScaffold: () => scaffold,\n        index: { heading: nasty, label: nasty },\n    })\n    const page = await (await app.request('/example-hydration/')).text()\n    const escaped = '&lt;b&gt;&quot;Tom&quot; &amp; &#39;Jerry&#39;' +\n        '&lt;/b&gt; $&amp; $1'\n\n    t.ok(!page.includes(nasty), 'raw markup does not reach the page')\n    t.ok(page.includes(escaped), 'text is escaped and `$&` is literal')\n    t.ok(!page.includes('&amp;amp;'), 'nothing is escaped twice')\n    t.ok(!page.includes(MARKER), 'marker is not re-inserted by `$&`')\n})\n\ntest('a scaffold without exactly one marker fails assembly', async t => {\n    const none = scaffold.replace(MARKER, '')\n    const two = scaffold.replace(MARKER, MARKER + MARKER)\n\n    for (const [name, bad] of [['zero', none], ['two', two]]) {\n        const app = createApp({ loadScaffold: () => bad })\n        const res = await app.request('/example-hydration/')\n        const page = await res.text()\n        t.equal(res.status, 500, `${name} markers is a server error`)\n        t.ok(!page.includes('<main'), `${name} markers returns no page`)\n    }\n})\n\ntest('the scaffold hides the page until JS reveals it', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const page = await (await app.request('/example-hydration/')).text()\n    const htmlTag = page.match(/<html\\b[^>]*>/)?.[0] ?? ''\n    const head = page.match(/<head>([\\s\\S]*?)<\\/head>/)?.[1] ?? ''\n\n    t.ok(\n        /\\bclass=\"[^\"]*\\breduce-fouce\\b/.test(htmlTag),\n        'root html element starts with the reduce-fouce class'\n    )\n    t.ok(\n        /<noscript>[\\s\\S]*reduce-fouce[\\s\\S]*<\\/noscript>/.test(head),\n        'head has a noscript fallback that un-hides the page'\n    )\n})\n\nfunction isHtml (res:Response):boolean {\n    return (res.headers.get('content-type') ?? '').startsWith('text/html')\n}\n\ntest('GET /example-hydration/list renders several badges', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const res = await app.request('/example-hydration/list')\n    const page = await res.text()\n\n    t.equal(res.status, 200, 'status is 200')\n    t.ok(isHtml(res), 'content type is text/html')\n    t.ok(!page.includes(MARKER), 'the outlet marker is replaced')\n    const badges = page.match(/<hydra-badge\\b[^>]*>[\\s\\S]*?<\\/hydra-badge>/g)\n    t.ok((badges ?? []).length > 1, 'several badge hosts')\n    t.ok(\n        (badges ?? []).every(b => hostHasChildren(b, 'hydra-badge')),\n        'every badge host has children'\n    )\n})\n\ntest('list response has one keyed item per label in state', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const res = await app.request('/example-hydration/list')\n    const page = await res.text()\n    const json = page.match(\n        /<script[^>]*id=\"microtags-state\"[^>]*>([\\s\\S]*?)<\\/script>/\n    )?.[1]\n    const labels:string[] = JSON.parse(json ?? '{}').labels\n    t.ok(labels.length > 1, 'state has several labels')\n    const keys = [...page.matchAll(/<li\\b[^>]*\\bkey=\"([^\"]*)\"/g)]\n        .map(m => m[1])\n    t.deepEqual(keys, labels, 'one keyed item per label, in order')\n})\n\ntest('GET /example-hydration/notice has the button, no notice', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const res = await app.request('/example-hydration/notice')\n    const page = await res.text()\n\n    t.equal(res.status, 200, 'status is 200')\n    t.ok(isHtml(res), 'content type is text/html')\n    t.ok(!page.includes(MARKER), 'the outlet marker is replaced')\n    t.ok(/<button\\b[^>]*\\bid=\"show-notice\"/.test(page), 'has the button')\n    t.ok(!/<hydra-notice\\b/.test(page), 'no notice host while closed')\n    const json = page.match(\n        /<script\\b[^>]*id=\"microtags-state\"[^>]*>([\\s\\S]*?)<\\/script>/\n    )?.[1] ?? '{}'\n    t.equal(JSON.parse(json).noticeOpen, false, 'state says it is closed')\n})\n\ntest('an unknown path returns the scaffold with a 404', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const res = await app.request('/example-hydration/nope')\n    const page = await res.text()\n\n    t.equal(res.status, 404, 'status is 404')\n    t.ok(isHtml(res), 'content type is text/html')\n    t.ok(/<nav\\b/.test(page), 'nav is present')\n    t.ok(/<main\\b/.test(page), 'main is present')\n    t.ok(!page.includes(MARKER), 'the outlet marker is replaced')\n})\n\ntest('the bare prefix redirects to the canonical index', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const res = await app.request('/example-hydration')\n\n    t.ok(res.status >= 300 && res.status < 400, 'status is a redirect')\n    t.equal(\n        new URL(res.headers.get('location') ?? '', 'http://x').pathname,\n        '/example-hydration/',\n        'location is the index'\n    )\n})\n\nconst STATE_MARKER = '<!--microtags:state-->'\nconst STATE_RE =\n    /<script\\b[^>]*\\bid=\"microtags-state\"[^>]*>([\\s\\S]*?)<\\/script>/g\n\nfunction stateScripts (page:string):string[] {\n    return [...page.matchAll(STATE_RE)].map(m => m[1])\n}\n\nfunction payload (page:string):Serialized<AppState> {\n    return JSON.parse(stateScripts(page)[0])\n}\n\ntest('every route carries one state script before the module', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const routes = ['/', '/index.html', '/list', '/notice', '/nope']\n    for (const route of routes) {\n        const page = await (\n            await app.request('/example-hydration' + route)\n        ).text()\n        const scripts = stateScripts(page)\n        t.equal(scripts.length, 1, `${route} has one state script`)\n        t.ok(!page.includes(STATE_MARKER), `${route} state marker replaced`)\n        const stateAt = page.search(STATE_RE)\n        const moduleAt = page.search(/<script\\b[^>]*\\btype=\"module\"/)\n        t.ok(stateAt > -1 && stateAt < moduleAt,\n            `${route} state comes before the module script`)\n        const parsed = JSON.parse(scripts[0])\n        t.deepEqual(serialize(State(parsed)), parsed,\n            `${route} payload round-trips through State`)\n    }\n})\n\ntest('route in the payload is the path without the prefix', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const cases:[string, string][] = [\n        ['/', '/'],\n        ['/list', '/list'],\n        ['/notice', '/notice'],\n        ['/nope/deeper', '/nope/deeper'],\n    ]\n    for (const [path, route] of cases) {\n        const page = await (\n            await app.request('/example-hydration' + path)\n        ).text()\n        t.equal(payload(page).route, route, `${path} route is ${route}`)\n    }\n})\n\ntest('a valid count query parameter is reflected in state', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const page = await (\n        await app.request('/example-hydration/?count=12')\n    ).text()\n    t.equal(payload(page).count, 12, 'count is 12')\n})\n\ntest('an invalid count falls back to the default', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    for (const bad of ['1.5', 'Infinity', 'NaN', 'abc', '', '1e400']) {\n        const page = await (\n            await app.request('/example-hydration/?count=' +\n                encodeURIComponent(bad))\n        ).text()\n        t.equal(payload(page).count, 5, `count=${bad} falls back to 5`)\n    }\n})\n\ntest('a script closing tag in the path cannot escape the payload', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const evil = '/</script><script>alert(1)</script>'\n    const page = await (\n        await app.request('/example-hydration' + evil)\n    ).text()\n    const scripts = stateScripts(page)\n    t.equal(scripts.length, 1, 'one state script')\n    t.equal(JSON.parse(scripts[0]).route, evil,\n        'the payload parses and keeps the path')\n})\n\ntest('assemble requires exactly one of each marker', t => {\n    const cases:[string, string][] = [\n        ['no page marker', scaffold.replace(MARKER, '')],\n        ['two page markers', scaffold.replace(MARKER, MARKER + MARKER)],\n        ['no state marker', scaffold.replace(STATE_MARKER, '')],\n        ['two state markers',\n            scaffold.replace(STATE_MARKER, STATE_MARKER + STATE_MARKER)],\n    ]\n    for (const [name, bad] of cases) {\n        t.throws(() => assemble(bad, '', ''), name + ' throws')\n    }\n    t.ok(assemble(scaffold, '', ''), 'a good scaffold assembles')\n})\n\ntest('State fills defaults for missing keys', t => {\n    const full = serialize(State())\n    t.deepEqual(\n        Object.keys(full).sort(),\n        ['count', 'labels', 'noticeOpen', 'route'],\n        'every key is present'\n    )\n    const partial = serialize(State({ count: 9 }))\n    t.equal(partial.count, 9, 'given key is kept')\n    t.deepEqual(\n        { ...partial, count: full.count },\n        full,\n        'missing keys get defaults'\n    )\n})\n\ntest('each static mutator changes only its own signal', t => {\n    type Case = [\n        keyof AppState,\n        (s:AppState) => void,\n        Partial<Serialized<AppState>>?\n    ]\n    const cases:Case[] = [\n        ['count', s => State.increase(s)],\n        ['count', s => State.decrease(s)],\n        ['noticeOpen', s => State.openNotice(s), { noticeOpen: false }],\n        ['noticeOpen', s => State.dismissNotice(s), { noticeOpen: true }],\n        ['labels', s => State.addLabel(s, 'delta')],\n        ['labels', s => State.removeLabel(s, 'alpha')],\n    ]\n    for (const [key, mutate, input] of cases) {\n        const s = State(input)\n        const before = serialize(s)\n        mutate(s)\n        const after = serialize(s)\n        t.notDeepEqual(after[key], before[key], `${key} changed`)\n        t.deepEqual({ ...after, [key]: before[key] }, before,\n            `only ${key} changed`)\n    }\n})\n\nconst ROOT_RE = new RegExp('<div\\\\b[^>]*\\\\bid=\"root\"[^>]*>' +\n    '([\\\\s\\\\S]*?)</div>\\\\s*<section\\\\b[^>]*class=\"assertions\"')\n\ntest('the root element holds the navigation and the page', async t => {\n    t.ok(!/<nav\\b/.test(scaffold), 'the scaffold file has no nav')\n    const app = createApp({ loadScaffold: () => scaffold })\n    for (const route of ['/', '/list', '/notice', '/nope']) {\n        const page = await (\n            await app.request('/example-hydration' + route)\n        ).text()\n        const root = page.match(ROOT_RE)?.[1] ?? ''\n        t.ok(/<nav\\b/.test(root), `${route} root has the nav`)\n        t.ok(/<main\\b/.test(root), `${route} root has main`)\n        t.equal((page.match(/<nav\\b/g) ?? []).length, 1,\n            `${route} has one nav`)\n    }\n})\n\nfunction currentLinks (page:string):string[] {\n    return [...page.matchAll(/<a\\b[^>]*>/g)]\n        .map(m => m[0])\n        .filter(a => /\\baria-current=/.test(a))\n        .map(a => a.match(/\\bhref=\"([^\"]*)\"/)?.[1] ?? '')\n}\n\ntest('the link for the current route carries aria-current', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const cases:[string, string][] = [\n        ['/', '/example-hydration/'],\n        ['/list', '/example-hydration/list'],\n        ['/notice', '/example-hydration/notice'],\n    ]\n    for (const [route, href] of cases) {\n        const page = await (\n            await app.request('/example-hydration' + route)\n        ).text()\n        t.deepEqual(currentLinks(page), [href], `${route} marks ${href}`)\n    }\n    const missing = await (\n        await app.request('/example-hydration/nope')\n    ).text()\n    t.deepEqual(currentLinks(missing), [], '404 marks no link')\n})\n\ntest('the route table falls back to the not-found page', async t => {\n    t.equal(pageFor('/nope'), NotFoundPage, 'unknown route is not found')\n    t.equal(pageFor('/'), IndexPage, 'index route is the index page')\n    t.notEqual(pageFor('/list'), NotFoundPage, 'list is a known route')\n})\n\ntest('the index page takes heading and label as arguments', async t => {\n    const nasty = '<i>&</i>'\n    const out = String(IndexPage(State(), { heading: nasty, label: nasty }))\n    t.ok(!out.includes(nasty), 'arguments are escaped')\n    t.ok(out.includes('&lt;i&gt;&amp;&lt;/i&gt;'), 'escaped once')\n})\n\ntest('the counter host on the index route has no start attribute', async t => {\n    const app = createApp({ loadScaffold: () => scaffold })\n    const page = await (await app.request('/example-hydration/')).text()\n    const open = page.match(/<hydra-counter\\b[^>]*>/)?.[0] ?? ''\n    t.ok(open, 'the counter host is rendered')\n    t.ok(!/\\sstart=/.test(open), 'no start attribute on the host')\n    t.ok(/\\scount=/.test(open), 'the count prop is serialized')\n})\nimport { test } from '@substrate-system/tapzero'\nimport { createServer, type ViteDevServer } from 'vite'\nimport * as path from 'path'\n\n// Drives the hydration example's Vite dev server (Hono inside Vite)\n// over HTTP. See `npm run test:hydration-dev`.\n\nconst MARKER = '<!--microtags:main-->'\nlet server:ViteDevServer\nlet base:string\n\nfunction hostHasChildren (page:string, tag:string):boolean {\n    const re = new RegExp(`<${tag}\\\\b[^>]*>([\\\\s\\\\S]*?)</${tag}>`)\n    const inner = page.match(re)?.[1] ?? ''\n    return /<[a-z]/i.test(inner)\n}\n\nfunction count (haystack:string, needle:string):number {\n    return haystack.split(needle).length - 1\n}\n\ntest('start the dev server', async t => {\n    server = await createServer({\n        configFile: path.resolve('example-hydration/vite.config.ts'),\n        logLevel: 'silent',\n        server: { port: 0, open: false, host: '127.0.0.1' },\n    })\n    await server.listen()\n    base = server.resolvedUrls!.local[0].replace(/\\/$/, '')\n    t.ok(base, 'server is listening')\n})\n\ntest('dev index is the assembled page with one vite client', async t => {\n    const res = await fetch(base + '/example-hydration/')\n    const page = await res.text()\n\n    t.equal(res.status, 200, 'status is 200')\n    t.ok(\n        (res.headers.get('content-type') ?? '').startsWith('text/html'),\n        'content type is text/html'\n    )\n    t.ok(!page.includes(MARKER), 'marker is replaced')\n    t.equal(count(page, '/@vite/client'), 1, 'vite client inserted once')\n    t.ok(hostHasChildren(page, 'hydra-counter'),\n        'server-side counter render ran')\n    t.ok(hostHasChildren(page, 'hydra-badge'),\n        'server-side badge render ran')\n})\n\ntest('dev sub-routes are assembled with one vite client', async t => {\n    for (const route of ['list', 'notice']) {\n        const res = await fetch(base + '/example-hydration/' + route)\n        const page = await res.text()\n        t.equal(res.status, 200, `${route} status is 200`)\n        t.ok(!page.includes(MARKER), `${route} marker is replaced`)\n        t.equal(count(page, '/@vite/client'), 1,\n            `${route} vite client inserted once`)\n    }\n})\n\ntest('the raw scaffold is never served', async t => {\n    const res = await fetch(base + '/example-hydration/index.html')\n    const page = await res.text()\n    t.ok(!page.includes(MARKER), 'index.html does not return the marker')\n})\n\ntest('the browser module has the counter render stripped', async t => {\n    const res = await fetch(\n        base + '/example-hydration/components/counter.ts'\n    )\n    const code = await res.text()\n    t.equal(res.status, 200, 'module is served')\n    t.ok(!code.includes('.render('), 'render link is stripped')\n})\n\ntest('stop the dev server', async t => {\n    await server.close()\n    t.ok(true, 'closed')\n})\nimport { mount } from 'microtags/htm'\nimport { Counter } from '../components/counter.js'\nimport { Badge } from '../components/badge.js'\nimport { Notice } from '../components/notice.js'\nimport { Layout } from '../pages/layout.js'\nimport { pageFor } from '../pages/routes.js'\nimport { State, STATE_ID } from '../state.js'\nimport { reveal } from './util.js'\n\n// wait for components to be defined before showing them\nreveal([Counter.TAG, Badge.TAG, Notice.TAG], 2000)\n\nconst list = document.querySelector('#assertion-results')\n\nassert(\n    'Counter.render is removed from client bundle',\n    Counter.render === undefined,\n    list\n)\nassert(\n    'Notice.render is a function (kept)',\n    typeof Notice.render === 'function',\n    list\n)\nassert(\n    'Badge.render is a function (kept)',\n    typeof Badge.render === 'function',\n    list\n)\n\n// start from the state the server rendered; malformed JSON throws\nconst payload = document.getElementById(STATE_ID)?.textContent\nconst state = State(payload ? JSON.parse(payload) : {})\nconst root = document.getElementById('root')\nif (!root) throw new Error('no #root element')\nmount(root, Layout(state, pageFor(state.route())(state)))\n\nfunction assert (\n    name:string,\n    pass:boolean,\n    list:Element|null\n):void {\n    if (!list) throw new Error('not list')\n    const li = document.createElement('li')\n    li.textContent = `${pass ? 'PASS' : 'FAIL'}: ${name}`\n    li.style.color = pass ? 'green' : 'red'\n    list.appendChild(li)\n}\n89:    \"start:hydration\": \"npm run build:node && vite --config example-hydration/vite.config.ts --open /example-hydration/\",\n91:    \"typecheck:hydration\": \"tsc -p example-hydration/server/tsconfig.json --listFiles false\",\n92:    \"ssr:hydration\": \"esbuild ./example-hydration/server/ssr.ts --bundle --platform=node --format=cjs --loader:.css=empty --define:import.meta.env='{\\\"DEV\\\":false,\\\"PROD\\\":true,\\\"SSR\\\":true,\\\"MODE\\\":\\\"production\\\"}' | node -\",\n94:    \"toc:hydration\": \"markdown-toc --maxdepth 3 -i example-hydration/README.md\",\n96:    \"version\": \"npm run toc && npm run toc:hydration && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && npm run inject-size && git add CHANGELOG.md README.md\",\n99:    \"test:hydration\": \"npm run build:hydration && npx esbuild ./test/hydration.ts --bundle --format=esm --platform=node --packages=external --loader:.css=empty | node --input-type=module && npx esbuild ./test/hydration-listen.ts --bundle --format=esm --platform=node --packages=external | node --input-type=module\",\n100:    \"test:hydration-dev\": \"npm run build:node && npx esbuild ./test/hydration-dev.ts --bundle --format=cjs --platform=node --packages=external | node\",\n101:    \"build:hydration\": \"npm run build:node && vite build --config example-hydration/vite.config.ts && vite build --ssr --config example-hydration/vite.config.ts\",\n102:    \"serve:hydration\": \"node example-hydration/build/server/listen.js\",\n104:    \"gate\": \"rm -rf example-hydration/build && npm run lint && npm run build && npm run typecheck && npm run size && npm test && npm run test:ssr && npm run test:build && npm run test:plugins && npm run test:cli && npm run test:hydration && npm run test:hydration-dev\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01JWZ7w2jkJV6kanGv5WJv8u","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
