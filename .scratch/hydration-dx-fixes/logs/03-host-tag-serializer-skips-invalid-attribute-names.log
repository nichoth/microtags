lation-check.md\n10-readme-what-escaping-does-not-cover.md\n11-adr-008-note-with-measurements.md\n253:### Server-render code out of core's define path (finding 8, goal 5)\n254-\n255-This is the one architectural change, recorded as ADR-009 (\"Server\n256-render support loaded through the render link\"). It amends ADR-005,\n257-whose consequences claim that a browser bundle holds hydration code\n258-only.\n259-\n260-- Today `withProps` computes a serializer for every prop, and `setup`\n261-  installs the component's `render` static, which closes over the\n262-  host-tag builder, the serializers and attribute escaping. All of it\n263-  is reachable from `define()`, so the bundler cannot drop it.\n264-- After the change, the host-tag builder, the serializers and attribute\n265-  escaping live in a separate server render support module. Core\n266-  records prop metadata (kind and coercer) and the render function,\n267-  and installs on the class a minimal `render` static that delegates to\n268-  the support module once the support module has registered itself.\n269-  Calling `render` before registration throws an error that names the\n270-  module to import.\n271-- The support module is registered by the server templater, by the\n272-  browser templater when it creates a host, and by the `microtags/build`\n273-  transform. The transform injects an import of the support module into\n274-  any client module where it keeps a render link. Code that calls a\n275-  component's `render` static directly, without the templater, imports\n276-  the support subpath once. This is a breaking change for that path. It\n277-  is acceptable at 0.0.x and is documented in the README.\n278-- The exact registration mechanism (a side-effect subpath, a setter\nimport type { StandardSchemaV1 } from '@standard-schema/spec'\nimport type { Markup } from './htm.js'\nimport type { Markup as BrowserMarkup } from './htm.browser.js'\nimport type {\n    PropDef,\n    PropType,\n    PropertyOnlyProp,\n    SetupContext,\n    Coercer,\n    RefDef,\n    SingleRefDef,\n    MultipleRefDef,\n    RefsMap,\n    ContextToken,\n    ContextsMap,\n} from './types.js'\nimport {\n    coerceNumber,\n    coerceString,\n    coerceBoolean,\n    coerceJson,\n} from './util.js'\nimport { factory } from './factory.js'\nexport type PropKind = 'prop-only' | 'schema' | 'coercer'\n\nexport interface PropMeta {\n    kind:PropKind\n    coercer:Coercer<unknown>\n    serialize:(value:unknown) => string | null\n}\n\nconst _esc:Record<string, string> = {\n    '&': '&amp;',\n    '\"': '&quot;',\n    \"'\": '&#39;',\n    '<': '&lt;',\n    '>': '&gt;',\n}\nfunction _escAttr (s:string):string {\n    return s.replace(/[&\"'<>]/g, c => _esc[c])\n}\n\nfunction _sNull ():null { return null }\nfunction _sStr (v:unknown):string | null {\n    return v == null ? null : String(v)\n}\nfunction _sBool (v:unknown):string | null {\n    return v === true ? '' : null\n}\nfunction _sJson (v:unknown):string | null {\n    return v == null ? null : JSON.stringify(v)\n}\n\nfunction _serializerFor (\n    c:Coercer<unknown>, k:PropKind\n):(v:unknown) => string | null {\n    if (k === 'prop-only') return _sNull\n    if (k === 'schema') return _sStr\n    if (c === coerceBoolean) return _sBool\n    if (c === coerceJson) return _sJson\n    return _sStr\n}\n\nfunction _renderHost (\n    tag:string, metas:Record<string, PropMeta>,\n    props:Record<string, unknown>,\n    extra:Record<string, string> | undefined,\n    inner:string\n):string {\n    let a = ''\n    for (const [k, m] of Object.entries(metas)) {\n        if (!(k in props)) continue\n        const s = m.serialize(props[k])\n        if (s === null) continue\n        a += s === '' ? ` ${k}` : ` ${k}=\"${_escAttr(s)}\"`\n    }\n    if (extra) {\n        for (const [k, v] of Object.entries(extra)) {\n            a += v === '' ? ` ${k}` : ` ${k}=\"${_escAttr(v)}\"`\n        }\n    }\n    return `<${tag}${a}>${inner}</${tag}>`\n}\n\n/** The DSL object passed to the withProps callback. */\nexport type PropDSL = {\n    number():Coercer<number>\n    string():Coercer<string>\n    boolean():Coercer<boolean>\n    json<T>():Coercer<T | undefined>\n    schema<T>(validator:StandardSchemaV1<unknown, T>):StandardSchemaV1<unknown, T>\n    prop<T>(initial:T):PropertyOnlyProp<T>\n}\n\nexport const propDSL:PropDSL = {\n    number: () => coerceNumber,\n    string: () => coerceString,\n    boolean: () => coerceBoolean,\n    json: <T>() => coerceJson as Coercer<T | undefined>,\n    schema: <T>(v:StandardSchemaV1<unknown, T>) => v,\n    prop: <T>(initial:T):PropertyOnlyProp<T> => (\n        { _microtag: 'prop', initial }\n    ),\n}\n\n/**\n * DSL object passed to the withRefs callback.\n * Call `r.one()` for a single element or `r.all()` for multiple. Pass a\n * CSS selector to query by it, or omit it to match `[data-ref=\"<key>\"]`.\n *\n * Element typing:\n * - `r.one()` defaults to `HTMLElement`.\n * - `r.one<T>()` sets the type and keeps the `[data-ref]` selector.\n * - `r.one('button')` infers the type from the tag AND queries by that\n *   tag, exactly like `document.querySelector('button')`.\n */\nexport type RefsDSL = {\n    one<K extends keyof HTMLElementTagNameMap>(\n        selector:K\n    ):SingleRefDef<HTMLElementTagNameMap[K]>","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01DrUyKXqAPxhh9rSKHanNNW","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
