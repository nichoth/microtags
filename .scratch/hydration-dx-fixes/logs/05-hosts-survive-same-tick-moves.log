lback () {}\n\n        disconnectedCallback () {\n            // Snapshot and clear BEFORE running so re-entrant calls are safe\n            // and the array is always empty after this returns (or throws).\n            const fns = this._cleanups\n            this._cleanups = []\n            runAll(fns)\n        }\n    }\n\n    // One accessor per prop. A function value is taken to be a signal\n    // and bound; anything else unbinds and writes the prop.\n    for (const name of Object.keys(propDefs)) {\n        Object.defineProperty(MicrotagElement.prototype, name, {\n            get (this:MicrotagElement) { return this._props[name]() },\n            set (this:MicrotagElement, v:unknown) {\n                if (typeof v === 'function') {\n                    this._bound[name](v as Signal<unknown>)\n                } else {\n                    this._bound[name](undefined)\n                    this._props[name](v)\n                }\n            },\n            configurable: true,\n        })\n    }\n\n    return MicrotagElement\n}\n// .size-limit.js\nexport default [\n    {\n        name: 'microtags',\n        path: 'dist/index.min.js',\n        limit: '4.2 kB',\n    },\n    {\n        name: 'microtags/htm',\n        path: 'dist/htm.min.js',\n        limit: '5 kB',\n    },\n    {\n        name: 'microtags/htm (browser)',\n        path: 'dist/htm.browser.min.js',\n        limit: '4.6 kB',\n    },\n]\n68:**Setup**:\n73:**Setup context**:\n183:test('factory: disconnectedCallback runs all registered cleanups', t => {\n184:    let cleanupCount = 0\n189:            ctx.onCleanup(() => cleanupCount++)\n190:            ctx.onCleanup(() => cleanupCount++)\n193:    customElements.define('test-factory-cleanup', El)\n194:    const el = document.createElement('test-factory-cleanup')\n196:    t.equal(cleanupCount, 0, 'cleanups not run before disconnect')\n198:    t.equal(cleanupCount, 2, 'both cleanups ran on disconnect')\n201:test('factory: effects are disposed on disconnect', t =