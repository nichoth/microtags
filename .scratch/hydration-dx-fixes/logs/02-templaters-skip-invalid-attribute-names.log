s'\n10:import { render, renderList } from '../src/render.js'\n11:import { html, raw } from '../src/htm.js'\n12:import {\n17:import { reveal } from '../example-hydration/client/util.js'\n18:import { Counter } from '../example-hydration/components/counter.js'\n19:import { Badge } from '../example-hydration/components/badge.js'\n20:import { Notice } from '../example-hydration/components/notice.js'\n21:import { NoticePage } from '../example-hydration/pages/notice.js'\n23:import { mount as pageMount } from 'microtags/htm'\n24:import { State } from '../example-hydration/state.js'\n26:test('placeholder test', t => {\n30:test('peek reads a signal without subscribing', t => {\n46:test('untracked reads do not create subscriptions', t => {\n60:test('peek returns current signal value', t => {\n67:test('untracked restores subscription context', t => {\n87:test('define: registers a working custom element', t => {\n99:test('reactive props: reading, writing, and reacting', t => {\n131:test('factory: creates HTMLElement subclass with no shadow DOM', t => {\n145:test('factory: connectedCallback hydrates props from attributes', t => {\n162:test('factory: attributeChangedCallback updates prop signal', t => {\n183:test('factory: disconnectedCallback runs all registered cleanups', t => {\n201:test('factory: effects are disposed on disconnect', t => {\n225:test('factory: reconnecting re-runs setup with fresh scope', t => {\n248:test('factory: reconnect preserves programmatically-set prop values', t => {\n273:test('factory: cleanup errors: remaining cleanups run, first error re-throws', t => {\n306:test('withProps: p.number() hydrates number from attribute', t => {\n319:test('withProps: p.string() hydrates string from attribute', t => {\n332:test('withProps: p.boolean() coerces attribute presence', t => {\n356:test('withProps: p.json() parses attribute as JSON', t => {\n369:test('withProps: p.schema() accepts a Standard Schema validator', t => {\n395:test('withProps: p.prop() creates a property-only (non-observed) prop', t => {\n422:test('withProps: observed attributes react to attributeChangedCallback', t => {\n443:test('withRefs: r.one resolves single [data-ref] element', t => {\n458:test('withRefs: r.all resolves multiple [data-ref] elements', t => {\n478:test('withRefs: r.all returns empty array when no matches', t => {\n491:test('withRefs: r.one throws when ref element not found', t => {\n506:test('withRefs: r.one(selector) resolves by CSS selector', t => {\n520:test('withRefs: r.one(tag) resolves an element by tag name', t => {\n534:test('withRefs: r.all(selector) resolves multiple by CSS selector', t => {\n552:test('withContexts: context keys appear in ctx.contexts', t => {\n571:test('ctx.on: listener is called and auto-removed on disconnect', t => {\n590:test('ctx.emit: string form dispatches a bubbling CustomEvent with detail', t => {\n618:test('ctx.emit: Event form dispatches as-is; returns false when canceled', t => {\n648:test('ctx.bind: updates DOM property reactively, stops after disconnect', t => {\n670:test('ctx.bind: two-way text input writes user input to signal', t => {\n693:test('ctx.bind: checkbox auto-detects checked/change', t => {\n717:test('ctx.bind: getter one-way derives a property from a signal', t => {\n736:test('ctx.bind: number input auto-detects valueAsNumber/input', t => {\n760:test('ctx.peek: no subscription inside ctx.effect', t => {\n782:test('ctx.consume: returns undefined for unresolved context token', t => {\n801:test('define: setup() registers the custom element', t => {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01BiwQfgtpvrdLtBwymzZ3yC","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
