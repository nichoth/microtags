{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YQbgSgayo5XtWgtGj1nUDh","type":"tool_result","content":"1\timport htm from 'htm'\n2\timport { effect, effectScope, untracked } from './reactivity.js'\n3\timport type { MicrotagElementClass } from './builders.js'\n4\timport type { PropDef } from './types.js'\n5\t\n6\t// Browser build of `microtags/htm`, selected by the `browser` export\n7\t// condition. `html` describes nodes instead of building a string, and\n8\t// `mount` turns that description into DOM with live bindings.\n9\t\n10\tconst _esc:Record<string, string> = {\n11\t    '&': '&amp;',\n12\t    '\"': '&quot;',\n13\t    \"'\": '&#39;',\n14\t    '<': '&lt;',\n15\t    '>': '&gt;',\n16\t}\n17\t\n18\tfunction _escHtml (s:string):string {\n19\t    return s.replace(/[&\"'<>]/g, c => _esc[c])\n20\t}\n21\t\n22\tconst VOID = new Set([\n23\t    'area', 'base', 'br', 'col', 'embed', 'hr',\n24\t    'img', 'input', 'link', 'meta', 'param',\n25\t    'source', 'track', 'wbr',\n26\t])\n27\t\n28\ttype Comp = MicrotagElementClass<Record<string, PropDef>>\n29\ttype VType = string | Comp | ((...a:unknown[]) => unknown)\n30\t\n31\tinterface VNode {\n32\t    t:VType\n33\t    p:Record<string, unknown> | null\n34\t    c:unknown[]\n35\t}\n36\t\n37\t/**\n38\t * Opaque, trusted output of the templater. In the browser it describes\n39\t * nodes for `mount`; `String(m)` still yields static HTML.\n40\t */\n41\texport class Markup {\n42\t    // a node description, or trusted HTML from `raw`\n43\t    readonly _n:VNode | unknown[] | null\n44\t    readonly _h:string | null\n45\t    constructor (n:VNode | unknown[] | null, h:string | null = null) {\n46\t        this._n = n\n47\t        this._h = h\n48\t    }\n49\t\n50\t    toString ():string {\n51\t        return this._h ?? _str(this._n)\n52\t    }\n53\t}\n54\t\n55\texport function raw (s:string):Markup {\n56\t    return new Markup(null, s)\n57\t}\n58\t\n59\tfunction _isMicrotag (t:unknown):t is Comp {\n60\t    return typeof t === 'function' && 'TAG' in t && 'props' in t\n61\t}\n62\t\n63\tfunction _isEvent (k:string, v:unknown):boolean {\n64\t    return k.startsWith('on') && typeof v === 'function'\n65\t}\n66\t\n67\tfunction _read (v:unknown):unknown {\n68\t    return typeof v === 'function' ? untracked(v as () => unknown) : v\n69\t}\n70\t\n71\tfunction _renderLink (type:Comp):Comp['render'] {\n72\t    if (typeof type.render !== 'function') {\n73\t        throw new Error(\n74\t            `microtags: cannot create <${type.TAG}> in the browser: its ` +\n75\t            'render link was stripped. Keep it with ' +\n76\t            '`.render(fn, { client: true })` or the build-time keep list.'\n77\t        )\n78\t    }\n79\t    return type.render\n80\t}\n81\t\n82\t// Split a component's props into declared props and extra attributes.\n83\t// Signals and functions are read once.\n84\tfunction _compArgs (type:Comp, props:Record<string, unknown> | null) {\n85\t    const declared = new Set(type.props as readonly string[])\n86\t    const compProps:Record<string, unknown> = {}\n87\t    const attrs:Record<string, string> = {}\n88\t    for (const [k, v] of Object.entries(props ?? {})) {\n89\t        if (declared.has(k)) {\n90\t            compProps[k] = _read(v)\n91\t        } else if (!_isEvent(k, v)) {\n92\t            const r = _read(v)\n93\t            if (r === true) attrs[k] = ''\n94\t            else if (r !== false && r != null) attrs[k] = String(r)\n95\t        }\n96\t    }\n97\t    return { compProps, attrs }\n98\t}\n99\t\n100\tfunction _str (c:unknown):string {\n101\t    if (c == null || c === false) return ''\n102\t    if (Array.isArray(c)) return c.map(_str).join('')\n103\t    if (c instanceof Markup) return String(c)\n104\t    if (typeof c === 'function') return _str(_read(c))\n105\t    if (typeof c !== 'object' || !('t' in c)) {\n106\t        return _escHtml(String(c))\n107\t    }\n108\t    const { t, p, c: kids } = c as VNode\n109\t    const inner = _str(kids)\n110\t    if (_isMicrotag(t)) {\n111\t        const { compProps, attrs } = _compArgs(t, p)\n112\t        return _renderLink(t)(compProps as any, {\n113\t            children: inner,\n114\t            attrs: Object.keys(attrs).length > 0 ? attrs : undefined,\n115\t        })\n116\t    }\n117\t    if (typeof t !== 'string') return inner\n118\t    let a = ''\n119\t    for (const [k, v] of Object.entries(p ?? {})) {\n120\t        if (_isEvent(k, v)) continue\n121\t        const r = _read(v)\n122\t        if (r === true) a += ` ${k}`\n123\t        else if (r !== false && r != null) {\n124\t            a += ` ${k}=\"${_escHtml(String(r))}\"`\n125\t        }\n126\t    }\n127\t    if (VOID.has(t)) return `<${t}${a}>`\n128\t    return `<${t}${a}>${inner}</${t}>`\n129\t}\n130\t\n131\texport function h (\n132\t    type:VType,\n133\t    props:Record<string, unknown> | null,\n134\t    ...children:unknown[]\n135\t):Markup {\n136\t    return new Markup({ t: type, p: props, c: children })\n137\t}\n138\t\n139\tconst _htm = htm.bind(h)\n140\t\n141\texport function html (\n142\t    strings:TemplateStringsArray,\n143\t    ...values:unknown[]\n144\t):Markup {\n145\t    const result = (_htm as (...a:unknown[]) => unknown)(\n146\t        strings, ...values\n147\t    )\n148\t    if (result instanceof Markup) return result\n149\t    return new Markup(Array.isArray(result) ? result : [result])\n150\t}\n151\t\n152\t// Mounting\n153\t\n154\ttype Off = () => void\n155\t\n156\t// Run DOM work untracked, so hosts connected by it set up their own\n157\t// effects outside any region.\n158\tfunction _dom (fn:() => void):void {\n159\t    untracked(fn)\n160\t}\n161\t\n162\tfunction _setAttr (el:Element, k:string, v:unknown):void {\n163\t    if (v === false || v == null) el.removeAttribute(k)\n164\t    else el.setAttribute(k, v === true ? '' : String(v))\n165\t}\n166\t\n167\tfunction _listen (el:Element, k:string, fn:unknown, offs:Off[]):void {\n168\t    const type = k.slice(2)\n169\t    const handler = fn as EventListener\n170\t    el.addEventListener(type, handler)\n171\t    offs.push(() => el.removeEventListener(type, handler))\n172\t}\n173\t\n174\tfunction _parse (s:string):DocumentFragment {\n175\t    const tpl = document.createElement('template')\n176\t    tpl.innerHTML = s\n177\t    // importNode upgrades defined custom elements synchronously\n178\t    return document.importNode(tpl.content, true)\n179\t}\n180\t\n181\t// Flatten a child value into the items a range holds: node\n182\t// descriptions, regions (functions), parsed raw HTML and text.\n183\tfunction _items (c:unknown, out:unknown[] = []):unknown[] {\n184\t    if (c == null || c === false) return out\n185\t    if (Array.isArray(c)) {\n186\t        for (const x of c) _items(x, out)\n187\t    } else if (c instanceof Markup) {\n188\t        if (c._h !== null) out.push(..._parse(c._h).childNodes)\n189\t        else _items(c._n, out)\n190\t    } else if (\n191\t        typeof c === 'object' && !(c instanceof Node) && 'p' in c &&\n192\t        typeof (c as VNode).t !== 'string' &&\n193\t        !_isMicrotag((c as VNode).t)\n194\t    ) {\n195\t        _items((c as VNode).c, out)\n196\t    } else {\n197\t        out.push(c)\n198\t    }\n199\t    return out\n200\t}\n201\t\n202\tfunction _create (c:unknown, offs:Off[]):Node[] {\n203\t    if (c instanceof Node) return [c]\n204\t    if (typeof c === 'function') return _region(c as () => unknown, offs)\n205\t    if (typeof c !== 'object' || c === null || !('t' in c)) {\n206\t        return [document.createTextNode(String(c))]\n207\t    }\n208\t    const { t, p, c: kids } = c as VNode\n209\t    if (_isMicrotag(t)) return [_createHost(t, p, kids, offs)]\n210\t    const el = document.createElement(t as string)\n211\t    _bindEl(el, p, offs)\n212\t    _morph(el, null, null, kids, offs)\n213\t    return [el]\n214\t}\n215\t\n216\tfunction _bindEl (\n217\t    el:Element,\n218\t    p:Record<string, unknown> | null,\n219\t    offs:Off[]\n220\t):void {\n221\t    for (const [k, v] of Object.entries(p ?? {})) {\n222\t        if (_isEvent(k, v)) {\n223\t            _listen(el, k, v, offs)\n224\t        } else if (typeof v === 'function') {\n225\t            effect(() => _setAttr(el, k, (v as () => unknown)()))\n226\t        } else {\n227\t            _setAttr(el, k, v)\n228\t        }\n229\t    }\n230\t}\n231\t\n232\tfunction _bindHost (\n233\t    host:Element,\n234\t    type:Comp,\n235\t    p:Record<string, unknown> | null,\n236\t    offs:Off[]\n237\t):void {\n238\t    const declared = new Set(type.props as readonly string[])\n239\t    for (const [k, v] of Object.entries(p ?? {})) {\n240\t        if (_isEvent(k, v)) {\n241\t            _listen(host, k, v, offs)\n242\t        } else if (declared.has(k)) {\n243\t            // a signal makes the prop read through to it\n244\t            (host as unknown as Record<string, unknown>)[k] = v\n245\t        } else if (k === 'key') {\n246\t            _setAttr(host, k, _read(v))\n247\t        }\n248\t    }\n249\t}\n250\t\n251\tfunction _createHost (\n252\t    type:Comp,\n253\t    p:Record<string, unknown> | null,\n254\t    kids:unknown[],\n255\t    offs:Off[]\n256\t):Element {\n257\t    const { compProps, attrs } = _compArgs(type, p)\n258\t    const inner = _str(kids)\n259\t    let host!:Element\n260\t    _dom(() => {\n261\t        const out = _renderLink(type)(compProps as any, {\n262\t            children: kids.length > 0 ? `<!--[-->${inner}<!--]-->` : inner,\n263\t            attrs: Object.keys(attrs).length > 0 ? attrs : undefined,\n264\t        })\n265\t        host = _parse(String(out)).firstElementChild!\n266\t    })\n267\t    _bindHost(host, type, p, offs)\n268\t    return host\n269\t}\n270\t\n271\t// A reactive region: nodes between two comment markers, morphed toward\n272\t// the function's new value whenever what it reads changes. Given\n273\t// existing markers, the first run adopts the nodes between them.\n274\tfunction _region (\n275\t    fn:() => unknown,\n276\t    offs:Off[],\n277\t    at?: