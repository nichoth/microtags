ions')\n    const later = attrWrites(box, () => { title('b') })\n    t.equal(later.length, 1, 'a later change is written')\n    t.equal(box.querySelector('p')!.getAttribute('title'), 'b',\n        'attribute follows the signal')\n    box.remove()\n})\n\ntest('adopt: a bound attribute that differs is written once', t => {\n    const box = adoptBox('<p title=\"old\" hidden></p>')\n    const title = signal('new')\n    const hidden = signal(false)\n    const p = box.querySelector('p')!\n    const writes = attrWrites(box, () => {\n        mount(box, bhtml`<p title=${title} hidden=${hidden}></p>`)\n    })\n    t.equal(writes.length, 2, 'one write per differing attribute')\n    t.equal(p.getAttribute('title'), 'new', 'value written')\n    t.ok(!p.hasAttribute('hidden'), 'false removes the attribute')\n    title('newer')\n    hidden(true)\n    t.equal(p.getAttribute('title'), 'newer', 'later changes still apply')\n    t.ok(p.hasAttribute('hidden'), 'later true adds the attribute')\n    box.remove()\n})\n\ntest('adopt: dispose stops updates and leaves the DOM', t => {"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":726,"cache_read_input_tokens":62179,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":726},"output_tokens":32,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ede17c71-4de9-46d8-a551-1a7b4d58c296","uuid":"ca4ca68d-2471-4908-b6e2-9ff83c39e4ad","timestamp":"2026-10-15T03:54:19.816Z","request_id":"req_011Cg3M4bs1AuRfsNBQeujT1","wire_tool_inputs":{"toolu_01KBSi2z6G46ZqRLqHLnReHN":{"file_path":"/Users/nick/code/microtags.hydration-dx-fixes-03-passive-adoption-no-attribute-writes/test/index.ts","old_string":"test('adopt: dispose stops updates and leaves the DOM', t => {","new_string":"// Attribute mutations under `ro