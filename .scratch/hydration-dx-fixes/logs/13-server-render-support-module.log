s,\n    })\n    let a = ''\n    for (const [k, m] of Object.entries(rec.m)) {\n        if (!(k in props)) continue\n        const s = _serialize(m, props[k])\n        if (s !== null) a += _attr(k, s)\n    }\n    for (const [k, v] of Object.entries(attrs)) {\n        if (_attrName.test(k)) a += _attr(k, v)\n    }\n    return `<${rec.t}${a}>${String(inner)}</${rec.t}>`\n}\n\n/** Store `renderHost` where `render` statics look it up. */\nexport function register ():void {\n    (globalThis as any)[Symbol.for('microtags.render')] = renderHost\n}\n\nregister()\nEOF\npython3 - <<'EOF'\nimport re\np='src/builders.ts'\ns=open(p).read()\nstart=s.index(\"export type PropKind = 'prop-only' | 'schema' | 'coercer'\")\nend=s.index(\"/** The DSL object passed to the withProps callback. */\")\ns=s[:start]+\"\"\"// The serializer kind is decided here, by coercer identity, so the\n// server render support module never compares coercers from another\n// copy of the package.\nexport type PropKind =\n    'prop-only' | 'schema' | 'boolean' | 'json' | 'coercer'\n\nexport interface PropMeta {\n    kind:PropKind\n    coercer:Coercer<unknown>\n}\n\n/**\n * What a `render` static hands the server render support module: tag,\n * prop metadata, ref names and the render function. This shape is a\n * contract between package copies; changing it needs a new symbol key.\n */\nexport interface RenderRecord {\n    t:string\n    m:Record<string, PropMeta>\n    r:Record<string, string>\n    f:RenderFn<any, any>\n}\n\n\"\"\"+s[end:]\nold=\"\"\"                    'coercer' as const\n\n            propMetas[name] = {\n                kind,\n                coercer,\n                serialize: _serializerFor(\n                    coercer,\n                    kind\n                ),\n            }\n\"\"\"\nnew=\"\"\"                    coercer === coerceBoolean ?\n                        'boolean' as const :\n                        coercer === coerceJson ?\n                            'json' as const :\n 