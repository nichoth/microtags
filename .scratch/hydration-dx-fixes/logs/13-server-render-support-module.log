{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017WGV7k3EnDLH9ryYoHhTe7","type":"tool_result","content":"_public/\nAGENTS.md\nCHANGELOG.md\nCONTEXT.md\ndocs/\neslint.config.js\nexample/\nexample-hydration/\nlib.es5.d.ts\nLICENSE\nnode_modules/\npackage.json\nplaywright.config.ts\nREADME.md\nscripts/\nsrc/\ntest/\ntsconfig.build.json\ntsconfig.json\ntsconfig.typecheck.json\nvite.config.ts\n{\n  \"name\": \"microtags\",\n  \"version\": \"0.0.14\",\n  \"description\": \"Web component helper\",\n  \"type\": \"module\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\",\n      \"require\": \"./dist/index.cjs\"\n    },\n    \"./min\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.min.js\"\n    },\n    \"./render\": {\n      \"types\": \"./dist/render.d.ts\",\n      \"import\": \"./dist/render.js\",\n      \"require\": \"./dist/render.cjs\"\n    },\n    \"./context\": {\n      \"types\": \"./dist/context.d.ts\",\n      \"import\": \"./dist/context.js\",\n      \"require\": \"./dist/context.cjs\"\n    },\n    \"./util\": {\n      \"types\": \"./dist/util.d.ts\",\n      \"import\": \"./dist/util.js\",\n      \"require\": \"./dist/util.cjs\"\n    },\n    \"./build\": {\n      \"types\": \"./dist/build.d.ts\",\n      \"import\": \"./dist/build.js\",\n      \"require\": \"./dist/build.cjs\"\n    },\n    \"./esbuild\": {\n      \"types\": \"./dist/esbuild.d.ts\",\n      \"import\": \"./dist/esbuild.js\",\n      \"require\": \"./dist/esbuild.cjs\"\n    },\n    \"./vite\": {\n      \"types\": \"./dist/vite.d.ts\",\n      \"import\": \"./dist/vite.js\",\n      \"require\": \"./dist/vite.cjs\"\n    },\n    \"./htm\": {\n      \"browser\": {\n        \"types\": \"./dist/htm.browser.d.ts\",\n        \"import\": \"./dist/htm.browser.js\"\n      },\n      \"types\": \"./dist/htm.d.ts\",\n      \"import\": \"./dist/htm.js\",\n      \"require\": \"./dist/htm.cjs\"\n    }\n  },\n  \"bin\": {\n    \"microbuild\": \"./dist/cli.cjs\"\n  },\n  \"main\": \"dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"directories\": {\n    \"example\": \"example\",\n    \"test\": \"test\"\n  },\n  \"files\": [\n    \"./dist/*\"\n  ],\n  \"scripts\": {\n    \"lint\": \"eslint \\\"./**/*.{ts,js}\\\"\",\n    \"typecheck\": \"tsc --noEmit -p tsconfig.typecheck.json\",\n    \"test\": \"npm run typecheck && esbuild --bundle --loader:.css=empty ./test/index.ts | tapout\",\n    \"test:ssr\": \"npx esbuild ./test/ssr.ts --bundle --format=cjs --platform=node --loader:.css=empty --alias:microtags=./src --define:import.meta.env='{\\\"DEV\\\":false,\\\"PROD\\\":true,\\\"SSR\\\":true,\\\"MODE\\\":\\\"production\\\"}' | node -\",\n    \"test:build\": \"npx esbuild ./test/build.ts --bundle --format=cjs --platform=node | node\",\n    \"test:plugins\": \"npx esbuild ./test/plugins.ts --bundle --format=cjs --platform=node --packages=external | node\",\n    \"test:cli\": \"npx esbuild ./test/cli.ts --bundle --format=cjs --platform=node | node\",\n    \"test:importmap\": \"esbuild ./test/importmap/run.ts --bundle --platform=node --format=cjs --packages=external | node\",\n    \"build-cjs\": \"esbuild src/index.ts src/render.ts src/context.ts src/util.ts src/htm.ts src/htm.browser.ts --bundle --packages=external --format=cjs --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --out-extension:.js=.cjs --sourcemap\",\n    \"build-esm\": \"esbuild src/index.ts src/render.ts src/context.ts src/util.ts src/htm.ts src/htm.browser.ts --bundle --packages=external --splitting --format=esm --metafile=dist/meta.json --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --sourcemap && tsc --emitDeclarationOnly --project tsconfig.build.json --outDir dist\",\n    \"build-esm:min\": \"esbuild src/index.ts src/render.ts src/context.ts src/util.ts src/htm.ts src/htm.browser.ts --format=esm --keep-names --bundle --tsconfig=tsconfig.build.json --minify --out-extension: