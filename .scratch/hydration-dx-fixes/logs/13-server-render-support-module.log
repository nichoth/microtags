E.md\",\n    \"toc:hydration\": \"markdown-toc --maxdepth 3 -i example-hydration/README.md\",\n    \"preversion\": \"npm run lint\",\n    \"version\": \"npm run toc && npm run toc:hydration && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && npm run inject-size && git add CHANGELOG.md README.md\",\n    \"postversion\": \"git push --follow-tags && npm publish\",\n    \"prepublishOnly\": \"npm run build\",\n    \"test:hydration\": \"npm run build:hydration && npx esbuild ./test/hydration.ts --bundle --format=esm --platform=node --packages=external --loader:.css=empty | node --input-type=module && npx esbuild ./test/hydration-listen.ts --bundle --format=esm --platform=node --packages=external | node --input-type=module\",\n    \"test:hydration-dev\": \"npm run build:node && npx esbuild ./test/hydration-dev.ts --bundle --format=cjs --platform=node --packages=external | node\",\n    \"build:hydration\": \"npm run build:node && vite build --config example-hydration/vite.config.ts && vite build --ssr --config example-hydration/vite.config.ts\",\n    \"serve:hydration\": \"node example-hydration/build/server/listen.js\",\n    \"test:e2e\": \"playwright test\",\n    \"gate\": \"rm -rf example-hydration/build && npm run lint && npm run build && npm run typecheck && npm run size && npm test && npm run test:ssr && npm run test:build && npm run test:plugins && npm run test:cli && npm run test:hydration && npm run test:hydration-dev\"\n  },\n  \"peerDependencies\": {\n    \"typescript\": \">=5.0.0\"\n  },\n  \"peerDependenciesMeta\": {\n    \"typescript\": {\n      \"optional\": true\n    }\n  },\n  \"dependencies\": {\n    \"@standard-schema/spec\": \"^1.1.0\",\n    \"alien-signals\": \"^3.2.1\",\n    \"htm\": \"^3.1.1\"\n  },\n  \"devDependencies\": {\n    \"@hono/node-server\": \"^2.1.1\",\n    \"@hono/vite-dev-server\": \"^0.26.1\",\n    \"@playwright/test\": \"^1.63.0\",\n    \"@size-limit/preset-small-lib\": \"^12.1.0\",\n    \"@stylistic