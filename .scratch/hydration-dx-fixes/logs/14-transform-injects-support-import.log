cade = options?.cascade\n    const keep = options?.keep as string[] | undefined\n\n    return {\n        name: 'microtags',\n        setup (build) {\n            build.onLoad({ filter }, (args:OnLoadArgs) => {\n                const code = readFileSync(\n                    args.path, 'utf8'\n                )\n                const result = transform(code, {\n                    cascade,\n                    keep,\n                    filename: args.path,\n                })\n\n                const warnings = result.warnings.map(w => ({\n                    text: w.message,\n                    location: {\n                        file: args.path,\n                        line: w.line,\n                    },\n                }))\n\n                return {\n                    contents: result.code,\n                    loader: args.path.endsWith('.ts') ?\n                        'ts' :\n                        'js',\n                    warnings,\n                } as OnLoadResult\n            })\n        },\n    }\n}\nimport type { Plugin } from 'vite'\nimport { transform } from './build.js'\nimport type { TransformOptions } from './build.js'\n\nexport interface MicrotagsViteOptions\n    extends TransformOptions {\n    filter?:RegExp\n}\n\nexport function microtags (\n    options?:MicrotagsViteOptions\n):Plugin {\n    const filter = options?.filter ?? /\\.(ts|js|mjs)$/\n    const cascade = options?.cascade\n    const keep = options?.keep as string[] | undefined\n\n    return {\n        name: 'microtags',\n        transform (\n            code:string,\n            id:string,\n            opts?:{ ssr?:boolean }\n        ) {\n            if (!filter.test(id)) return null\n            // Server modules must keep their render links. Key on the\n            // environment consumer, not build vs dev mode; older Vite\n            // hook signatures only pass `options.ssr`.\n            const consumer = this.environment?.config.consumer\n            if (consumer ? consumer === 'server' : opts?.ssr) {\n                return null\n            }\n\n            const result = transform(code, {\n                cascade,\n                keep,\n                filename: id,\n            })\n\n            for (const w of result.warnings) {\n                this.warn({\n                    message: w.message,\n                    id,\n                    pos: undefined,\n                })\n            }\n\n            return {\n                code: result.code,\n                map: null,\n            }\n        },\n    }\n}\n// Server render support: the host-tag builder, prop serializers and\n// attribute escaping. Importing this module registers `renderHost`\n// under a registry symbol on `globalThis`, where a component's `render`\n// static finds it. Core never imports this module, so a bundle with\n// every render link stripped leaves it out. See ADR-009.\nimport type { PropMeta, RenderRecord } from './builders.js'\n\nconst _esc:Record<string, string> = {\n    '&': '&amp;',\n    '\"': '&quot;',\n    \"'\": '&#39;',\n    '<': '&lt;',\n    '>': '&gt;',\n}\nfunction _escAttr (s:string):string {\n    return s.replace(/[&\"'<>]/g, c => _esc[c])\n}\n\n// HTML attribute name grammar: a letter, `_` or `:`, then letters,\n// digits, `-`, `_`, `:` or `.`. Extra attrs may come from data.\nconst _attrName = /^[a-z_:][-\\w:.]*$/i\n\n// The kind is decided by core, so no coercer is compared here and any\n// copy of this module serves any copy of core.\nfunction _serialize (m:PropMeta, v:unknown):string | null {\n    if (m.kind === 'prop-only' || v == null) return null\n    if (m.kind === 'boolean') return v === true ? '' : null\n    if (m.kind === 'json') return JSON.stringify(v)\n    return String(v)\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_016w4tDVeuR3bb6HCFQtXD9J","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
