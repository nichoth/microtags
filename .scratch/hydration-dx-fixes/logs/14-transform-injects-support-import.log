duleSpecifier:string\n):boolean {\n    const sf = ts.createSourceFile(\n        'test.ts', code, ts.ScriptTarget.Latest, true\n    )\n    let found = false\n    ts.forEachChild(sf, node => {\n        if (\n            ts.isImportDeclaration(node) &&\n            ts.isStringLiteral(node.moduleSpecifier) &&\n            node.moduleSpecifier.text === moduleSpecifier\n        ) {\n            found = true\n        }\n    })\n    return found\n}\n\nfunction hasTopLevelDeclaration (\n    code:string, name:string\n):boolean {\n    const sf = ts.createSourceFile(\n        'test.ts', code, ts.ScriptTarget.Latest, true\n    )\n    let found = false\n    ts.forEachChild(sf, node => {\n        if (\n            ts.isVariableStatement(node)\n        ) {\n            for (const decl of\n                node.declarationList.declarations\n            ) {\n                if (\n                    ts.isIdentifier(decl.name) &&\n                    decl.name.text === name\n                ) {\n                    found = true\n                }\n            }\n        }","is_error":false}]},"parent_tool_use_id":null,"session_id":"15bf819d-2d04-4381-8228-4d11480b9c68","uuid":"8d3ac235-b8bd-43f7-957d-6efc80378c75","timestamp":"2026-10-15T04:36:49.030Z","tool_use_result":{"stdout":"test('keep: client:true preserves .render()', t => {\n    const input = `\nimport { define } from 'microtags'\nconst El = define('my-el')\n    .render(() => '<p>hi</p>', { client: true })\n    .setup(() => {})\n`\n    const result = transform(input)\n    t.ok(hasRenderInDefineChain(result.code),\n        '.render() with client:true is kept')\n})\n\ntest('keep: keep option preserves .render() by tag name', t => {\n    const input = `\nimport { define } from 'microtags'\nconst El = define('my-tag')\n    .render(() => '<p>hi</p>')\n    .setup(() => {})\n`\n    const result = transform(input, { keep: ['my-tag'] })\n    t.ok(hasRenderInDefineChain(result.code),\n        '.render() kept when tag in keep list')\n})\