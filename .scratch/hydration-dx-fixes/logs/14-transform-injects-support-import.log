nc(outDir, { recursive: true, force: true })\n    return code\n}\n\n// -- esbuild tests --\n\ntest('esbuild: strips .render() from bundle', async t => {\n    const code = await bundleWithEsbuild('strip-render.ts')\n    t.ok(\n        !code.includes('.render('),\n        'no .render() call in esbuild output'\n    )\n})\n\ntest('esbuild: keeps .render() with client:true', async t => {\n    const code = await bundleWithEsbuild('keep-render.ts')\n    t.ok(\n        code.includes('.render('),\n        '.render() preserved in esbuild output'\n    )\n})\n\ntest('esbuild: file not matching filter is untransformed',\n    async t => {\n        const result = await esbuild.build({\n            entryPoints: [\n                path.join(fixturesDir, 'strip-render.ts'),\n            ],\n            bundle: true,\n            write: false,\n            format: 'esm',\n            platform: 'node',\n            plugins: [esbuildPlugin({ filter: /\\.xyz$/ })],\n            external: ['microtags'],\n        })\n        const code = result.outputFiles[0].text\n        t.ok(\n            code.includes('.render('),\n            '.render() still present when filter excludes file'\n        )\n    }\n)\n\ntest('esbuild: warnings surface through bundler', async t => {\n    const _warnings:esbuild.Message[] = []\n    const result = await esbuild.build({\n        entryPoints: [\n            path.join(fixturesDir, 'warn-render.ts'),\n        ],\n        bundle: true,\n        write: false,\n        format: 'esm',\n        platform: 'node',\n        plugins: [esbuildPlugin()],\n        external: ['microtags'],\n        logLevel: 'silent',\n    })\n    const w = result.warnings\n    t.ok(\n        w.length > 0,\n        'esbuild receives warnings from transform'\n    )\n})\n\n// -- vite tests --\n\ntest('vite: strips .render() from bundle', async t => {\n    const code = await bundleWithVite('strip-render.ts')\n    t.ok(\n        !code.includes('.render('),\n        'no .render() call in vite output'\n    )\n})\n\ntest('vite: server build keeps .render(), client strips',\n    async t => {\n        const server = await bundleWithVite(\n            'strip-render.ts',\n            undefined,\n            true\n        )\n        t.ok(\n            server.includes('.render('),\n            '.render() preserved in vite server build'\n        )\n        const client = await bundleWithVite('strip-render.ts')\n        t.ok(\n            !client.includes('.render('),\n            '.render() removed in vite client build'\n        )\n    })\n\ntest('vite: keeps .render() with client:true', async t => {\n    const code = await bundleWithVite('keep-render.ts')\n    t.ok(\n        code.includes('.render('),\n        '.render() preserved in vite output'\n    )\n})\n\ntest('vite: file not matching filter is untransformed',\n    async t => {\n        const input = path.join(fixturesDir, 'strip-render.ts')\n        const outDir = path.resolve(\n            '.tmp-vite-filter-' + Date.now()\n        )\n        await viteBuild({\n            root: fixturesDir,\n            logLevel: 'silent',\n            build: {\n                lib: {\n                    entry: input,\n                    formats: ['es'],\n                    fileName: 'out',\n                },\n                outDir,\n                rollupOptions: {\n                    external: ['microtags'],\n                },\n                minify: false,\n                write: true,\n            },\n            plugins: [vitePlugin({ filter: /\\.xyz$/ })],\n        })\n        const outFile = path.join(outDir, 'out.js')\n        const code = fs.readFileSync(outFile, 'utf8')\n        fs.rmSync(outDir, { recursive: true, force: true })\n        t.ok(\n            code.includes('.render('),\n            '.render() still present when vite filter excludes'\n        )\n    }\n)\n\ntest('vite: warnings surface through bundler', async t => {\n    const input = path.join(fixturesDir, 'warn-render.ts')\n    const outDir = path.resolve(\n        '.tmp-vite-warn-' + Date.now()\n    )\n\n    let warningCount = 0\n    await viteBuild({\n        root: fixturesDir,\n        logLevel: 'silent',\n        build: {\n            lib: {\n                entry: input,\n                formats: ['es'],\n                fileName: 'out',\n            },\n            outDir,\n            rollupOptions: {\n                external: ['microtags'],\n                onwarn (_warning) {\n                    warningCount++\n                },\n            },\n            minify: false,\n            write: true,\n        },\n        plugins: [vitePlugin()],\n    })\n    fs.rmSync(outDir, { recursive: true, force: true })\n    t.ok(warningCount > 0, 'vite receives warnings from transform')\n})\n\nasync function bundleHtm (platform:'browser'|'node'):Promise<string> {\n    const result = await esbuild.build({\n        stdin: {\n            contents: \"import * as m from 'microtags/htm'\\n\" +\n                'console.log(m)',\n            resolveDir: path.resolve('.'),\n        },\n        bundle: true,\n        write: false,\n        format: 'esm',\n        platform,\n    })\n    return result.outputFiles[0].text\n}\n\ntest('microtags/htm resolves per platform via export conditions', async t => {\n    const browser = await bundleHtm('browser')\n    const node = await bundleHtm('node')\n    t.ok(browser.includes('htm.browser.js'), 'browser gets browser module')\n    t.ok(!node.includes('htm.browser.js'), 'node does not')\n    t.ok(node.includes('dist/htm.js'), 'node gets the server module')\n})\nimport { define } from 'microtags'\n\nconst Notice = define('test-notice')\n    .render(() => '<p>notice</p>', { client: true })\n    .setup(() => {})\n\nexport { Notice }\nimport { define } from 'microtags'\n\nconst Counter = define('test-counter')\n    .render(() => '<p>count</p>')\n    .setup(() => {})\n\nexport { Counter }\nimport { test } from '@substrate-system/tapzero'\nimport ts from 'typescript'\nimport { spawnSync } from 'node:child_process'\nimport { mkdtempSync } from 'node:fs'\nimport { resolve } from 'node:path'\nimport { tmpdir } from 'node:os'\n\n// Will import from src once it exists\nimport { transform } from '../src/build.js'\n\n/**\n * Parse source and return whether any `.render(` call exists\n * in a define chain (a call chain rooted at a `define(...)` call).\n */\nfunction hasRenderInDefineChain (code:string):boolean {\n    const sf = ts.createSourceFile(\n        'test.ts', code, ts.ScriptTarget.Latest, true\n    )\n    let found = false\n    function visit (node:ts.Node) {\n        if (\n            ts.isCallExpression(node) &&\n            ts.isPropertyAccessExpression(node.expression) &&\n            node.expression.name.text === 'render'\n        ) {\n            if (isDefineChainRoot(node.expression.expression)) {\n                found = true\n            }\n        }\n        ts.forEachChild(node, visit)\n    }\n    ts.forEachChild(sf, visit)\n    return found\n}\n\nfunction isDefineChainRoot (node:ts.Node):boolean {\n    if (\n        ts.isCallExpression(node) &&\n        ts.isIdentifier(node.expression)\n    ) {\n        return node.expression.text === 'define' ||\n            node.expression.text === 'd'\n    }\n    if (\n        ts.isCallExpression(node) &&\n        ts.isPropertyAccessExpression(node.expression)\n    ) {\n        return isDefineChainRoot(node.expression.expression)\n    }\n    return false\n}\n\ntest('strip: define chain .render() is removed', t => {\n    const input = `\nimport { define } from 'microtags'\nconst El = define('my-el')\n    .render(() => '<p>hi</p>')\n    .setup(() => {})\n`\n    const result = transform(input)\n    t.ok(!hasRenderInDefineChain(result.code),\n        'no .render() call in define chain after transform')\n    t.ok(result.code.includes('.setup('),\n        'setup call is preserved')\n})\n\ntest('strip: works with aliased import', t => {\n    const input = `\nimport { define as d } from 'microtags'\nconst El = d('my-el')\n    .render(() => '<p>hi</p>')\n    .setup(() => {})\n`\n    const result = transform(input)\n    t.ok(!hasRenderInDefineChain(result.code),\n        'no .render() call with aliased define')\n})\n\ntest('keep: client:true preserves .render()', t => {\n    const input = `\n53:test('strip: define chain .render() is removed', t => {\n67:test('strip: works with aliased import', t => {\n79:test('keep: client:true preserves .render()', t => {\n91:test('keep: keep option preserves .render() by tag name', t => {\n103:test('keep: different tag name still strips', t => {\n115:test('warning: .render() outside define chain', t => {\n131:test('warning: stripped static still referenced', t => {\n147:test('warning: non-literal tag with keep set', t => {\n162:test('no warning: non-literal tag without keep', t => {\n177:test('line count preserved', t => {\n192:test('untouched lines are byte-identical', t => {\n214:test('non-chained define is left unchanged', t => {\n307:test('cascade: import used only in render is removed', t => {\n323:test('cascade: mixed import keeps live specifier', t => {\n339:test('cascade: top-level const removed', t => {\n355:test('cascade: top-level let removed', t => {\n369:test('cascade: top-level function removed', t => {\n383:test('cascade: top-level class removed', t => {\n397:test('cascade: transitive dead declaration removed', t => {\n414:test('cascade: side-effect import preserved', t => {\n429:test('cascade: exported declaration preserved', t => {\n443:test('cascade: declaration used by setup remains', t => {\n457:test('cascade: line count preserved', t => {\n476:test('cascade off: dead imports remain', t => {\n509:test('loading without require explains the built form', t => {\n511:    t.ok(/require/.test(stderr) && /built/.test(stderr),\n513:    t.ok(!/peer dependency/.test(stderr),\n517:test('typescript that does not resolve gives the peer message', t => {\n519:    t.ok(/peer dependency/.test(stderr),\n523:test('a vite config importing source does not blame typescript', t => {\n530:    t.ok(/built form/.test(output), 'error points at the built form')\n531:    t.ok(!/peer dependency/.test(output),\n77:    \"test:ssr\": \"npx esbuild ./test/ssr.ts --bundle --format=cjs --platform=node --loader:.css=empty --alias:microtags=./src --define:import.meta.env='{\\\"DEV\\\":false,\\\"PROD\\\":true,\\\"SSR\\\":true,\\\"MODE\\\":\\\"production\\\"}' | node -\",\n78:    \"test:build\": \"npx esbuild ./test/build.ts --bundle --format=cjs --platform=node | node\",\n79:    \"test:plugins\": \"npx esbuild ./test/plugins.ts --bundle --format=cjs --platform=node --packages=external | node\",\n80:    \"test:cli\": \"npx esbuild ./test/cli.ts --bundle --format=cjs --platform=node | node\",\n81:    \"test:importmap\": \"esbuild ./test/importmap/run.ts --bundle --platform=node --format=cjs --packages=external | node\",\n82:    \"build-cjs\": \"esbuild src/index.ts src/render.ts src/context.ts src/util.ts src/htm.ts src/htm.browser.ts src/render-support.ts --bundle --packages=external --format=cjs --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --out-extension:.js=.cjs --sourcemap\",\n83:    \"build-esm\": \"esbuild src/index.ts src/render.ts src/context.ts src/util.ts src/htm.ts src/htm.browser.ts src/render-support.ts --bundle --packages=external --splitting --format=esm --metafile=dist/meta.json --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --sourcemap && tsc --emitDeclarationOnly --project tsconfig.build.json --outDir dist\",\n84:    \"build-esm:min\": \"esbuild src/index.ts src/render.ts src/context.ts src/util.ts src/htm.ts src/htm.browser.ts src/render-support.ts --format=esm --keep-names --bundle --tsconfig=tsconfig.build.json --minify --out-extension:.js=.min.js --outdir=./dist --sourcemap\",\n85:    \"build:node\": \"esbuild src/build.ts src/esbuild.ts src/vite.ts --bundle --packages=external --format=esm --keep-names --tsconfig=tsconfig.build.json --platform=node --outdir=./dist --sourcemap && esbuild src/build.ts src/esbuild.ts src/vite.ts --bundle --packages=external --format=cjs --keep-names --tsconfig=tsconfig.build.json --platform=node --outdir=./dist --out-extension:.js=.cjs --sourcemap\",\n86:    \"build:cli\": \"esbuild src/cli.ts --bundle --packages=external --format=cjs --keep-names --tsconfig=tsconfig.build.json --platform=node --outdir=./dist --out-extension:.js=.cjs --sourcemap --banner:js='#!/usr/bin/env node'\",\n87:    \"build-example\": \"npm run build-html && mkdir -p ./public && rm -rf ./public/* && NODE_ENV=development vite --mode staging --base=\\\"/microtags\\\" build\",\n88:    \"build-docs\": \"typedoc --tsconfig tsconfig.build.json --out api-docs ./src/index.ts\",\n89:    \"build\": \"mkdir -p ./dist && rm -rf ./dist/* && npm run build-cjs && npm run build-esm && npm run build-esm:min && npm run build:node && npm run build:cli\",\n90:    \"build-html\": \"npm run --silent ssr > example/index.html\",\n91:    \"size\": \"size-limit\",\n104:    \"test:hydration\": \"npm run build:hydration && npx esbuild ./test/hydration.ts --bundle --format=esm --platform=node --packages=external --loader:.css=empty | node --input-type=module && npx esbuild ./test/hydration-listen.ts --bundle --format=esm --platform=node --packages=external | node --input-type=module\",\n105:    \"test:hydration-dev\": \"npm run build:node && npx esbuild ./test/hydration-dev.ts --bundle --format=cjs --platform=node --packages=external | node\",\n106:    \"build:hydration\": \"npm run build:node && vite build --config example-hydration/vite.config.ts && vite build --ssr --config example-hydration/vite.config.ts\",\n108:    \"test:e2e\": \"playwright test\",\n109:    \"gate\": \"rm -rf example-hydration/build && npm run lint && npm run build && npm run typecheck && npm run size && npm test && npm run test:ssr && npm run test:build && npm run test:plugins && npm run test:cli && npm run test:hydration && npm run test:hydration-dev\"\n145:    \"size-limit\": \"^12.1.0\",","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01XtSXHU7VH8Q6eiYHM4xeF8","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
