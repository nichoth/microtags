s through `html`, so plain strings are escaped here.\n64\tfunction _region (f:() => unknown):string {\n65\t    const v = f()\n66\t    const out = Array.isArray(v) ?\n67\t        _flatten(v.map(_trust)) :\n68\t        _flatten([_trust(v)])\n69\t    return _OPEN + out + _CLOSE\n70\t}\n71\t\n72\tfunction _trust (v:unknown):unknown {\n73\t    return typeof v === 'string' ? _escHtml(v) : v\n74\t}\n75\t\n76\tfunction _flatten (\n77\t    children:unknown[]\n78\t):string {\n79\t    let out = ''\n80\t    for (const c of children) {\n81\t        if (c == null || c === false) continue\n82\t        if (Array.isArray(c)) {\n83\t            out += _flatten(c)\n84\t        } else if (typeof c === 'function') {\n85\t            out += _region(c as () => unknown)\n86\t        } else {\n87\t            out += String(c)\n88\t        }\n89\t    }\n90\t    return out\n91\t}\n92\t\n93\t// Evaluate a signal or function in a prop or attribute hole.\n94\tfunction _val (v:unknown):unknown {\n95\t    return typeof v === 'function' ? v() : v\n96\t}\n97\t\n98\t// A function-valued on<event> prop is a listener, which the browser\n99\t// binds. It has no server output.\n100\tfunction _isListener (k:string, v:unknown):boolean {\n101\t    return typeof v === 'function' && k.startsWith('on')\n102\t}\n103\t\n104\texport function h (\n105\t    type:string | ((...a:unknown[]) => unknown),\n106\t    props:Record<string, unknown> | null,\n107\t    ...children:unknown[]\n108\t):Markup {\n109\t    const inner = _flatten(children)\n110\t\n111\t    if (_isMicrotag(type)) {\n112\t        const declared = new Set(\n113\t            type.props as readonly string[]\n114\t        )\n115\t        const compProps:Record<string, unknown> = {}\n116\t        const attrs:Record<string, string> = {}\n117\t\n118\t        if (props) {\n119\t            for (const [k, pv] of Object.entries(props)) {\n120\t                if (_isListener(k, pv)) continue\n121\t                const v = _val(pv)\n122\t                if (dec